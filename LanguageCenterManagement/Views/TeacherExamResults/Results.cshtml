@model IEnumerable<LanguageCenterManagement.ViewModels.TeacherExamResultViewModel>

@{
    ViewData["Title"] = "Exam Results";

    var examName = ViewBag.ExamName as string ?? "Exam Results";
    var className = ViewBag.ClassName as string ?? "";
    var examDate = (DateTime)ViewBag.ExamDate;
    var maxScore = (decimal)ViewBag.MaxScore;
}

<div class="container-fluid mt-4 mb-5 px-lg-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold text-primary">
                <i class="bi bi-award-fill me-2"></i>
                @examName
            </h3>

            <p class="text-muted mb-0">
                <i class="bi bi-easel me-1"></i>
                @className
                <span class="mx-2">•</span>
                <i class="bi bi-calendar me-1"></i>
                @examDate.ToString("dd/MM/yyyy")
                <span class="mx-2">•</span>
                Maximum score: @maxScore
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Exams
        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-inbox fs-1 text-muted"></i>

                    <h5 class="fw-bold mt-3">
                        No submissions yet
                    </h5>

                    <p class="text-muted mb-0">
                        No students have submitted this exam.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="ps-4">Student</th>
                                <th>Score</th>
                                <th>Status</th>
                                <th>Submitted</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var result in Model)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <div class="fw-semibold">
                                            @result.StudentName
                                        </div>

                                        <small class="text-muted">
                                            @result.StudentCode
                                        </small>

                                    </td>

                                    <td>

                                        <span class="fw-semibold">
                                            @result.Score.ToString("0.##")
                                        </span>

                                        <span class="text-muted">
                                            / @result.MaxScore.ToString("0.##")
                                        </span>

                                    </td>

                                    <td>

                                        @if (result.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @result.Status
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (result.SubmittedAt.HasValue)
                                        {
                                            @result.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end pe-4">

                                        <a asp-action="Grade"
                                           asp-route-id="@result.ExamResultId"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            View / Grade

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>