@model LanguageCenterManagement.ViewModels.TeacherExamGradeViewModel

@{
    ViewData["Title"] = "Grade Exam";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <h3 class="fw-bold text-primary">
                <i class="bi bi-clipboard-check me-2"></i>
                Grade Exam
            </h3>

            <p class="text-muted mb-1">
                @Model.ExamName
            </p>

            <p class="text-muted mb-0">
                @Model.StudentName
                <span class="mx-2">•</span>
                @Model.StudentCode
                <span class="mx-2">•</span>
                @Model.ClassName
            </p>
        </div>

        <a asp-action="Results"
           asp-route-id="@Model.ExamId"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Results

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small">
                        STUDENT
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.StudentName
                    </div>

                    <div class="text-muted">
                        @Model.StudentCode
                    </div>

                </div>
            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small">
                        CURRENT SCORE
                    </div>

                    <div class="fw-bold fs-3 text-primary">
                        @Model.Score.ToString("0.##")
                        <span class="fs-5 text-muted">
                            / @Model.MaxScore.ToString("0.##")
                        </span>
                    </div>

                </div>
            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small">
                        SUBMITTED
                    </div>

                    <div class="fw-semibold">
                        @if (Model.SubmittedAt.HasValue)
                        {
                            @Model.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>

                </div>
            </div>

        </div>

    </div>

    <form asp-action="Grade"
          asp-route-id="@Model.ExamResultId"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="ExamResultId" />

        <input type="hidden"
               asp-for="ExamId" />

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">

                <h5 class="fw-bold mb-0">
                    Submitted Answers
                </h5>

            </div>

            <div class="card-body">

                @if (!Model.Questions.Any())
                {
                    <div class="text-center py-4 text-muted">
                        No questions were found for this exam.
                    </div>
                }
                else
                {
                    @for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        var question = Model.Questions[i];

                        <input type="hidden"
                               name="Questions[@i].QuestionId"
                               value="@question.QuestionId" />

                        <input type="hidden"
                               name="Questions[@i].QuestionOrder"
                               value="@question.QuestionOrder" />

                        <div class="border rounded p-4 mb-4">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div>

                                    <span class="badge bg-secondary me-2">
                                        Question @question.QuestionOrder
                                    </span>

                                    <span class="badge bg-light text-dark border">
                                        @question.Skill
                                    </span>

                                    <span class="badge bg-light text-dark border">
                                        @question.QuestionType
                                    </span>

                                </div>

                                <span class="text-muted">
                                    Maximum: @question.MaxScore
                                </span>

                            </div>

                            <h5 class="fw-semibold mb-3">
                                @question.QuestionText
                            </h5>

                            @if (!string.IsNullOrWhiteSpace(question.SpeakingPrompt))
                            {
                                <div class="alert alert-light border">
                                    <strong>Speaking Prompt</strong>
                                    <div class="mt-2">
                                        @question.SpeakingPrompt
                                    </div>

                                    @if (question.SpeakingPreparationTime.HasValue ||
                                         question.SpeakingResponseTime.HasValue)
                                    {
                                        <small class="text-muted d-block mt-2">
                                            Preparation:
                                            @(question.SpeakingPreparationTime ?? 0)s
                                            |
                                            Response:
                                            @(question.SpeakingResponseTime ?? 0)s
                                        </small>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(question.WritingPrompt))
                            {
                                <div class="alert alert-light border">
                                    <strong>Writing Prompt</strong>

                                    <div class="mt-2">
                                        @question.WritingPrompt
                                    </div>
                                </div>
                            }

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Student Response
                                </label>

                                @if (!string.IsNullOrWhiteSpace(question.AudioAnswerUrl))
                                {
                                    <div class="border rounded p-3 bg-light">

                                        <div class="d-flex align-items-center mb-2">

                                            <i class="bi bi-mic-fill text-primary me-2"></i>

                                            <span class="fw-semibold">
                                                Speaking Recording
                                            </span>

                                        </div>

                                        <audio controls
                                               class="w-100"
                                               preload="metadata">
                                            <source src="@question.AudioAnswerUrl"
                                                    type="audio/webm" />

                                            Your browser does not support audio playback.
                                        </audio>

                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(question.StudentAnswer))
                                {
                                    <div class="border rounded p-3 bg-light"
                                         style="white-space: pre-wrap;">
                                        @question.StudentAnswer
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-secondary mb-0">
                                        <i class="bi bi-dash-circle me-1"></i>
                                        No response submitted.
                                    </div>
                                }

                            </div>
                            @if (question.Skill.Equals(
                                "Writing",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="mt-3 p-3 border rounded">
                                    <h6 class="mb-3">Writing review</h6>

                                    @if (question.AiReviewStatus != null)
                                    {
                                        <div class="mb-3">
                                            <strong>AI-assisted review:</strong>

                                            @if (question.AiReviewFlagged)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Review recommended
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    @question.AiReviewStatus
                                                </span>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(
                                                question.AiReviewIndicators))
                                            {
                                                <p class="mt-2 mb-1">
                                                    <strong>Indicators:</strong>
                                                    @question.AiReviewIndicators
                                                </p>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(
                                                question.AiReviewExplanation))
                                            {
                                                <p class="mb-1 text-muted">
                                                    @question.AiReviewExplanation
                                                </p>
                                            }

                                            @if (question.AiReviewCheckedAt.HasValue)
                                            {
                                                <small class="text-muted">
                                                    Checked: @question.AiReviewCheckedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                </small>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-3">
                                            No AI writing review available.
                                        </p>
                                    }

                                    <hr />

                                    <strong>Essay similarity:</strong>

                                    @if (question.SimilarityDetected)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Similarity detected
                                        </span>

                                        <p class="mt-2 mb-1">
                                            Similarity:
                                            <strong>
                                                @question.SimilarityPercent?.ToString("0.##")%
                                            </strong>
                                        </p>

                                        <p class="mb-1">
                                            Review status:
                                            <strong>@question.SimilarityStatus</strong>
                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(
                                            question.SimilarityMatchingText))
                                        {
                                            <details class="mt-2">
                                                <summary>View matching text</summary>
                                                <div class="mt-2 p-2 bg-light rounded">
                                                    @question.SimilarityMatchingText
                                                </div>
                                            </details>
                                        }

                                        <a asp-controller="WritingIntegrityReviews"
                                           asp-action="Index"
                                           class="btn btn-sm btn-outline-secondary mt-2">
                                            Open similarity reviews
                                        </a>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">
                                            No recorded essay similarity match.
                                        </p>
                                    }
                                </div>
                            }

                            @if (string.Equals(question.Skill, "Writing",
                                StringComparison.OrdinalIgnoreCase) ||
                                string.Equals(question.QuestionType, "Writing",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="card mt-3 mb-4 border-primary">
                                    <div class="card-header bg-light">
                                        <strong>
                                            <i class="bi bi-robot me-2"></i>
                                            AI Writing Assessment
                                        </strong>
                                    </div>

                                    <div class="card-body">
                                        <p class="text-muted small">
                                            AI feedback is advisory. Review it before deciding
                                            on the student's official score.
                                        </p>

                                        <button type="submit"
                                                formaction="@Url.Action(
                                                "AssessWriting",
                                                "TeacherExamResults",
                                                new { id = Model.ExamResultId })"
                                                formmethod="post"
                                                name="answerId"
                                                value="@question.ExamAnswerId"
                                                class="btn btn-outline-primary"
                                                disabled="@(question.ExamAnswerId == null)">
                                            <i class="bi bi-clipboard-check me-1"></i>
                                            Assess with AI
                                        </button>

                                        @if (!string.IsNullOrWhiteSpace(question.AiAssessmentError))
                                        {
                                            <div class="alert alert-danger mt-3 mb-0">
                                                @question.AiAssessmentError
                                            </div>
                                        }

                                        @if (question.AiAssessment is { } assessment)
                                        {
                                            <hr />

                                            <div class="mb-3">
                                                <span class="text-muted">Suggested writing score</span>
                                                <h4>
                                                    @assessment.TotalScore / @assessment.MaxScore
                                                </h4>
                                            </div>

                                            <h6>Overall feedback</h6>
                                            <p>@assessment.OverallFeedback</p>

                                            <h6>Assessment criteria</h6>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Criterion</th>
                                                            <th>Score</th>
                                                            <th>Feedback</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var criterion in assessment.Criteria)
                                                        {
                                                            <tr>
                                                                <td>@criterion.Name</td>
                                                                <td>
                                                                    @criterion.Score / @criterion.MaxScore
                                                                </td>
                                                                <td>@criterion.Feedback</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            @if (assessment.Corrections.Any())
                                            {
                                                <h6>Suggested corrections</h6>
                                                <ul>
                                                    @foreach (var correction in assessment.Corrections)
                                                    {
                                                        <li>@correction</li>
                                                    }
                                                </ul>
                                            }

                                            @if (assessment.Suggestions.Any())
                                            {
                                                <h6>Areas to improve</h6>
                                                <ul>
                                                    @foreach (var suggestion in assessment.Suggestions)
                                                    {
                                                        <li>@suggestion</li>
                                                    }
                                                </ul>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(assessment.ImprovedVersion))
                                            {
                                                <details class="mt-3">
                                                    <summary>View improved version</summary>
                                                    <div class="border rounded p-3 mt-2">
                                                        @assessment.ImprovedVersion
                                                    </div>
                                                </details>
                                            }

                                            <div class="alert alert-secondary mt-3 mb-0">
                                                This score is a suggestion out of 20, not the official
                                                exam score. Compare the feedback with the rubric and
                                                enter the final score in the grading field above.
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (question.RequiresManualGrading)
                            {
                                <div class="row align-items-end">

                                    <div class="col-md-4">

                                        <label class="form-label fw-semibold"
                                               for="score_@i">

                                            Score
                                        </label>

                                        <div class="input-group">

                                            <input type="number"
                                                   id="score_@i"
                                                   name="Questions[@i].Score"
                                                   value="@question.Score"
                                                   min="0"
                                                   max="@question.MaxScore"
                                                   step="0.01"
                                                   class="form-control" />

                                            <span class="input-group-text">
                                                / @question.MaxScore
                                            </span>

                                        </div>


                                    </div>

                                    <div class="col-md-8">

                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-pencil me-1"></i>
                                            Requires manual grading
                                        </span>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="mt-3">

                                    @if (question.IsCorrect == true)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Correct
                                        </span>
                                    }
                                    else if (question.IsCorrect == false)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Incorrect
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not answered
                                        </span>
                                    }

                                    <span class="ms-2 text-muted">
                                        Score:
                                        @question.Score / @question.MaxScore
                                    </span>

                                </div>
                            }

                        </div>
                    }
                }

                <div class="mb-3">

                    <label asp-for="Note"
                           class="form-label fw-semibold">
                        Teacher Note
                    </label>

                    <textarea asp-for="Note"
                              class="form-control"
                              rows="4"
                              placeholder="Optional note about this student's result..."></textarea>

                </div>

            </div>

            <div class="card-footer bg-white d-flex justify-content-end gap-2">

                <a asp-action="Results"
                   asp-route-id="@Model.ExamId"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>
                    Save Grade

                </button>

            </div>

        </div>

    </form>

</div>