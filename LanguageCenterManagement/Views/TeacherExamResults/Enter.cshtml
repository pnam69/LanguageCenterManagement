@model LanguageCenterManagement.ViewModels.TeacherExamResultsViewModel

@{
    ViewData["Title"] = "Enter Exam Results";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-award-fill me-2"></i>
                Enter Exam Results
            </h3>

            <p class="text-muted mb-0">
                @Model.ExamName -
                @Model.ClassName
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back
        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <form asp-action="Enter"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="ExamId" />

                <div class="p-4 border-bottom">

                    <div class="row">

                        <div class="col-md-4">
                            <strong>Exam:</strong>
                            @Model.ExamName
                        </div>

                        <div class="col-md-4">
                            <strong>Class:</strong>
                            @Model.ClassName
                        </div>

                        <div class="col-md-4">
                            <strong>Maximum Score:</strong>
                            @Model.MaxScore
                        </div>

                    </div>

                </div>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger m-4">
                </div>

                @if (!Model.Students.Any())
                {
                    <div class="text-center p-5">

                        <i class="bi bi-people fs-1 text-muted"></i>

                        <h5 class="mt-3">
                            No Students Enrolled
                        </h5>

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>
                                    <th class="px-4">#</th>
                                    <th>Student</th>
                                    <th style="width: 150px;">
                                        Score
                                    </th>
                                    <th style="width: 160px;">
                                        Status
                                    </th>
                                    <th>
                                        Note
                                    </th>
                                </tr>

                            </thead>

                            <tbody>

                                @for (int i = 0;
                                      i < Model.Students.Count;
                                      i++)
                                {
                                    <tr>

                                        <td class="px-4">
                                            @(i + 1)
                                        </td>

                                        <td>
                                            <strong>
                                                @Model.Students[i].FullName
                                            </strong>

                                            <br />

                                            <small class="text-muted">
                                                @Model.Students[i].StudentCode
                                            </small>

                                            <input type="hidden"
                                                   asp-for="Students[i].StudentId" />

                                            <input type="hidden"
                                                   asp-for="Students[i].StudentCode" />

                                            <input type="hidden"
                                                   asp-for="Students[i].FullName" />

                                        </td>

                                        <td>

                                            <input asp-for="Students[i].Score"
                                                   type="number"
                                                   min="0"
                                                   max="@Model.MaxScore"
                                                   step="0.01"
                                                   class="form-control" />

                                        </td>

                                        <td>

                                            <select asp-for="Students[i].Status"
                                                    class="form-select">

                                                <option value="Completed">
                                                    Completed
                                                </option>

                                                <option value="Absent">
                                                    Absent
                                                </option>

                                                <option value="Pending">
                                                    Pending
                                                </option>

                                            </select>

                                        </td>

                                        <td>

                                            <input asp-for="Students[i].Note"
                                                   class="form-control"
                                                   placeholder="Optional note" />

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    <div class="p-4 border-top text-end">

                        <button type="submit"
                                class="btn btn-primary px-4">

                            <i class="bi bi-save me-1"></i>
                            Save Results

                        </button>

                    </div>
                }

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}