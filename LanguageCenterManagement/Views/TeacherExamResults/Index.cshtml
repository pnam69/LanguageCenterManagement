@model IEnumerable<LanguageCenterManagement.Models.Exam>

@{
    ViewData["Title"] = "Exam Results";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">

    <div class="mb-4">
        <h3 class="fw-bold text-primary">
            <i class="bi bi-award-fill me-2"></i>
            Exam Results
        </h3>

        <p class="text-muted mb-0">
            Select an exam to enter or update student results.
        </p>
    </div>

    <div class="row g-4">

        @if (!Model.Any())
        {
            <div class="col-12">

                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center p-5">

                        <i class="bi bi-file-earmark-x fs-1 text-muted"></i>

                        <h5 class="fw-bold mt-3">
                            No Exams
                        </h5>

                        <p class="text-muted mb-0">
                            You currently have no exams assigned to your classes.
                        </p>

                    </div>
                </div>

            </div>
        }
        else
        {
            @foreach (var exam in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4 d-flex flex-column">

                            <h5 class="fw-bold">
                                @exam.ExamName
                            </h5>

                            <p class="text-muted mb-2">
                                <i class="bi bi-easel me-1"></i>
                                @exam.Class?.ClassName
                            </p>

                            <p class="text-muted mb-2">
                                <i class="bi bi-calendar me-1"></i>
                                @exam.ExamDate.ToString("dd/MM/yyyy")
                            </p>

                            <p class="text-muted flex-grow-1">
                                <i class="bi bi-award me-1"></i>
                                Maximum score: @exam.MaxScore
                            </p>

                            <a asp-action="Enter"
                               asp-route-id="@exam.ExamId"
                               class="btn btn-outline-primary w-100">

                                <i class="bi bi-pencil-square me-1"></i>
                                Enter Results

                            </a>

                        </div>

                    </div>

                </div>
            }
        }

    </div>
</div>