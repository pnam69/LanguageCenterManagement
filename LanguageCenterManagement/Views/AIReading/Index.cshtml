@model LanguageCenterManagement.ViewModels.AIReadingGenerationViewModel

@{
    ViewData["Title"] = "AI Reading Passage Generator";
    bool generated = ViewBag.Generated == true;
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <h2>AI Reading Passage Generator</h2>
        <p class="text-muted">
            Generate an English reading passage using your local AI model.
            Review and edit it before saving.
        </p>
    </div>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Generation Settings</strong>
        </div>

        <div class="card-body">
            <form asp-action="Generate" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Topic" class="form-label"></label>
                    <input asp-for="Topic"
                           class="form-control"
                           placeholder="e.g. A student’s first day at college" />
                    <span asp-validation-for="Topic"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Level" class="form-label"></label>
                        <select asp-for="Level" class="form-select">
                            <option value="A1">A1 - Beginner</option>
                            <option value="A2">A2 - Elementary</option>
                            <option value="B1">B1 - Intermediate</option>
                            <option value="B2">B2 - Upper Intermediate</option>
                            <option value="C1">C1 - Advanced</option>
                        </select>
                        <span asp-validation-for="Level"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="WordCount"
                               class="form-label"></label>
                        <input asp-for="WordCount"
                               type="number"
                               min="100"
                               max="1000"
                               class="form-control" />
                        <span asp-validation-for="WordCount"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Focus"
                               class="form-label"></label>
                        <input asp-for="Focus"
                               class="form-control"
                               placeholder="e.g. Past simple tense" />
                        <span asp-validation-for="Focus"
                              class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-stars"></i>
                    Generate Passage
                </button>
            </form>
        </div>
    </div>

    @if (generated)
    {
        <div class="card shadow-sm">
            <div class="card-header">
                <strong>Review Generated Passage</strong>
            </div>

            <div class="card-body">
                <form asp-action="Save" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Topic" />
                    <input type="hidden" asp-for="Level" />
                    <input type="hidden" asp-for="WordCount" />
                    <input type="hidden" asp-for="Focus" />

                    <div class="mb-3">
                        <label asp-for="Passage"
                               class="form-label"></label>
                        <textarea asp-for="Passage"
                                  class="form-control"
                                  rows="16"></textarea>
                        <span asp-validation-for="Passage"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save"></i>
                            Save Passage
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
