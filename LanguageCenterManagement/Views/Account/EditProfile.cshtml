@model LanguageCenterManagement.ViewModels.EditAccountProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white p-4">
                    <h4 class="fw-bold mb-1">Edit Profile</h4>
                    <p class="text-muted mb-0">
                        Update your contact information.
                    </p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="EditProfile" method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="PhoneNumber"
                                   class="form-label"></label>
                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   placeholder="Enter your phone number" />
                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                Save Changes
                            </button>
                            <a asp-action="Profile"
                               class="btn btn-light border">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
