@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <!-- Khung Card chính mang phong cách cảnh báo bảo mật -->
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden text-center">
                <!-- Vạch màu cảnh báo viền trên -->
                <div class="bg-danger" style="height: 6px;"></div>

                <div class="card-body p-4 p-md-5">

                    <!-- Icon Khóa / Cấm truy cập -->
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4 shadow-sm"
                         style="width: 90px; height: 90px;">
                        <i class="bi bi-shield-lock-fill" style="font-size: 3.5rem;"></i>
                    </div>

                    <h2 class="fw-bold text-dark mb-2">
                        Access Denied
                    </h2>

                    <p class="text-muted fs-6 mb-4 px-2">
                        Oops! You do not have the necessary permissions to access this page or resource.
                    </p>

                    <!-- Khối thông báo phụ -->
                    <div class="bg-light rounded-3 p-3 border mb-4 text-start small text-muted">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-info-circle-fill text-warning fs-5 me-2"></i>
                            <div>
                                If you believe this is a mistake, please contact your system administrator or log in with an authorized account.
                            </div>
                        </div>
                    </div>

                    <!-- Nút quay về trang chủ -->
                    <div class="d-grid">
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary btn-lg shadow-sm fw-bold py-3">
                            <i class="bi bi-house-door-fill me-2"></i> Back to Home
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>