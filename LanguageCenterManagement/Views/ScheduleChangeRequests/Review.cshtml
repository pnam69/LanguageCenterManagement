@model LanguageCenterManagement.Models.ScheduleChangeRequest

@{
    ViewData["Title"] = "Review Schedule Change Request";
}

<h1>Review Schedule Change Request</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <strong>Request Information</strong>
    </div>

    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-3">
                Teacher
            </dt>
            <dd class="col-sm-9">
                @Model.Teacher?.FullName
            </dd>

            <dt class="col-sm-3">
                Class
            </dt>
            <dd class="col-sm-9">
                @Model.Schedule?.Class?.ClassName
            </dd>

            <dt class="col-sm-3">
                Original Date
            </dt>
            <dd class="col-sm-9">
                @Model.Schedule?.StudyDate.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-3">
                Original Time
            </dt>
            <dd class="col-sm-9">
                @if (Model.Schedule != null)
                {
                    <span>
                        @Model.Schedule.StartTime.ToString(@"hh\:mm")
                        -
                        @Model.Schedule.EndTime.ToString(@"hh\:mm")
                    </span>
                }
            </dd>

            <dt class="col-sm-3">
                Original Room
            </dt>
            <dd class="col-sm-9">
                @Model.Schedule?.Room?.RoomName
            </dd>

            <dt class="col-sm-3">
                Reason
            </dt>
            <dd class="col-sm-9">
                @Model.Reason
            </dd>

            <dt class="col-sm-3">
                Teacher's Proposed Date
            </dt>
            <dd class="col-sm-9">
                @(Model.ProposedDate?.ToString("dd/MM/yyyy") ?? "-")
            </dd>

            <dt class="col-sm-3">
                Teacher's Proposed Time
            </dt>
            <dd class="col-sm-9">
                @if (Model.ProposedStartTime.HasValue &&
                     Model.ProposedEndTime.HasValue)
                {
                    <span>
                        @Model.ProposedStartTime.Value.ToString(@"hh\:mm")
                        -
                        @Model.ProposedEndTime.Value.ToString(@"hh\:mm")
                    </span>
                }
                else
                {
                    <span>-</span>
                }
            </dd>

            <dt class="col-sm-3">
                Request Date
            </dt>
            <dd class="col-sm-9">
                @Model.RequestDate.ToString("dd/MM/yyyy HH:mm")
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @Model.Status
            </dd>

        </dl>
    </div>
</div>

@if (Model.Status == "Pending")
{
    <div class="card">
        <div class="card-header">
            <strong>Admin Decision</strong>
        </div>

        <div class="card-body">

            <form method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.ScheduleChangeRequestId" />

                <div class="mb-3">
                    <label for="proposedDate"
                           class="form-label">
                        Make-up Date
                    </label>

                    <input type="date"
                           id="proposedDate"
                           name="proposedDate"
                           class="form-control"
                           value="@(Model.ProposedDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="mb-3">
                    <label for="proposedStartTime"
                           class="form-label">
                        Make-up Start Time
                    </label>

                    <input type="time"
                           id="proposedStartTime"
                           name="proposedStartTime"
                           class="form-control"
                           value="@(Model.ProposedStartTime?.ToString(@"hh\:mm"))" />
                </div>

                <div class="mb-3">
                    <label for="proposedEndTime"
                           class="form-label">
                        Make-up End Time
                    </label>

                    <input type="time"
                           id="proposedEndTime"
                           name="proposedEndTime"
                           class="form-control"
                           value="@(Model.ProposedEndTime?.ToString(@"hh\:mm"))" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Make-up Room</label>
                    <select name="roomId" id="roomId" class="form-select">
                        <option value="">-- Auto-select / keep proposed --</option>
                    </select>
                    <div class="form-text">
                        Leave empty to use the teacher’s proposed room (if available) or auto-select.
                        You can also force a different room.
                    </div>
                </div>

                <div class="alert alert-info">
                    The administrator can change the proposed make-up
                    date and time before approving the request.
                    The system will check teacher and room conflicts
                    automatically.
                </div>

                <div class="mb-3">
                    <label for="adminNote"
                           class="form-label">
                        Admin Note
                    </label>

                    <textarea id="adminNote"
                              name="adminNote"
                              class="form-control"
                              rows="4"
                              placeholder="Optional note"></textarea>
                </div>

                <button type="submit"
                        formaction="@Url.Action("Approve")"
                        class="btn btn-success">
                    Approve
                </button>

                <button type="submit"
                        formaction="@Url.Action("Reject")"
                        class="btn btn-danger">
                    Reject
                </button>

                <a asp-action="AdminIndex"
                   class="btn btn-secondary">
                    Back
                </a>

            </form>

        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">

            <p>
                This request has already been processed.
            </p>

            <p>
                <strong>Admin Note:</strong>
                @(Model.AdminNote ?? "-")
            </p>

            <p>
                <strong>Decision Date:</strong>
                @(Model.DecisionDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
            </p>

            @if (Model.MakeUpSchedule != null)
            {
                <hr />

                <h5>Make-up Schedule</h5>

                <p>
                    <strong>Date:</strong>
                    @Model.MakeUpSchedule.StudyDate.ToString("dd/MM/yyyy")
                </p>

                <p>
                    <strong>Time:</strong>
                    @Model.MakeUpSchedule.StartTime.ToString(@"hh\:mm")
                    -
                    @Model.MakeUpSchedule.EndTime.ToString(@"hh\:mm")
                </p>

                <p>
                    <strong>Room:</strong>
                    @Model.MakeUpSchedule.Room?.RoomName
                </p>
            }

            <a asp-action="AdminIndex"
               class="btn btn-secondary">
                Back
            </a>

        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        async function loadAvailableRooms() {
            const date = document.getElementById("proposedDate")?.value;
            const startTime = document.getElementById("proposedStartTime")?.value;
            const endTime = document.getElementById("proposedEndTime")?.value;
            const roomSelect = document.getElementById("roomId");

            if (!date || !startTime || !endTime) {
                roomSelect.innerHTML = '<option value="">-- Select date and time first --</option>';
                return;
            }

            if (endTime <= startTime) {
                roomSelect.innerHTML = '<option value="">-- End time must be later than start time --</option>';
                return;
            }

            try {
                const response = await fetch(
                    `/Schedules/GetAvailableRooms?studyDate=${encodeURIComponent(date)}&startTime=${encodeURIComponent(startTime)}&endTime=${encodeURIComponent(endTime)}`
                );

                if (!response.ok) return;

                const rooms = await response.json();

                roomSelect.innerHTML = '<option value="">-- Auto-select / keep proposed --</option>';
                rooms.forEach(room => {
                    const option = document.createElement("option");
                    option.value = room.id;
                    option.textContent = room.text;
                    roomSelect.appendChild(option);
                });

                if (rooms.length === 0) {
                    roomSelect.innerHTML = '<option value="">-- No rooms available --</option>';
                }
            } catch (error) {
                console.error("Failed to load available rooms:", error);
            }
        }

        // Call when date/time change and on page load
        ["proposedDate", "proposedStartTime", "proposedEndTime"].forEach(id => {
            document.getElementById(id)?.addEventListener("change", loadAvailableRooms);
        });
        loadAvailableRooms();
    </script>
}