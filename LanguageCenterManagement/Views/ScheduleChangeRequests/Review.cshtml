@model LanguageCenterManagement.Models.ScheduleChangeRequest

@{
    ViewData["Title"] = "Review Schedule Change Request";
}

<h1>Review Schedule Change Request</h1>
<div class="mb-3">
    <a asp-controller="ScheduleChangeRequests"
       asp-action="AdminIndex"
       class="btn btn-secondary">
        Back to Requests
    </a>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Dashboard
    </a>

</div>
<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3"></div>

<div class="card mb-4">
    <div class="card-header">
        <strong>Request Information</strong>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">
                Teacher
            </dt>
            <dd class="col-sm-9">
                @Model.Teacher?.FullName
            </dd>

            <dt class="col-sm-3">
                Class
            </dt>
            <dd class="col-sm-9">
                @Model.Schedule?.Class?.ClassName
            </dd>

            <dt class="col-sm-3">
                Original Date
            </dt>
            <dd class="col-sm-9">
                @Model.Schedule?.StudyDate.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-3">
                Original Time
            </dt>
            <dd class="col-sm-9">
                @Model.Schedule?.StartTime.ToString(@"hh\:mm")
                -
                @Model.Schedule?.EndTime.ToString(@"hh\:mm")
            </dd>

            <dt class="col-sm-3">
                Original Room
            </dt>
            <dd class="col-sm-9">
                @Model.Schedule?.Room?.RoomName
            </dd>

            <dt class="col-sm-3">
                Reason
            </dt>
            <dd class="col-sm-9">
                @Model.Reason
            </dd>

            <dt class="col-sm-3">
                Proposed Make-up Date
            </dt>
            <dd class="col-sm-9">
                @(Model.ProposedDate?.ToString("dd/MM/yyyy") ?? "-")
            </dd>

            <dt class="col-sm-3">
                Proposed Make-up Time
            </dt>
            <dd class="col-sm-9">
                @if (Model.ProposedStartTime.HasValue &&
                     Model.ProposedEndTime.HasValue)
                {
                    @Model.ProposedStartTime.Value.ToString(@"hh\:mm")
                    @: -
                    @Model.ProposedEndTime.Value.ToString(@"hh\:mm")
                }
                else
                {
                    <span>-</span>
                }
            </dd>

            <dt class="col-sm-3">
                Request Date
            </dt>
            <dd class="col-sm-9">
                @Model.RequestDate.ToString("dd/MM/yyyy HH:mm")
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @Model.Status
            </dd>
        </dl>
    </div>
    @if (Model.ProposedDate.HasValue &&
     Model.ProposedStartTime.HasValue &&
     Model.ProposedEndTime.HasValue)
    {
        <div class="alert alert-warning mt-3">
            <strong>Approval behavior:</strong>

            <p class="mb-0">
                Approving this request will move the original schedule
                to the proposed date and time. The system will keep the
                original room if it is available; otherwise, it will
                automatically look for another suitable room.
            </p>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-3">
            <strong>No make-up schedule proposed.</strong>

            <p class="mb-0">
                Approving this request will approve the leave request
                without changing the current schedule.
            </p>
        </div>
    }
</div>

@if (Model.Status == "Pending")
{
    <div class="card">
        <div class="card-header">
            <strong>Admin Decision</strong>
        </div>

        <div class="card-body">

            <form method="post">
                <input type="hidden"
                       name="id"
                       value="@Model.ScheduleChangeRequestId" />

                <div class="mb-3">
                    <label for="adminNote"
                           class="form-label">
                        Admin Note
                    </label>

                    <textarea id="adminNote"
                              name="adminNote"
                              class="form-control"
                              rows="4"
                              placeholder="Optional note"></textarea>
                </div>

                <button type="submit"
                        formaction="@Url.Action("Approve")"
                        class="btn btn-success">
                    Approve
                </button>

                <button type="submit"
                        formaction="@Url.Action("Reject")"
                        class="btn btn-danger">
                    Reject
                </button>

                <a asp-action="AdminIndex"
                   class="btn btn-secondary">
                    Back
                </a>
            </form>

        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <p>
                This request has already been processed.
            </p>

            <p>
                <strong>Admin Note:</strong>
                @(Model.AdminNote ?? "-")
            </p>

            <p>
                <strong>Decision Date:</strong>
                @(Model.DecisionDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
            </p>

            <a asp-action="AdminIndex"
               class="btn btn-secondary">
                Back
            </a>
        </div>
    </div>
}