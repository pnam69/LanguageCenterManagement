@model LanguageCenterManagement.ViewModels.ScheduleChangeRequestViewModel

@{
    ViewData["Title"] = "Submit Schedule Change Request";
    var schedules = ViewBag.Schedules as IEnumerable<LanguageCenterManagement.Models.Schedule>;
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-arrow-left-right me-2"></i>Submit Schedule Change Request
                    </h4>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-medium"></div>

                        <!-- Khối 1: Chọn lịch cần đổi -->
                        <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">1. Select Current Schedule</h5>
                        
                        <div class="form-floating mb-4">
                            <select asp-for="ScheduleId" class="form-select" id="ScheduleId">
                                <option value="0">-- Select Schedule --</option>
                                @if (schedules != null)
                                {
                                    foreach (var schedule in schedules)
                                    {
                                        <option value="@schedule.ScheduleId">
                                            @schedule.Class?.ClassName - 
                                            @schedule.StudyDate.ToString("dd/MM/yyyy") - 
                                            @schedule.StartTime.ToString(@"hh\:mm") to @schedule.EndTime.ToString(@"hh\:mm")
                                        </option>
                                    }
                                }
                            </select>
                            <label asp-for="ScheduleId">Schedule to Change</label>
                            <span asp-validation-for="ScheduleId" class="text-danger small"></span>
                        </div>

                        <!-- Thẻ hiển thị thông tin chi tiết của lịch đã chọn -->
                        <div class="card bg-light border border-secondary border-opacity-25 shadow-sm mb-4">
                            <div class="card-body p-4">
                                <h6 class="fw-bold text-secondary mb-3">
                                    <i class="bi bi-info-circle-fill me-1"></i> Selected Schedule Details
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="text-muted small mb-1">Class</div>
                                        <div class="fw-bold text-dark fs-6" id="className">@(Model?.ClassName ?? "-")</div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted small mb-1">Room</div>
                                        <div class="fw-bold text-dark fs-6" id="roomName">@(Model?.RoomName ?? "-")</div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted small mb-1">Date</div>
                                        <div class="fw-bold text-primary fs-6" id="studyDate">
                                            @(Model?.StudyDate == default ? "-" : Model.StudyDate.ToString("dd/MM/yyyy"))
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted small mb-1">Time</div>
                                        <div class="fw-bold text-primary fs-6" id="studyTime">
                                            @(Model?.StudyDate == default ? "-" : $"{Model.StartTime:hh\\:mm} - {Model.EndTime:hh\\:mm}")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="Reason" class="form-control" style="height: 120px" placeholder="Explain why you need to change this schedule."></textarea>
                            <label asp-for="Reason">Reason for Change</label>
                            <span asp-validation-for="Reason" class="text-danger small"></span>
                        </div>

                        <!-- Khối 2: Đề xuất lịch học bù -->
                        <h5 class="fw-bold text-primary mb-3 mt-5 border-bottom pb-2">2. Proposed Make-up Schedule</h5>
                        
                        <div class="alert alert-secondary border-0 bg-light shadow-sm d-flex align-items-center mb-4 py-2" role="alert">
                            <i class="bi bi-lightbulb-fill text-warning fs-4 me-3"></i>
                            <div class="small text-muted">
                                <strong>Optional Fields:</strong> Leave these empty if you want the administrator to arrange the make-up schedule for you.
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="ProposedDate" class="form-control" type="date" />
                                    <label asp-for="ProposedDate">Proposed Date</label>
                                    <span asp-validation-for="ProposedDate" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="ProposedStartTime" class="form-control" type="time" />
                                    <label asp-for="ProposedStartTime">Start Time</label>
                                    <span asp-validation-for="ProposedStartTime" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="ProposedEndTime" class="form-control" type="time" />
                                    <label asp-for="ProposedEndTime">End Time</label>
                                    <span asp-validation-for="ProposedEndTime" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="text-muted my-4">

                        <!-- Các nút hành động -->
                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                            <a asp-action="Index" class="btn btn-light btn-lg border px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5 shadow-sm">
                                <i class="bi bi-send-fill me-1"></i> Submit Request
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Data truyền từ Controller sang JS vẫn được giữ nguyên
        const schedules = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            schedules?.Select(s => new
            {
                id = s.ScheduleId,
                className = s.Class?.ClassName,
                studyDate = s.StudyDate.ToString("dd/MM/yyyy"),
                startTime = s.StartTime.ToString(@"hh\:mm"),
                endTime = s.EndTime.ToString(@"hh\:mm"),
                roomName = s.Room?.RoomName
            }) ?? Enumerable.Empty<object>()
        ));

        const scheduleSelect = document.getElementById("ScheduleId");
        const className = document.getElementById("className");
        const roomName = document.getElementById("roomName");
        const studyDate = document.getElementById("studyDate");
        const studyTime = document.getElementById("studyTime");

        function updateScheduleInformation() {
            const selectedId = parseInt(scheduleSelect.value);
            const schedule = schedules.find(x => x.id === selectedId);

            if (!schedule) {
                className.textContent = "-";
                roomName.textContent = "-";
                studyDate.textContent = "-";
                studyTime.textContent = "-";
                return;
            }

            className.textContent = schedule.className ?? "-";
            roomName.textContent = schedule.roomName ?? "-";
            studyDate.textContent = schedule.studyDate;
            studyTime.textContent = `${schedule.startTime} - ${schedule.endTime}`;
        }

        scheduleSelect.addEventListener("change", updateScheduleInformation);
        
        // Cập nhật khi trang vừa tải xong
        updateScheduleInformation();
    </script>
}