<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Language Center</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/main.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LanguageCenterManagement.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-xl lc-navbar sticky-top">

            <div class="container-fluid px-4 px-xl-5">

                <!-- BRAND -->
                <a class="navbar-brand lc-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="lc-brand-icon">
                        <i class="bi bi-globe2"></i>
                    </span>

                    <span class="lc-brand-text">
                        <span class="lc-brand-primary">LC</span><span>Manager</span>
                    </span>

                </a>

                <!-- MOBILE TOGGLE -->
                <button class="navbar-toggler lc-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <i class="bi bi-list"></i>

                </button>


                <div class="collapse navbar-collapse" id="mainNavbar">

                    @{
                        string homeController = "Home";

                        if (User.IsInRole("Admin"))
                        {
                            homeController = "Dashboard";
                        }
                        else if (User.IsInRole("Teacher"))
                        {
                            homeController = "TeacherDashboard";
                        }
                        else if (User.IsInRole("Student"))
                        {
                            homeController = "StudentDashboard";
                        }
                    }


                    <!-- LEFT NAVIGATION -->
                    <ul class="navbar-nav lc-main-nav me-auto">


                        <!-- HOME -->
                        <li class="nav-item">
                            <a class="nav-link lc-nav-link"
                               asp-controller="@homeController"
                               asp-action="Index">

                                <i class="bi bi-house-door"></i>
                                <span>Home</span>

                            </a>
                        </li>


                        <!-- ================= ADMIN ================= -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle lc-nav-link"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    <i class="bi bi-grid"></i>
                                    <span>Management</span>

                                </a>

                                <ul class="dropdown-menu lc-dropdown-menu">

                                    <li class="dropdown-header">
                                        PEOPLE
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Students"
                                           asp-action="Index">

                                            <i class="bi bi-people text-primary"></i>
                                            Students

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Teachers"
                                           asp-action="Index">

                                            <i class="bi bi-person-workspace text-success"></i>
                                            Teachers

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Create">

                                            <i class="bi bi-person-plus text-secondary"></i>
                                            Accounts

                                        </a>
                                    </li>


                                    <li><hr class="dropdown-divider"></li>

                                    <li class="dropdown-header">
                                        ACADEMIC
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Courses"
                                           asp-action="Index">

                                            <i class="bi bi-journal-bookmark text-primary"></i>
                                            Courses

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="LanguageClasses"
                                           asp-action="Index">

                                            <i class="bi bi-easel text-success"></i>
                                            Classes

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Enrollments"
                                           asp-action="Index">

                                            <i class="bi bi-card-checklist text-info"></i>
                                            Enrollments

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Rooms"
                                           asp-action="Index">

                                            <i class="bi bi-door-open text-warning"></i>
                                            Rooms

                                        </a>
                                    </li>


                                    <li><hr class="dropdown-divider"></li>

                                    <li class="dropdown-header">
                                        SCHEDULING
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Schedules"
                                           asp-action="Index">

                                            <i class="bi bi-calendar3-week text-danger"></i>
                                            Timetable

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="ScheduleChangeRequests"
                                           asp-action="AdminIndex">

                                            <i class="bi bi-arrow-repeat text-secondary"></i>
                                            Schedule Requests

                                        </a>
                                    </li>

                                </ul>

                            </li>


                            <!-- ADMIN ACADEMIC -->

                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle lc-nav-link"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    <i class="bi bi-mortarboard"></i>
                                    <span>Academic</span>

                                </a>

                                <ul class="dropdown-menu lc-dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="LearningResults"
                                           asp-action="Index">

                                            <i class="bi bi-graph-up text-primary"></i>
                                            Learning Results

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Materials"
                                           asp-action="Index">

                                            <i class="bi bi-folder2-open text-warning"></i>
                                            Materials

                                        </a>
                                    </li>

                                </ul>

                            </li>
                        }


                        <!-- ================= TEACHER ================= -->
                        @if (User.IsInRole("Teacher"))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle lc-nav-link"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    <i class="bi bi-calendar3"></i>
                                    <span>Teaching</span>

                                </a>

                                <ul class="dropdown-menu lc-dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="TeacherSchedules"
                                           asp-action="Index">

                                            <i class="bi bi-calendar3-week text-primary"></i>
                                            My Schedule

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="ScheduleChangeRequests"
                                           asp-action="Create">

                                            <i class="bi bi-arrow-repeat text-warning"></i>
                                            Schedule Requests

                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Exams"
                                           asp-action="Index">

                                            <i class="bi bi-file-earmark-text text-danger"></i>
                                            Exams

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="TeacherExamResults"
                                           asp-action="Index">

                                            <i class="bi bi-award text-success"></i>
                                            Exam Results

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Questions"
                                           asp-action="Index">

                                            <i class="bi bi-question-circle text-info"></i>
                                            Questions

                                        </a>
                                    </li>

                                </ul>

                            </li>


                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle lc-nav-link"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    <i class="bi bi-book"></i>
                                    <span>Academic</span>

                                </a>

                                <ul class="dropdown-menu lc-dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="LearningResults"
                                           asp-action="Index">

                                            <i class="bi bi-graph-up text-primary"></i>
                                            Learning Results

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Materials"
                                           asp-action="Index">

                                            <i class="bi bi-folder2-open text-warning"></i>
                                            Materials

                                        </a>
                                    </li>

                                </ul>

                            </li>
                        }


                        <!-- ================= STUDENT ================= -->
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle lc-nav-link"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    <i class="bi bi-person-workspace"></i>
                                    <span>My Learning</span>

                                </a>

                                <ul class="dropdown-menu lc-dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="StudentClasses"
                                           asp-action="Index">

                                            <i class="bi bi-journal-text text-primary"></i>
                                            My Classes

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="StudentSchedule"
                                           asp-action="Index">

                                            <i class="bi bi-calendar3-week text-success"></i>
                                            My Schedule

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="StudentAttendance"
                                           asp-action="Index">

                                            <i class="bi bi-calendar2-check text-info"></i>
                                            Attendance

                                        </a>
                                    </li>

                                </ul>

                            </li>


                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle lc-nav-link"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    <i class="bi bi-mortarboard"></i>
                                    <span>Exams & Results</span>

                                </a>

                                <ul class="dropdown-menu lc-dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="StudentExams"
                                           asp-action="Index">

                                            <i class="bi bi-file-earmark-text text-danger"></i>
                                            My Exams

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="StudentExamResults"
                                           asp-action="Index">

                                            <i class="bi bi-award text-success"></i>
                                            Exam Results

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="StudentMaterials"
                                           asp-action="Index">

                                            <i class="bi bi-folder2-open text-warning"></i>
                                            Materials

                                        </a>
                                    </li>

                                </ul>

                            </li>
                        }

                    </ul>


                    <!-- RIGHT SIDE -->
                    <ul class="navbar-nav lc-account-nav align-items-xl-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link lc-user-menu dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    <span class="lc-user-avatar">
                                        <i class="bi bi-person"></i>
                                    </span>

                                    <span class="lc-user-info d-none d-xl-flex">

                                        <span class="lc-user-name">
                                            @User.Identity.Name
                                        </span>

                                        <span class="lc-user-role">
                                            @(
                                                User.IsInRole("Admin") ? "Administrator" :
                                                User.IsInRole("Teacher") ? "Teacher" :
                                                User.IsInRole("Student") ? "Student" :
                                                "User"
                                            )
                                        </span>

                                    </span>

                                </a>

                                <ul class="dropdown-menu dropdown-menu-end lc-dropdown-menu">

                                    <li class="dropdown-header">
                                        ACCOUNT
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Home"
                                           asp-action="Privacy">

                                            <i class="bi bi-person-circle"></i>
                                            Profile

                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Account"
                                           asp-action="LogoutConfirmation">

                                            <i class="bi bi-box-arrow-right"></i>
                                            Logout

                                        </a>
                                    </li>

                                </ul>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn lc-login-btn"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Login

                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>


    <main role="main" class="lc-main">
        @RenderBody()
    </main>


    <footer class="lc-footer">

        <div class="container-fluid px-4 px-xl-5">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">

                <div>
                    <span class="fw-semibold">
                        Language Center Management
                    </span>

                    <span class="text-muted ms-2">
                        © 2026
                    </span>
                </div>

                <div class="text-muted small">
                    Language learning management system
                </div>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>