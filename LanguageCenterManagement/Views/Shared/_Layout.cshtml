<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Language Center</title>
    <script type="importmap"></script>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons (Bắt buộc phải có để hiển thị icon cho toàn bộ hệ thống) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Google Fonts: Inter (Cho font chữ hiện đại, dễ đọc hơn) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LanguageCenterManagement.styles.css" asp-append-version="true" />

    <style>
        /* Ép toàn bộ web dùng font Inter */
        body {
            font-family: 'Inter', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        /* Style cho Dropdown mượt mà hơn */
        .dropdown-menu {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
        main {
            flex: 1;
        }
    </style>
</head>
<!-- Đổi nền thành bg-light (xám nhạt) để các khối thẻ Card màu trắng nổi bật lên -->
<body class="bg-light">
    
    <!-- Thanh Điều hướng (Navbar) -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top py-3">
            <div class="container-fluid px-lg-5">
                
                <!-- Logo & Brand -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-globe-americas fs-3 text-primary me-2"></i>
                    <span class="fw-bold text-primary mb-0 fs-4">LC<span class="text-dark">Manager</span></span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                    <!-- Nhóm Menu Trái -->
                    <ul class="navbar-nav flex-grow-1 ms-lg-4 fw-medium gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded hover-bg-light" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Home
                            </a>
                        </li>
                        
                        <!-- Dropdown Quản lý (Gộp các module lại cho gọn) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3 rounded hover-bg-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid me-1"></i> Management
                            </a>
                            <ul class="dropdown-menu border-0 shadow mt-2">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Courses" asp-action="Index">
                                        <i class="bi bi-journal-bookmark me-2 text-primary"></i> Courses
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="LanguageClasses" asp-action="Index">
                                        <i class="bi bi-easel me-2 text-success"></i> Classes
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Enrollments" asp-action="Index">
                                        <i class="bi bi-card-checklist me-2 text-info"></i> Enrollments
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Rooms" asp-action="Index">
                                        <i class="bi bi-door-open me-2 text-warning"></i> Rooms
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Schedules" asp-action="Index">
                                        <i class="bi bi-calendar3-week me-2 text-danger"></i> Schedules Timetable
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>

                    <!-- Nhóm Menu Phải (Tài khoản) -->
                    <ul class="navbar-nav fw-medium gap-2 mt-3 mt-lg-0 align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-muted">
                                    Welcome, <strong class="text-dark">@User.Identity.Name</strong>
                                </span>
                            </li>
                            <li class="nav-item">
                                <!-- Giả định bạn có Account/Logout -->
                                <a class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-bold shadow-sm" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm" asp-controller="Account" asp-action="Register">
                                    Get Started
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <!-- RenderBody không còn bị bọc bởi class="container" cứng ngắc -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer hiện đại -->
    <footer class="border-top footer text-muted bg-white py-4 mt-auto">
        <div class="container-fluid px-lg-5 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div>
                &copy; 2026 - <strong>Language Center Management</strong>. All rights reserved.
            </div>
            <div>
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted me-3 hover-primary">
                    <i class="bi bi-shield-check me-1"></i>Privacy Policy
                </a>
                <a href="#" class="text-decoration-none text-muted hover-primary">
                    <i class="bi bi-headset me-1"></i>Support
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>