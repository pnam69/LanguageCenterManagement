@model LanguageCenterManagement.ViewModels.StudentDashboardViewModel

@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="container-fluid py-4 px-lg-5">

    <!-- Greeting -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-primary mb-2">
                <i class="bi bi-mortarboard-fill me-2"></i>
                Student Dashboard
            </h1>

            <p class="text-muted mb-0">
                Welcome back,
                <strong class="text-dark">@User.Identity?.Name</strong>!
                Here's your learning overview.
            </p>
        </div>

        <span class="badge bg-primary bg-opacity-10 text-primary
            border border-primary px-3 py-2 fs-6">
            <i class="bi bi-person-check-fill me-1"></i>
            Student Account
        </span>
    </div>

    <!-- Summary Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between
                        align-items-center">
                        <div>
                            <p class="text-muted mb-1">
                                Upcoming Exams
                            </p>
                            <h2 class="h2 fw-bold mb-0">
                                @Model.UpcomingExamCount
                            </h2>
                        </div>

                        <div class="rounded-circle bg-primary
                            bg-opacity-10 text-primary
                            d-flex align-items-center
                            justify-content-center"
                             style="width: 54px; height: 54px;">
                            <i class="bi bi-calendar-event fs-3"></i>
                        </div>
                    </div>

                    <a asp-controller="StudentExams"
                       asp-action="Index"
                       class="small text-decoration-none mt-3 d-inline-block">
                        View my exams
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between
                        align-items-center">
                        <div>
                            <p class="text-muted mb-1">
                                Learning Results
                            </p>
                            <h2 class="h2 fw-bold mb-0">
                                @Model.LearningResultCount
                            </h2>
                        </div>

                        <div class="rounded-circle bg-success
                            bg-opacity-10 text-success
                            d-flex align-items-center
                            justify-content-center"
                             style="width: 54px; height: 54px;">
                            <i class="bi bi-journal-check fs-3"></i>
                        </div>
                    </div>

                    <a asp-controller="StudentLearningResults"
                       asp-action="Index"
                       class="small text-decoration-none mt-3 d-inline-block">
                        View learning results
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between
                        align-items-center">
                        <div>
                            <p class="text-muted mb-1">
                                Average Learning Score
                            </p>

                            <h2 class="h2 fw-bold mb-0">
                                @if (Model.AverageLearningScore.HasValue)
                                {
                                    @Model.AverageLearningScore.Value.ToString("0.##")
                                    <span class="fs-6 text-muted">/ 10</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </h2>
                        </div>

                        <div class="rounded-circle bg-warning
                            bg-opacity-10 text-warning
                            d-flex align-items-center
                            justify-content-center"
                             style="width: 54px; height: 54px;">
                            <i class="bi bi-graph-up-arrow fs-3"></i>
                        </div>
                    </div>

                    <p class="text-muted small mb-0 mt-3">
                        @if (Model.LearningResultCount == 0)
                        {
                            <span>Complete learning activities to see your results.</span>
                        }
                        else
                        {
                            <span>Based on your recorded learning results.</span>
                        }
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- AI Study Coach -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="badge bg-primary bg-opacity-10
                        text-primary mb-3">
                        <i class="bi bi-stars me-1"></i>
                        AI-POWERED LEARNING
                    </span>

                    <h2 class="h3 fw-bold mb-2">
                        Your AI Study Coach
                    </h2>

                    <p class="text-muted mb-0">
                        Practise with AI-generated quizzes, improve your
                        writing, and use feedback to identify what you
                        should study next.
                    </p>
                </div>

                <div class="col-lg-4">
                    <div class="d-grid gap-2">
                        <a asp-controller="StudentAI"
                           asp-action="Practice"
                           class="btn btn-primary">
                            <i class="bi bi-patch-question me-2"></i>
                            Start Practice Quiz
                        </a>

                        <a asp-controller="AIWriting"
                           asp-action="Practice"
                           class="btn btn-outline-primary">
                            <i class="bi bi-pencil-square me-2"></i>
                            AI Writing Practice
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- Upcoming Exams -->
        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0
                    px-4 pt-4 pb-2">
                    <div class="d-flex justify-content-between
                        align-items-center gap-2">
                        <h2 class="h5 fw-bold mb-0">
                            <i class="bi bi-calendar-event text-primary me-2"></i>
                            Upcoming Exams
                        </h2>

                        <a asp-controller="StudentExams"
                           asp-action="Index"
                           class="small text-decoration-none">
                            All exams
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (Model.UpcomingExams.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var exam in Model.UpcomingExams)
                            {
                                <div class="border rounded-3 p-3">
                                    <div class="d-flex flex-column
                                        flex-sm-row
                                        justify-content-between
                                        gap-3">
                                        <div>
                                            <h3 class="h6 fw-bold mb-2">
                                                @exam.ExamName
                                            </h3>

                                            <div class="text-muted small mb-1">
                                                <i class="bi bi-people me-1"></i>
                                                @exam.ClassCode — @exam.ClassName
                                            </div>

                                            <div class="text-muted small mb-1">
                                                <i class="bi bi-tag me-1"></i>
                                                @exam.ExamType
                                                <span class="mx-1">·</span>
                                                @exam.Duration minutes
                                            </div>

                                            <div class="text-muted small">
                                                <i class="bi bi-award me-1"></i>
                                                Maximum score: @exam.MaxScore
                                            </div>
                                        </div>

                                        <div class="text-sm-end">
                                            <div class="fw-semibold mb-2">
                                                @exam.ExamDate.ToString("dd MMM yyyy")
                                            </div>

                                            <div class="text-muted small mb-3">
                                                @exam.ExamDate.ToString("HH:mm")
                                            </div>

                                            <a asp-controller="StudentExams"
                                               asp-action="Details"
                                               asp-route-id="@exam.ExamId"
                                               class="btn btn-sm btn-outline-primary">
                                                View Exam
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-check
                            display-5 text-muted"></i>

                            <h3 class="h6 fw-bold mt-3">
                                You're all caught up
                            </h3>

                            <p class="text-muted mb-3">
                                There are no upcoming published exams
                                awaiting your submission.
                            </p>

                            <a asp-controller="StudentExams"
                               asp-action="Index"
                               class="btn btn-outline-primary btn-sm">
                                Browse My Exams
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Learning Results -->
        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0
                    px-4 pt-4 pb-2">
                    <div class="d-flex justify-content-between
                        align-items-center gap-2">
                        <h2 class="h5 fw-bold mb-0">
                            <i class="bi bi-graph-up text-success me-2"></i>
                            Recent Learning Results
                        </h2>

                        <a asp-controller="StudentLearningResults"
                           asp-action="Index"
                           class="small text-decoration-none">
                            View all
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (Model.RecentLearningResults.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var result in Model.RecentLearningResults)
                            {
                                <div class="border-bottom pb-3">
                                    <div class="d-flex justify-content-between
                                        align-items-start gap-2">
                                        <div>
                                            <h3 class="h6 fw-semibold mb-1">
                                                @result.CourseName
                                            </h3>

                                            <div class="text-muted small">
                                                @result.ClassCode —
                                                @result.ClassName
                                            </div>

                                            <div class="text-muted small mt-1">
                                                @(result.CompletedDate?.ToString("dd MMM yyyy")
                                                    ?? "Date not recorded")
                                            </div>
                                        </div>

                                        <div class="text-end">
                                            <div class="fw-bold text-primary">
                                                @result.AverageScore.ToString("0.##") / 10
                                            </div>

                                            <span class="badge bg-light
                                                text-dark border mt-1">
                                                @result.Result
                                            </span>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(result.TeacherComment))
                                    {
                                        <p class="small text-muted mb-0 mt-2">
                                            <i class="bi bi-chat-left-text me-1"></i>
                                            @result.TeacherComment
                                        </p>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-journal-text
                            display-5 text-muted"></i>

                            <h3 class="h6 fw-bold mt-3">
                                No learning results yet
                            </h3>

                            <p class="text-muted mb-3">
                                Your recorded learning results and
                                teacher feedback will appear here.
                            </p>

                            <a asp-controller="StudentAI"
                               asp-action="Practice"
                               class="btn btn-outline-primary btn-sm">
                                Start Practising
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- Quick Links -->
    <div class="mt-5">
        <h2 class="h5 fw-bold mb-3">Quick Access</h2>

        <div class="row g-3">
            <div class="col-12 col-sm-6 col-xl-3">
                <a asp-controller="StudentClasses"
                   asp-action="Index"
                   class="card border-0 shadow-sm h-100 text-decoration-none
                    text-dark dashboard-shortcut">
                    <div class="card-body p-4">
                        <i class="bi bi-journal-text fs-2 text-primary"></i>
                        <h3 class="h6 fw-bold mt-3">My Classes</h3>
                        <p class="text-muted small mb-0">
                            View enrolled classes and course information.
                        </p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <a asp-controller="StudentSchedule"
                   asp-action="Index"
                   class="card border-0 shadow-sm h-100 text-decoration-none
                    text-dark dashboard-shortcut">
                    <div class="card-body p-4">
                        <i class="bi bi-calendar3-week fs-2 text-success"></i>
                        <h3 class="h6 fw-bold mt-3">My Schedule</h3>
                        <p class="text-muted small mb-0">
                            Check your timetable, rooms, and class times.
                        </p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <a asp-controller="StudentAttendance"
                   asp-action="Index"
                   class="card border-0 shadow-sm h-100 text-decoration-none
                    text-dark dashboard-shortcut">
                    <div class="card-body p-4">
                        <i class="bi bi-calendar2-check fs-2 text-info"></i>
                        <h3 class="h6 fw-bold mt-3">Attendance</h3>
                        <p class="text-muted small mb-0">
                            Review your attendance history.
                        </p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <a asp-controller="StudentMaterials"
                   asp-action="Index"
                   class="card border-0 shadow-sm h-100 text-decoration-none
                    text-dark dashboard-shortcut">
                    <div class="card-body p-4">
                        <i class="bi bi-folder2-open fs-2 text-warning"></i>
                        <h3 class="h6 fw-bold mt-3">My Materials</h3>
                        <p class="text-muted small mb-0">
                            Access learning materials for your courses.
                        </p>
                    </div>
                </a>
            </div>
        </div>
    </div>

</div>

<style>
    .dashboard-shortcut {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

        .dashboard-shortcut:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .10) !important;
        }
</style>
