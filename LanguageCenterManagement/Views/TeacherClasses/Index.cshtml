@model IEnumerable<LanguageCenterManagement.Models.LanguageClass>

@{
    ViewData["Title"] = "My Classes";
}

<div class="container-fluid py-4 px-lg-5">
    <div class="mb-4">
        <h1 class="h3 mb-1">My Classes</h1>
        <p class="text-muted mb-0">
            View your assigned classes, courses and student capacity.
        </p>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group" style="max-width: 550px;">
            <input name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by class, code or course..." />

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search me-1"></i> Search
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Reset
            </a>
        </div>
    </form>

    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary">
                                @item.ClassCode
                            </span>

                            @if (item.Status == "Active")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @item.Status
                                </span>
                            }
                        </div>

                        <h2 class="h5 mb-2">@item.ClassName</h2>

                        <p class="text-muted mb-3">
                            <i class="bi bi-book me-2"></i>
                            @(item.Course?.CourseName ?? "No course assigned")
                        </p>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Enrolled students</span>
                            <strong>@item.Enrollments.Count / @item.MaxStudents</strong>
                        </div>

                        @{
                            var percentage = item.MaxStudents > 0
                                ? Math.Min(100,
                                    item.Enrollments.Count * 100 / item.MaxStudents)
                                : 0;
                        }

                        <div class="progress mb-3" style="height: 6px;">
                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @percentage%">
                            </div>
                        </div>

                        <a asp-action="Details"
                           asp-route-id="@item.LanguageClassId"
                           class="btn btn-outline-primary w-100">
                            <i class="bi bi-eye me-1"></i> View Class
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-easel text-muted"
                           style="font-size: 2.5rem;"></i>
                        <h2 class="h5 mt-3">No classes found</h2>
                        <p class="text-muted mb-0">
                            You have no assigned classes matching this search.
                            Contact an administrator if this seems incorrect.
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
