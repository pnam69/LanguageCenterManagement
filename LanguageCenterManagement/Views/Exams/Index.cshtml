@model IEnumerable<LanguageCenterManagement.Models.Exam>

@{
    ViewData["Title"] = "Exams";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Exams</h2>
            <p class="text-muted mb-0">Manage exams and their questions.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Create Exam
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search exams..." />

            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Exam</th>
                            <th>Class</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Duration</th>
                            <th>Questions</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var exam in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@exam.ExamName</strong>
                                </td>

                                <td>
                                    @exam.Class?.ClassName
                                </td>

                                <td>
                                    @exam.ExamType
                                </td>

                                <td>
                                    @exam.ExamDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @exam.Duration min
                                </td>

                                <td>
                                    <span class="badge bg-info">
                                        @exam.ExamQuestions.Count
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @exam.Status
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@exam.ExamId"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@exam.ExamId"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@exam.ExamId"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    No exams found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>