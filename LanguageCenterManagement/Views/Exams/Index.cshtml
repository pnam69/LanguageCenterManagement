@model IEnumerable<LanguageCenterManagement.Models.Exam>

@{
	ViewData["Title"] = "Exams";
}

<div class="container-fluid px-lg-5 py-4">

	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>
			<h2 class="fw-bold">Exams</h2>
			<p class="text-muted mb-0">
				Manage exams and their questions.
			</p>
		</div>

		<div class="d-flex gap-2">

			<a asp-controller="Questions"
			   asp-action="Index"
			   class="btn btn-outline-primary">
				<i class="bi bi-question-circle me-1"></i>
				Question Bank
			</a>

			<a asp-action="Create"
			   class="btn btn-primary">
				<i class="bi bi-plus-lg me-1"></i>
				Create Exam
			</a>

		</div>

	</div>

	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success">
			@TempData["Success"]
		</div>
	}

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger">
			@TempData["Error"]
		</div>
	}

	<form method="get" class="mb-4">

		<div class="input-group">

			<input type="text"
				   name="search"
				   value="@ViewBag.Search"
				   class="form-control"
				   placeholder="Search exams..." />

			<button class="btn btn-outline-primary"
					type="submit">
				Search
			</button>

		</div>

	</form>

	<div class="card border-0 shadow-sm">

		<div class="table-responsive">

			<table class="table table-hover align-middle mb-0">

				<thead class="table-light">

					<tr>
						<th>Exam</th>
						<th>Class</th>
						<th>Type</th>
						<th>Date</th>
						<th>Questions</th>
						<th>Status</th>
						<th class="text-end">Actions</th>
					</tr>

				</thead>

				<tbody>

					@foreach (var exam in Model)
					{
						<tr>

							<td>
								<strong>
									@exam.ExamName
								</strong>
							</td>

							<td>
								@exam.Class?.ClassCode
							</td>

							<td>
								@exam.ExamType
							</td>

							<td>
								@exam.ExamDate.ToString("dd/MM/yyyy HH:mm")
							</td>

							<td>
								<span class="badge bg-secondary">
									@exam.ExamQuestions.Count
								</span>
							</td>

							<td>
								<span class="badge bg-primary">
									@exam.Status
								</span>
							</td>

							<td class="text-end">

								<a asp-action="Details"
								   asp-route-id="@exam.ExamId"
								   class="btn btn-sm btn-outline-info">
									Details
								</a>

								<a asp-action="Edit"
								   asp-route-id="@exam.ExamId"
								   class="btn btn-sm btn-outline-primary">
									Edit
								</a>

								<a asp-action="Delete"
								   asp-route-id="@exam.ExamId"
								   class="btn btn-sm btn-outline-danger">
									Delete
								</a>

							</td>

						</tr>
					}

				</tbody>

			</table>

		</div>

	</div>

</div>