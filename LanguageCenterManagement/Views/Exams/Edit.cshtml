@model LanguageCenterManagement.ViewModels.ExamCreateViewModel

@{
	ViewData["Title"] = "Edit Exam";

	var questions =
		ViewBag.Questions as IEnumerable<LanguageCenterManagement.Models.Question>
		?? Enumerable.Empty<LanguageCenterManagement.Models.Question>();

	var selectedIds =
		ViewBag.SelectedQuestionIds as List<int>
		?? new List<int>();

	int examId = ViewBag.ExamId;
}

<div class="container-fluid px-lg-5 py-4">

	<div class="mb-4">
		<h2 class="fw-bold">Edit Exam</h2>
		<p class="text-muted">
			Update exam information and its questions.
		</p>
	</div>

	<form asp-action="Edit" asp-route-id="@examId" method="post">

		<div asp-validation-summary="ModelOnly"
			 class="text-danger mb-3"></div>

		<div class="card border-0 shadow-sm mb-4">
			<div class="card-body p-4">

				<h5 class="fw-bold mb-3">Exam Information</h5>

				<div class="row g-3">

					<div class="col-md-6">
						<label asp-for="ExamName" class="form-label"></label>
						<input asp-for="ExamName" class="form-control" />
						<span asp-validation-for="ExamName"
							  class="text-danger"></span>
					</div>

					<div class="col-md-6">
						<label asp-for="ClassId"
							   class="form-label">
							Class
						</label>

						<select asp-for="ClassId"
								asp-items="ViewBag.ClassId"
								class="form-select">
						</select>
					</div>

					<div class="col-md-3">
						<label asp-for="ExamType"
							   class="form-label">
							Exam Type
						</label>

						<select asp-for="ExamType"
								class="form-select">
							<option value="Test">Test</option>
							<option value="Midterm">Midterm</option>
							<option value="Final">Final</option>
							<option value="Quiz">Quiz</option>
						</select>
					</div>

					<div class="col-md-3">
						<label asp-for="ExamDate"
							   class="form-label">
							Exam Date
						</label>

						<input asp-for="ExamDate"
							   type="datetime-local"
							   class="form-control" />
					</div>

					<div class="col-md-3">
						<label asp-for="Duration"
							   class="form-label">
							Duration
						</label>

						<input asp-for="Duration"
							   type="number"
							   class="form-control" />
					</div>

					<div class="col-md-3">
						<label asp-for="MaxScore"
							   class="form-label">
							Max Score
						</label>

						<input asp-for="MaxScore"
							   type="number"
							   step="0.1"
							   class="form-control" />
					</div>

					<div class="col-md-4">
						<label asp-for="Status"
							   class="form-label">
							Status
						</label>

						<select asp-for="Status"
								class="form-select">
							<option value="Draft">Draft</option>
							<option value="Published">Published</option>
							<option value="Completed">Completed</option>
							<option value="Cancelled">Cancelled</option>
						</select>
					</div>

					<div class="col-md-8">
						<label asp-for="Description"
							   class="form-label">
							Description
						</label>

						<textarea asp-for="Description"
								  class="form-control"
								  rows="2"></textarea>
					</div>

				</div>
			</div>
		</div>

		<div class="card border-0 shadow-sm mb-4">
			<div class="card-body p-4">

				<h5 class="fw-bold mb-3">
					Exam Questions
				</h5>

				<span asp-validation-for="SelectedQuestionIds"
					  class="text-danger"></span>

				<div class="list-group">

					@foreach (var question in questions)
					{
						<div class="list-group-item">

							<div class="form-check">

								<input class="form-check-input"
									   type="checkbox"
									   name="SelectedQuestionIds"
									   value="@question.QuestionId"
									   id="question_@question.QuestionId"
									   @(selectedIds.Contains(question.QuestionId)
											? "checked"
											: "") />

								<label class="form-check-label"
									   for="question_@question.QuestionId">

									<strong>
										Question @question.QuestionId
									</strong>

									<span class="ms-2">
										@question.QuestionText
									</span>

								</label>

							</div>

						</div>
					}

				</div>

				<div class="mt-3">
					<a asp-controller="Questions"
					   asp-action="Create"
					   class="btn btn-outline-primary">
						<i class="bi bi-plus-lg me-1"></i>
						Create New Question
					</a>
				</div>

			</div>
		</div>

		<div class="d-flex gap-2">

			<button type="submit"
					class="btn btn-primary">
				<i class="bi bi-save me-1"></i>
				Save Changes
			</button>

			<a asp-action="Details"
			   asp-route-id="@examId"
			   class="btn btn-outline-secondary">
				Cancel
			</a>

		</div>

	</form>

</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}