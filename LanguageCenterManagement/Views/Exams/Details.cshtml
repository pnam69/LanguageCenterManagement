@model LanguageCenterManagement.Models.Exam

@{
	ViewData["Title"] = "Exam Details";
}

<div class="container-fluid px-lg-5 py-4">

	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>
			<h2 class="fw-bold">@Model.ExamName</h2>

			<p class="text-muted mb-0">
				@Model.Class?.ClassCode -
				@Model.Class?.ClassName
			</p>
		</div>

		<div class="d-flex gap-2">

			<a asp-action="Edit"
			   asp-route-id="@Model.ExamId"
			   class="btn btn-primary">
				<i class="bi bi-pencil me-1"></i>
				Edit
			</a>

			<a asp-action="Index"
			   class="btn btn-outline-secondary">
				Back
			</a>

		</div>

	</div>

	<div class="row g-4">

		<div class="col-lg-4">

			<div class="card border-0 shadow-sm">
				<div class="card-body">

					<h5 class="fw-bold mb-3">
						Exam Information
					</h5>

					<p>
						<strong>Type:</strong>
						@Model.ExamType
					</p>

					<p>
						<strong>Date:</strong>
						@Model.ExamDate.ToString("dd/MM/yyyy HH:mm")
					</p>

					<p>
						<strong>Duration:</strong>
						@Model.Duration minutes
					</p>

					<p>
						<strong>Maximum Score:</strong>
						@Model.MaxScore
					</p>

					<p>
						<strong>Status:</strong>
						<span class="badge bg-primary">
							@Model.Status
						</span>
					</p>

					@if (!string.IsNullOrWhiteSpace(Model.Description))
					{
						<hr />

						<p class="text-muted mb-0">
							@Model.Description
						</p>
					}

				</div>
			</div>

		</div>

		<div class="col-lg-8">

			<div class="card border-0 shadow-sm">

				<div class="card-body">

					<h5 class="fw-bold mb-3">
						Questions
						<span class="badge bg-secondary">
							@Model.ExamQuestions.Count
						</span>
					</h5>

					@if (!Model.ExamQuestions.Any())
					{
						<div class="alert alert-warning">
							This exam does not contain any questions.
						</div>
					}
					else
					{
						@foreach (var examQuestion in Model.ExamQuestions
							.OrderBy(eq => eq.QuestionOrder))
						{
							<div class="border rounded p-3 mb-3">

								<div class="d-flex justify-content-between">

									<strong>
										Question @examQuestion.QuestionOrder
									</strong>

									<span class="badge bg-secondary">
										@examQuestion.Question?.Score point(s)
									</span>

								</div>

								<p class="mt-2 mb-2">
									@examQuestion.Question?.QuestionText
								</p>

								@if (examQuestion.Question?.Answers != null &&
									examQuestion.Question.Answers.Any())
								{
									<div class="ms-3">

										@foreach (var answer in
											examQuestion.Question.Answers)
										{
											<div class="mb-1">

												@if (answer.IsCorrect)
												{
													<i class="bi bi-check-circle-fill text-success me-1"></i>
												}
												else
												{
													<i class="bi bi-circle text-muted me-1"></i>
												}

												@answer.AnswerText

											</div>
										}

									</div>
								}

							</div>
						}
					}

				</div>

			</div>

		</div>

	</div>

</div>