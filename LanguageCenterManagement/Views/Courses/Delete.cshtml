@model LanguageCenterManagement.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h1>Delete Course</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this course?
</div>

<dl class="row">

    <dt class="col-sm-3">Course Code</dt>
    <dd class="col-sm-9">@Model.CourseCode</dd>

    <dt class="col-sm-3">Course Name</dt>
    <dd class="col-sm-9">@Model.CourseName</dd>

    <dt class="col-sm-3">Tuition Fee</dt>
    <dd class="col-sm-9">
        @Model.TuitionFee.ToString("N0")
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="CourseId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>