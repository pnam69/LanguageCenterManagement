@model IEnumerable<LanguageCenterManagement.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    
    <!-- Cụm thông báo (Alerts) -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Khung Card chính -->
    <div class="card shadow-sm border-0 rounded-3">
        <!-- Header: Tiêu đề & Nút Thêm mới -->
        <div class="card-header bg-white border-bottom py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h4 class="mb-0 fw-bold text-primary">
                <i class="bi bi-journal-text me-2"></i>Course Management
            </h4>
            <a asp-action="Create" class="btn btn-primary shadow-sm fw-medium">
                <i class="bi bi-plus-lg me-1"></i> Add New Course
            </a>
        </div>

        <div class="card-body p-4">
            
            <!-- Thanh tìm kiếm -->
            <div class="row mb-4">
                <div class="col-md-8 col-lg-5">
                    <form asp-action="Index" method="get">
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 ps-0" placeholder="Search by code, name or level..." />
                            <button type="submit" class="btn btn-primary px-4">Search</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Bảng dữ liệu -->
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="ps-3 py-3">Code</th>
                                <th class="py-3">Course Name</th>
                                <th class="py-3" style="max-width: 200px;">Description</th>
                                <th class="py-3">Tuition Fee</th>
                                <th class="py-3">Duration</th>
                                <th class="py-3">Level</th>
                                <th class="py-3">Status</th>
                                <th class="text-center pe-3 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">@course.CourseCode</td>
                                    <td class="fw-medium">@course.CourseName</td>
                                    
                                    <!-- Cắt chữ nếu mô tả quá dài -->
                                    <td class="text-truncate text-muted" style="max-width: 200px;" title="@course.Description">
                                        @course.Description
                                    </td>
                                    
                                    <td class="fw-bold text-success">$@course.TuitionFee.ToString("N0")</td>
                                    <td>@course.Duration wks</td>
                                    
                                    <td>
                                        <span class="badge bg-info text-dark border">@course.Level</span>
                                    </td>
                                    
                                    <td>
                                        @if (course.Status == "Active")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success">@course.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">@course.Status</span>
                                        }
                                    </td>
                                    
                                    <!-- Nhóm nút thao tác dạng icon -->
                                    <td class="text-center pe-3">
                                        <div class="btn-group shadow-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-info" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Thông báo khi không có dữ liệu -->
                <div class="alert alert-light text-center border p-5 mb-0" role="alert">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-muted">No courses found.</h5>
                    <p class="text-muted mb-0">Try adjusting your search or add a new course.</p>
                </div>
            }
        </div>
    </div>
</div>