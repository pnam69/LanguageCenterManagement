@model LanguageCenterManagement.Models.Course

@{
    ViewData["Title"] = "Add Course";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-journal-plus me-2"></i>Add New Course</h4>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-medium"></div>

                        <!-- Hàng 1: Course Code & Course Name -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="CourseCode" class="form-control" placeholder="Course Code" />
                                    <label asp-for="CourseCode"></label>
                                    <span asp-validation-for="CourseCode" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-floating">
                                    <input asp-for="CourseName" class="form-control" placeholder="Course Name" />
                                    <label asp-for="CourseName"></label>
                                    <span asp-validation-for="CourseName" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Hàng 2: Description -->
                        <div class="form-floating mb-3">
                            <textarea asp-for="Description" class="form-control" placeholder="Description" style="height: 120px"></textarea>
                            <label asp-for="Description"></label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Hàng 3: Tuition Fee & Duration -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="TuitionFee" type="number" step="0.01" min="0" class="form-control" placeholder="Tuition Fee" />
                                    <label asp-for="TuitionFee">Tuition Fee ($)</label>
                                    <span asp-validation-for="TuitionFee" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Duration" type="number" min="1" class="form-control" placeholder="Duration" />
                                    <label asp-for="Duration">Duration (Weeks)</label>
                                    <span asp-validation-for="Duration" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Hàng 4: Level & Status -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Level" class="form-select" id="levelSelect">
                                        <option value="">-- Select Level --</option>
                                        <option value="Beginner">Beginner</option>
                                        <option value="Elementary">Elementary</option>
                                        <option value="Intermediate">Intermediate</option>
                                        <option value="Upper-Intermediate">Upper-Intermediate</option>
                                        <option value="Advanced">Advanced</option>
                                    </select>
                                    <label asp-for="Level"></label>
                                    <span asp-validation-for="Level" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Status" class="form-select" id="statusSelect">
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                    <label asp-for="Status"></label>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="text-muted mb-4">

                        <!-- Nút hành động -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light btn-lg border px-4">
                                Back to List
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5 shadow-sm">
                                Save Course
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}