@model LanguageCenterManagement.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle-fill me-2"></i>Course Details
                    </h4>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    
                    <!-- Khối thông tin khóa học (General Information) -->
                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">General Information</h5>
                    <div class="bg-light p-4 rounded-3 border mb-5">
                        <dl class="row mb-0">
                            <div class="col-md-6 mb-3">
                                <dt class="text-muted mb-1">Course Code</dt>
                                <dd class="fw-bold fs-6 mb-0">@Model.CourseCode</dd>
                            </div>
                            <div class="col-md-6 mb-3">
                                <dt class="text-muted mb-1">Course Name</dt>
                                <dd class="fw-bold fs-6 mb-0">@Model.CourseName</dd>
                            </div>
                            
                            <div class="col-md-12 mb-3">
                                <dt class="text-muted mb-1">Description</dt>
                                <dd class="mb-0">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</dd>
                            </div>

                            <div class="col-md-6 mb-3">
                                <dt class="text-muted mb-1">Tuition Fee</dt>
                                <dd class="fw-bold text-success fs-6 mb-0">$@Model.TuitionFee.ToString("N0")</dd>
                            </div>
                            <div class="col-md-6 mb-3">
                                <dt class="text-muted mb-1">Duration</dt>
                                <dd class="fw-bold fs-6 mb-0">@Model.Duration Weeks</dd>
                            </div>

                            <div class="col-md-6 mb-0">
                                <dt class="text-muted mb-1">Level</dt>
                                <dd class="mb-0">
                                    <span class="badge bg-info text-dark border">@Model.Level</span>
                                </dd>
                            </div>
                            <div class="col-md-6 mb-0">
                                <dt class="text-muted mb-1">Status</dt>
                                <dd class="mb-0">
                                    @if (Model.Status == "Active")
                                    {
                                        <span class="badge bg-success">@Model.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Model.Status</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                    </div>

                    <!-- Khối danh sách lớp học (Classes Using This Course) -->
                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">Classes Using This Course</h5>
                    
                    @if (Model.Classes != null && Model.Classes.Any())
                    {
                        <div class="table-responsive border rounded-3 mb-4">
                            <table class="table table-hover table-borderless align-middle mb-0">
                                <thead class="table-light border-bottom">
                                    <tr>
                                        <th class="ps-4 py-3">Class Code</th>
                                        <th class="py-3">Class Name</th>
                                        <th class="py-3">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var classItem in Model.Classes)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-medium text-primary">@classItem.ClassCode</td>
                                            <td>@classItem.ClassName</td>
                                            <td>
                                                @if (classItem.Status == "Active")
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success">@classItem.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">@classItem.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary d-flex align-items-center mb-4 border-0 bg-light" role="alert">
                            <i class="bi bi-info-square-fill text-muted fs-4 me-3"></i>
                            <div class="text-muted">
                                No classes are currently using this course.
                            </div>
                        </div>
                    }

                    <hr class="text-muted my-4">

                    <!-- Các nút hành động -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light btn-lg border px-4">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-warning btn-lg fw-bold px-4 shadow-sm text-dark">
                            <i class="bi bi-pencil-square me-1"></i> Edit Course
                        </a>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>