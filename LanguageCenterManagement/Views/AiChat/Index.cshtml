@model LanguageCenterManagement.ViewModels.AiChatViewModel

@{
    ViewData["Title"] = "AI Study Coach";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="rounded-3 bg-primary text-white p-3">
            <i class="bi bi-robot fs-3"></i>
        </div>
        <div>
            <h2 class="mb-1">AI Study Coach
                <i class="bi bi-question-circle text-primary"
                   role="button" tabindex="0"
                   data-demo-popover
                   data-bs-toggle="popover"
                   data-bs-title="AI Chatbot"
                   data-bs-content="Học sinh có thể trò chuyện trực tiếp với AI, đặt câu hỏi về kiến thức, yêu cầu giải thích hoặc nhờ hỗ trợ trong quá trình học tập.
                    Chatbot sử dụng mô hình AI chạy cục bộ, cho phép hệ thống cung cấp hỗ trợ học tập mà không cần phụ thuộc vào API AI trả phí bên ngoài
                    .">
                </i>
            </h2>
            <p class="text-muted mb-0">
                Your personal assistant for learning English.
            </p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <strong>English Tutor</strong>
                <span class="badge bg-success">Local AI</span>
            </div>
        </div>

        <div id="chatMessages"
             class="card-body bg-light"
             style="height: 430px; overflow-y: auto;">
            <div class="d-flex mb-3">
                <div class="bg-white border rounded-3 p-3"
                     style="max-width: 85%;">
                    Hello! I'm your AI Study Coach. Ask me about English
                    grammar, vocabulary, reading, or writing. I can explain
                    mistakes and give you practice examples.
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button type="button"
                        class="btn btn-sm btn-outline-primary suggestion"
                        data-prompt="Analyze my recent exam results. Identify my strongest and weakest English skills, explain what the results suggest, and recommend what I should improve first.">
                    Analyze my results
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary suggestion"
                        data-prompt="Based on my exam results, create a personalized 7-day English study plan. Include daily activities, estimated study time, specific skills to practice, and measurable goals.">
                    My 7-day study plan
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary suggestion"
                        data-prompt="Based on my weakest skills in my exam results, create targeted English exercises for me. Include questions, answers, and explanations. Adjust the difficulty to my current level.">
                    Practice my weak skills
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary suggestion"
                        data-prompt="Based on my recent exam results, create a 30-day English improvement roadmap. Divide it into weekly goals and explain how I can measure my progress.">
                    30-day improvement plan
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary suggestion"
                        data-prompt="Review my performance across recent exams. Have I improved, declined, or stayed consistent? Explain what can and cannot be concluded from the available results.">
                    Track my progress
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary suggestion"
                        data-prompt="Give me a short English diagnostic test covering grammar, vocabulary, reading, and writing. Evaluate my answers and recommend what I should study next.">
                    Diagnostic test
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary suggestion"
                        data-prompt="Teach me 10 useful English vocabulary words related to my weakest skill. Include definitions, example sentences, and a short quiz.">
                    Targeted vocabulary
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary suggestion"
                        data-prompt="Give me a B1-level English reading passage with five comprehension questions. After I answer, evaluate my answers and explain my mistakes.">
                    Reading practice
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary suggestion"
                        data-prompt="Give me an English writing task appropriate for my level. After I submit my writing, evaluate grammar, vocabulary, organization, and clarity, then suggest improvements.">
                    Writing practice
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary suggestion"
                        data-prompt="Create a short English grammar quiz focused on the topics I am most likely to struggle with based on my recent results. Ask one question at a time and explain each answer.">
                    Grammar quiz
                </button>
            </div>

            <form id="chatForm">
                @Html.AntiForgeryToken()

                <label for="messageInput" class="form-label">
                    Your question
                </label>

                <div class="input-group">
                    <textarea id="messageInput"
                              class="form-control"
                              rows="2"
                              maxlength="2000"
                              placeholder="Ask your English question..."
                              required></textarea>

                    <button id="sendButton"
                            type="submit"
                            class="btn btn-primary px-4">
                        <i class="bi bi-send me-1"></i> Send
                    </button>
                </div>

                <div class="d-flex justify-content-between mt-2">
                    <small class="text-muted">
                        AI answers may contain mistakes. Verify important
                        information with your teacher.
                    </small>
                    <button type="button"
                            id="clearChat"
                            class="btn btn-sm btn-link text-danger">
                        Clear chat
                    </button>
                </div>

                <div id="chatStatus"
                     class="small mt-2"
                     role="status"
                     aria-live="polite"></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("chatForm");
            const input = document.getElementById("messageInput");
            const sendButton = document.getElementById("sendButton");
            const messages = document.getElementById("chatMessages");
            const status = document.getElementById("chatStatus");
            const clearButton = document.getElementById("clearChat");

            let history = [];
            let busy = false;

            function addMessage(role, text) {
                const wrapper = document.createElement("div");
                wrapper.className = "d-flex mb-3 " +
                    (role === "user" ? "justify-content-end" : "");

                const bubble = document.createElement("div");
                bubble.className = role === "user"
                    ? "bg-primary text-white rounded-3 p-3"
                    : "bg-white border rounded-3 p-3";

                bubble.style.maxWidth = "85%";
                bubble.style.whiteSpace = "pre-wrap";
                bubble.textContent = text;

                wrapper.appendChild(bubble);
                messages.appendChild(wrapper);
                messages.scrollTop = messages.scrollHeight;

                return wrapper;
            }

            async function sendMessage(message) {
                if (busy || !message.trim()) return;

                busy = true;
                sendButton.disabled = true;
                input.disabled = true;
                status.textContent = "AI is preparing an answer...";
                status.className = "small mt-2 text-muted";

                addMessage("user", message);

                const loading = addMessage("assistant", "Thinking...");

                try {
                    const token = form.querySelector(
                        'input[name="__RequestVerificationToken"]').value;

                    const response = await fetch(
                        '@Url.Action("Send", "AiChat")',
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": token
                            },
                            body: JSON.stringify({
                                message: message,
                                history: history.slice(-10)
                            })
                        });

                    const data = await response.json();

                    if (!response.ok) {
                        throw new Error(
                            data.error || "Could not get an AI response.");
                    }

                    loading.querySelector("div").textContent = data.answer;

                    history.push(
                        { role: "user", content: message },
                        { role: "assistant", content: data.answer }
                    );

                    history = history.slice(-10);
                    status.textContent = "Answer received.";
                    status.className = "small mt-2 text-success";
                } catch (error) {
                    loading.querySelector("div").textContent =
                        error.message || "The AI service is unavailable.";

                    status.textContent = "Request failed. You can try again.";
                    status.className = "small mt-2 text-danger";
                } finally {
                    busy = false;
                    sendButton.disabled = false;
                    input.disabled = false;
                    input.focus();
                }
            }

            form.addEventListener("submit", async event => {
                event.preventDefault();

                const message = input.value.trim();
                if (!message) return;

                input.value = "";
                await sendMessage(message);
            });

            document.querySelectorAll(".suggestion").forEach(button => {
                button.addEventListener("click", () => {
                    if (busy) return;
                    input.value = button.dataset.prompt;
                    input.focus();
                });
            });

            clearButton.addEventListener("click", () => {
                if (busy) return;

                history = [];
                messages.replaceChildren();

                addMessage(
                    "assistant",
                    "Chat cleared. What would you like to learn today?"
                );

                status.textContent = "";
            });
        })();
    </script>
}
