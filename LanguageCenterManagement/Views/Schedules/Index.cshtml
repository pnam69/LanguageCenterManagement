@model IEnumerable<LanguageCenterManagement.Models.Schedule>

@{
    ViewData["Title"] = "Schedule Timetable";

    DateTime monday = ViewBag.Monday;
    DateTime sunday = ViewBag.Sunday;

    var days = Enumerable.Range(0, 7)
        .Select(i => monday.AddDays(i))
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <h1>Schedule Timetable</h1>

        <div class="text-muted">
            @monday.ToString("dd/MM/yyyy")
            -
            @sunday.ToString("dd/MM/yyyy")
        </div>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Create Weekly Schedule
    </a>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="mb-3">

    <a asp-action="Index"
       asp-route-weekStart="@monday.AddDays(-7).ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">
        Previous Week
    </a>

    <a asp-action="Index"
       asp-route-weekStart="@DateTime.Today.ToString("yyyy-MM-dd")"
       class="btn btn-outline-primary">
        Current Week
    </a>

    <a asp-action="Index"
       asp-route-weekStart="@monday.AddDays(7).ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">
        Next Week
    </a>

</div>

<div class="table-responsive">

    <table class="table table-bordered align-middle">

        <thead>
            <tr>
                <th style="min-width: 100px;">
                    Time
                </th>

                @foreach (var day in days)
                {
                    <th class="text-center"
                        style="min-width: 180px;">
                        @day.ToString("dddd")
                        <br />
                        <small>
                            @day.ToString("dd/MM")
                        </small>
                    </th>
                }
            </tr>
        </thead>

        <tbody>

            @foreach (var time in Model
                .Select(s => s.StartTime)
                .Distinct()
                .OrderBy(t => t))
            {
                <tr>

                    <td class="fw-bold">
                        @time.ToString(@"hh\:mm")
                    </td>

                    @foreach (var day in days)
                    {
                        var daySchedules = Model
                            .Where(s =>
                                s.StudyDate.Date == day.Date &&
                                s.StartTime == time)
                            .ToList();

                        <td>

                            @foreach (var schedule in daySchedules)
                            {
                                <div class="border rounded p-2 mb-2">

                                    <div class="fw-bold">
                                        @schedule.Class?.ClassName
                                    </div>

                                    <div>
                                        Room:
                                        @schedule.Room?.RoomCode
                                    </div>

                                    <div>
                                        @schedule.StartTime.ToString(@"hh\:mm")
                                        -
                                        @schedule.EndTime.ToString(@"hh\:mm")
                                    </div>

                                    <div class="small text-muted">
                                        @schedule.Class?.Teacher?.FullName
                                    </div>

                                    <div class="mt-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@schedule.ScheduleId"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@schedule.ScheduleId"
                                           class="btn btn-sm btn-info">
                                            Details
                                        </a>

                                    </div>

                                </div>
                            }

                            @if (!daySchedules.Any())
                            {
                                <span class="text-muted">
                                    —
                                </span>
                            }

                        </td>
                    }

                </tr>
            }

        </tbody>

    </table>

</div>