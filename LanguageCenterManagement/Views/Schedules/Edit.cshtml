@model LanguageCenterManagement.Models.Schedule

@{
    ViewData["Title"] = "Edit Schedule";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Edit Schedule
                    </h4>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="ScheduleId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-medium"></div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ClassId" class="form-select" asp-items="ViewBag.ClassId">
                                        <option value="">-- Select Class --</option>
                                    </select>
                                    <label asp-for="ClassId">Class</label>
                                    <span asp-validation-for="ClassId" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="RoomId" class="form-select" asp-items="ViewBag.RoomId">
                                        <option value="">-- Select Room --</option>
                                    </select>
                                    <label asp-for="RoomId">Room</label>
                                    <span asp-validation-for="RoomId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="StudyDate" type="date" class="form-control" />
                                    <label asp-for="StudyDate">Study Date</label>
                                    <span asp-validation-for="StudyDate" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Status" class="form-select">
                                        <option value="Scheduled">Scheduled</option>
                                        <option value="Completed">Completed</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                    <label asp-for="Status">Status</label>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="StartTime" type="time" class="form-control" />
                                    <label asp-for="StartTime">Start Time</label>
                                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="EndTime" type="time" class="form-control" />
                                    <label asp-for="EndTime">End Time</label>
                                    <span asp-validation-for="EndTime" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="text-muted mb-4">

                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                            <a asp-action="Index" class="btn btn-light btn-lg border px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5 shadow-sm">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}