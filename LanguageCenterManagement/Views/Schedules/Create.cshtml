@model LanguageCenterManagement.ViewModels.ScheduleCreateViewModel

@{
    ViewData["Title"] = "Create Weekly Schedule";
}

<!-- Thêm CSS của Flatpickr -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-calendar-plus-fill me-2"></i>Create Weekly Schedule
                    </h4>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-medium"></div>

                        <!-- Khối 1: Lớp & Phòng học -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ClassId" class="form-select" asp-items="ViewBag.ClassId">
                                        <option value="">-- Select Class --</option>
                                    </select>
                                    <label asp-for="ClassId">Class</label>
                                    <span asp-validation-for="ClassId" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="RoomId" class="form-select" asp-items="ViewBag.RoomId">
                                        <option value="">-- Select Room --</option>
                                    </select>
                                    <label asp-for="RoomId">Room</label>
                                    <span asp-validation-for="RoomId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Khối 2: Ngày bắt đầu & Ngày kết thúc -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <!-- Đã đổi type="date" thành type="text" và thêm class custom-datepicker -->
                                    <input asp-for="StartDate" type="text" class="form-control custom-datepicker" placeholder="DD/MM/YYYY" />
                                    <label asp-for="StartDate">Start Date</label>
                                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="EndDate" type="text" class="form-control custom-datepicker" placeholder="DD/MM/YYYY" />
                                    <label asp-for="EndDate">End Date</label>
                                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Khối 3: Tần suất (Các ngày trong tuần) -->
                        <div class="mb-4">
                            <label class="fw-bold text-primary mb-2 d-block">
                                <i class="bi bi-calendar-week me-1"></i>Days of Week
                            </label>
                            <div class="bg-light p-3 rounded-3 border">
                                <div class="row g-3">
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input asp-for="Monday" class="form-check-input border-secondary shadow-sm" />
                                            <label asp-for="Monday" class="form-check-label user-select-none">Monday</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input asp-for="Tuesday" class="form-check-input border-secondary shadow-sm" />
                                            <label asp-for="Tuesday" class="form-check-label user-select-none">Tuesday</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input asp-for="Wednesday" class="form-check-input border-secondary shadow-sm" />
                                            <label asp-for="Wednesday" class="form-check-label user-select-none">Wednesday</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input asp-for="Thursday" class="form-check-input border-secondary shadow-sm" />
                                            <label asp-for="Thursday" class="form-check-label user-select-none">Thursday</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input asp-for="Friday" class="form-check-input border-secondary shadow-sm" />
                                            <label asp-for="Friday" class="form-check-label user-select-none">Friday</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input asp-for="Saturday" class="form-check-input border-secondary shadow-sm" />
                                            <label asp-for="Saturday" class="form-check-label user-select-none">Saturday</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input asp-for="Sunday" class="form-check-input border-secondary shadow-sm" />
                                            <label asp-for="Sunday" class="form-check-label user-select-none">Sunday</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Khối 4: Khung giờ & Trạng thái -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="StartTime" type="time" class="form-control" />
                                    <label asp-for="StartTime">Start Time</label>
                                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="EndTime" type="time" class="form-control" />
                                    <label asp-for="EndTime">End Time</label>
                                    <span asp-validation-for="EndTime" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <select asp-for="Status" class="form-select">
                                        <option value="Scheduled">Scheduled</option>
                                        <option value="Completed">Completed</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                    <label asp-for="Status">Status</label>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="text-muted mb-4">

                        <!-- Các nút hành động -->
                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                            <a asp-action="Index" class="btn btn-light btn-lg border px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Create Schedule
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <!-- JS của Flatpickr -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            flatpickr(".custom-datepicker", {
                dateFormat: "Y-m-d",      // Định dạng gửi về server (để C# không bị lỗi parse ngày)
                altInput: true,           // Kích hoạt ô input ảo để hiển thị
                altFormat: "d/m/Y",       // Định dạng hiển thị cho người dùng xem (Ngày/Tháng/Năm)
                allowInput: true          // Cho phép gõ phím trực tiếp
            });
        });
    </script>
}