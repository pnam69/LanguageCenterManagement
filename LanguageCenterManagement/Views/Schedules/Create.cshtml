@model LanguageCenterManagement.ViewModels.ScheduleCreateViewModel

@{
    ViewData["Title"] = "Create Weekly Schedule";
}

<h1>Create Weekly Schedule</h1>

<hr />

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="ClassId" class="form-label">
            Class
        </label>

        <select asp-for="ClassId"
                class="form-select"
                asp-items="ViewBag.ClassId">
            <option value="">-- Select Class --</option>
        </select>

        <span asp-validation-for="ClassId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RoomId" class="form-label">
            Room
        </label>

        <select asp-for="RoomId"
                class="form-select"
                asp-items="ViewBag.RoomId">
            <option value="">-- Select Room --</option>
        </select>

        <span asp-validation-for="RoomId"
              class="text-danger"></span>
    </div>

    <div class="row">

        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="form-label">
                Start Date
            </label>

            <input asp-for="StartDate"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="StartDate"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="EndDate" class="form-label">
                End Date
            </label>

            <input asp-for="EndDate"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="EndDate"
                  class="text-danger"></span>
        </div>

    </div>

    <div class="mb-3">
        <label class="form-label">
            Days of Week
        </label>

        <div class="row">

            <div class="col-md-3">
                <div class="form-check">
                    <input asp-for="Monday"
                           class="form-check-input" />
                    <label asp-for="Monday"
                           class="form-check-label">
                        Monday
                    </label>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input asp-for="Tuesday"
                           class="form-check-input" />
                    <label asp-for="Tuesday"
                           class="form-check-label">
                        Tuesday
                    </label>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input asp-for="Wednesday"
                           class="form-check-input" />
                    <label asp-for="Wednesday"
                           class="form-check-label">
                        Wednesday
                    </label>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input asp-for="Thursday"
                           class="form-check-input" />
                    <label asp-for="Thursday"
                           class="form-check-label">
                        Thursday
                    </label>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input asp-for="Friday"
                           class="form-check-input" />
                    <label asp-for="Friday"
                           class="form-check-label">
                        Friday
                    </label>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input asp-for="Saturday"
                           class="form-check-input" />
                    <label asp-for="Saturday"
                           class="form-check-label">
                        Saturday
                    </label>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input asp-for="Sunday"
                           class="form-check-input" />
                    <label asp-for="Sunday"
                           class="form-check-label">
                        Sunday
                    </label>
                </div>
            </div>

        </div>
    </div>

    <div class="row">

        <div class="col-md-6 mb-3">
            <label asp-for="StartTime" class="form-label">
                Start Time
            </label>

            <input asp-for="StartTime"
                   type="time"
                   class="form-control" />

            <span asp-validation-for="StartTime"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="EndTime" class="form-label">
                End Time
            </label>

            <input asp-for="EndTime"
                   type="time"
                   class="form-control" />

            <span asp-validation-for="EndTime"
                  class="text-danger"></span>
        </div>

    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label">
            Status
        </label>

        <select asp-for="Status"
                class="form-select">

            <option value="Scheduled">
                Scheduled
            </option>

            <option value="Completed">
                Completed
            </option>

            <option value="Cancelled">
                Cancelled
            </option>

        </select>
    </div>

    <div class="mt-3">

        <button type="submit"
                class="btn btn-primary">
            Create Schedule
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Schedule
        </a>

    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}