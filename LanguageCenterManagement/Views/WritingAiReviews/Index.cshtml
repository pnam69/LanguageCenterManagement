@model IEnumerable<LanguageCenterManagement.Models.WritingAiReview>

@{
    ViewData["Title"] = "Writing Integrity Reviews";
    var reviews = Model.OrderByDescending(r => r.CheckedAt).ToList();
}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Writing Integrity
                <i class="bi bi-question-circle ms-2 text-primary"
                   role="button"
                   tabindex="0"
                   data-demo-popover
                   data-bs-toggle="popover"
                   data-bs-title="Kiểm tra tính toàn vẹn bài viết"
                   data-bs-content="Xem kết quả đánh giá bài viết do AI thực hiện và kiểm tra nội dung học viên đã nộp. Hệ thống chỉ đưa ra các dấu hiệu cần chú ý để giáo viên xem xét, không tự động kết luận học viên gian lận.">
                </i>
            </h2>
            <p class="text-muted mb-0">
                Review AI assessment results and inspect student submissions.
                
            </p>
        </div>

        <a asp-controller="WritingIntegrityReviews"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-files me-1"></i>
            Similarity Reviews
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Total assessments
                        <i class="bi bi-question-circle ms-1 text-primary"
                           role="button"
                           tabindex="0"
                           data-demo-popover
                           data-bs-toggle="popover"
                           data-bs-title="Tổng số bài đánh giá"
                           data-bs-content="Tổng số lượt đánh giá bài viết đã được AI thực hiện và ghi nhận trong hệ thống.">
                        </i>
                    </div>
                    <div class="fs-3 fw-bold">@reviews.Count</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Flagged for review
                        <i class="bi bi-question-circle ms-1 text-primary"
                           role="button"
                           tabindex="0"
                           data-demo-popover
                           data-bs-toggle="popover"
                           data-bs-title="Được đề xuất xem xét"
                           data-bs-content="Số bài viết có những đặc điểm bất thường như cách diễn đạt khuôn mẫu, lặp lại ý tưởng hoặc cấu trúc câu quá đồng nhất. Giáo viên cần kiểm tra thêm trước khi đưa ra kết luận.">
                        </i>
                    </div>
                    <div class="fs-3 fw-bold text-warning">
                        @reviews.Count(r => r.Status == "Review")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">No concerns identified</div>
                    <div class="fs-3 fw-bold text-success">
                        @reviews.Count(r => r.Status == "NoConcern")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body border-bottom">
            <div class="row g-2">
                <div class="col-md-8">
                    <input id="reviewSearch"
                           type="search"
                           class="form-control"
                           placeholder="Search by exam, student ID, or question..." />
                </div>
                <div class="col-md-4">
                    <select id="statusFilter" class="form-select">
                        <option value="">All statuses</option>
                        <option value="Review">Flagged for review</option>
                        <option value="NoConcern">No concerns identified</option>
                    </select>
                </div>
            </div>
        </div>

        @if (!reviews.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-shield-check fs-1 text-muted"></i>
                <h5 class="mt-3">No assessments yet</h5>
                <p class="text-muted mb-0">
                    Writing assessments will appear here after they are processed.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0" id="reviewsTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Student / Exam</th>
                            <th>Assessment
                                <i class="bi bi-question-circle ms-1 text-primary"
                                   role="button"
                                   tabindex="0"
                                   data-demo-popover
                                   data-bs-toggle="popover"
                                   data-bs-title="Lọc trạng thái đánh giá"
                                   data-bs-content="Lọc danh sách bài đánh giá theo trạng thái: tất cả, cần xem xét hoặc không phát hiện dấu hiệu đáng chú ý.">
                                </i>
                            </th>
                            <th>Indicators
                                <i class="bi bi-question-circle ms-1 text-primary"
                                   role="button"
                                   tabindex="0"
                                   data-demo-popover
                                   data-bs-toggle="popover"
                                   data-bs-title="Các dấu hiệu được AI nhận diện"
                                   data-bs-content="Hiển thị những đặc điểm trong bài viết mà AI cho là cần chú ý, chẳng hạn như cách diễn đạt khuôn mẫu, nội dung lặp lại hoặc cấu trúc câu đồng nhất.">
                                </i>
                            </th>
                            <th>Checked</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in reviews)
                        {
                            var answer = item.ExamAnswer;
                            var result = answer?.ExamResult;
                            var exam = result?.Exam;
                            var question = answer?.Question;
                            var status = item.Status ?? "Unknown";

                            var searchableText = string.Join(" ", new[]
                            {
                                result?.StudentId.ToString() ?? "",
                                exam?.ExamName ?? "",
                                question?.QuestionText ?? "",
                                status,
                                item.Indicators ?? ""
                            });

                            <tr class="review-row"
                                data-status="@status"
                                data-search="@searchableText.ToLowerInvariant()">
                                <td class="ps-3" style="min-width: 190px;">
                                    <div class="fw-semibold">
                                        Student #@(result?.StudentId.ToString() ?? "N/A")
                                    </div>
                                    <div class="text-muted small">
                                        @(exam?.ExamName ?? "Unknown exam")
                                    </div>
                                    <div class="text-muted small">
                                        @(question?.Skill ?? "Writing")
                                    </div>
                                </td>

                                <td style="min-width: 150px;">
                                    @if (status == "Review")
                                    {
                                        <span class="badge rounded-pill bg-warning-subtle text-dark border border-warning-subtle px-3 py-2">
                                            <i class="bi bi-flag me-1"></i>
                                            Review recommended
                                        </span>
                                    }
                                    else if (status == "NoConcern")
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i>
                                            No concerns identified
                                            <i class="bi bi-question-circle ms-1 text-primary"
                                               role="button"
                                               tabindex="0"
                                               data-demo-popover
                                               data-bs-toggle="popover"
                                               data-bs-title="Không phát hiện dấu hiệu đáng chú ý"
                                               data-bs-content="Số bài viết mà AI không phát hiện các đặc điểm bất thường đáng chú ý trong quá trình đánh giá. Điều này không đảm bảo bài viết chắc chắn là nguyên bản.">
                                            </i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border px-3 py-2">
                                            @status
                                        </span>
                                    }

                                    <div class="small text-muted mt-2">
                                        Ollama assessment
                                    </div>
                                </td>

                                <td style="min-width: 250px; max-width: 380px;">
                                    <div class="fw-semibold small mb-1">
                                        @(item.Indicators ?? "No indicators provided")
                                    </div>
                                    <details class="mt-2">
                                        <summary class="small text-primary"
                                                 style="cursor:pointer;">
                                            View explanation and essay
                                            <i class="bi bi-question-circle ms-1 text-primary"
                                               role="button"
                                               tabindex="0"
                                               data-demo-popover
                                               data-bs-toggle="popover"
                                               data-bs-title="Xem giải thích và bài viết"
                                               data-bs-content="Mở phần giải thích chi tiết của AI cùng nội dung bài viết gốc do học viên gửi, giúp giáo viên tự kiểm tra các dấu hiệu được nhận diện.">
                                            </i>
                                        </summary>

                                        <div class="small text-muted mt-2 mb-2">
                                            @(item.Explanation ?? "No explanation provided")
                                        </div>

                                        <div class="border rounded p-3 bg-light"
                                             style="white-space:pre-wrap; overflow-wrap:anywhere; max-height:300px; overflow-y:auto;">
                                            @(answer?.TextAnswer ?? "No written response available.")
                                        </div>
                                    </details>
                                </td>

                                <td class="text-muted small" style="min-width: 130px;">
                                    @item.CheckedAt.ToString("dd/MM/yyyy")
                                    <div>@item.CheckedAt.ToString("HH:mm")</div>
                                </td>

                                <td class="text-end pe-3" style="min-width: 150px;">
                                    @if (result != null)
                                    {
                                        <a asp-controller="TeacherExamResults"
                                           asp-action="Grade"
                                           asp-route-id="@result.ExamResultId"
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-box-arrow-up-right me-1"></i>
                                            Open result
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">
                                            Result unavailable
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noSearchResults" class="text-center text-muted py-4 d-none">
                No assessments match your search.
            </div>
        }
    </div>

    <p class="small text-muted mt-3">
        These AI-generated indicators are not proof of misconduct.
        Teachers should inspect the response and use their own judgment.
    </p>
</div>

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById("reviewSearch");
            const filter = document.getElementById("statusFilter");
            const rows = [...document.querySelectorAll(".review-row")];
            const empty = document.getElementById("noSearchResults");

            function applyFilters() {
                const term = (search?.value || "").trim().toLowerCase();
                const status = filter?.value || "";
                let visible = 0;

                rows.forEach(row => {
                    const matchesSearch =
                        (row.dataset.search || "").includes(term);
                    const matchesStatus =
                        !status || row.dataset.status === status;
                    const show = matchesSearch && matchesStatus;

                    row.classList.toggle("d-none", !show);
                    if (show) visible++;
                });

                empty?.classList.toggle("d-none", visible !== 0);
            }

            search?.addEventListener("input", applyFilters);
            filter?.addEventListener("change", applyFilters);
        })();
    </script>
}
