@model LanguageCenterManagement.Models.Exam

@{
    ViewData["Title"] = "Delete Exam";
}

<div class="container py-4">

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <h2 class="fw-bold text-danger mb-3">
                Delete Exam
            </h2>

            <div class="alert alert-warning">
                Are you sure you want to delete this exam?
                Its questions assigned through ExamQuestions and its
                recorded results will also be deleted.
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Exam Name
                </dt>

                <dd class="col-sm-9">
                    @Model.ExamName
                </dd>

                <dt class="col-sm-3">
                    Class
                </dt>

                <dd class="col-sm-9">
                    @Model.Class?.ClassName
                </dd>

                <dt class="col-sm-3">
                    Date
                </dt>

                <dd class="col-sm-9">
                    @Model.ExamDate.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-3">
                    Questions
                </dt>

                <dd class="col-sm-9">
                    @Model.ExamQuestions.Count
                </dd>

            </dl>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="ExamId" />

                <button type="submit"
                        class="btn btn-danger">
                    <i class="bi bi-trash"></i>
                    Delete Exam
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>