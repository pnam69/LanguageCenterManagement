@model LanguageCenterManagement.Models.Enrollment

@{
    ViewData["Title"] = "Delete Enrollment";
}

<h1>Delete Enrollment</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this enrollment?
</div>

<dl class="row">

    <dt class="col-sm-3">
        Student
    </dt>

    <dd class="col-sm-9">
        @Model.Student?.FullName
    </dd>

    <dt class="col-sm-3">
        Class
    </dt>

    <dd class="col-sm-9">
        @Model.Class?.ClassName
    </dd>

    <dt class="col-sm-3">
        Registration Date
    </dt>

    <dd class="col-sm-9">
        @Model.RegistrationDate.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="EnrollmentId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>