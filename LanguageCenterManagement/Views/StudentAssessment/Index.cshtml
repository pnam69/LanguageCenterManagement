@model LanguageCenterManagement.ViewModels.StudentAssessmentViewModel

@{
    ViewData["Title"] = "Study Assessment";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">My Study Assessment</h2>
        <p class="text-muted">
            Understand your progress and identify skills to improve.
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Completed Exams</p>
                    <h3 class="fw-bold">@Model.CompletedExams</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Graded Questions</p>
                    <h3 class="fw-bold">@Model.GradedAnswers</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Overall Accuracy</p>

                    @if (Model.GradedAnswers > 0)
                    {
                        <h3 class="fw-bold">
                            @Model.OverallPercentage%
                        </h3>
                    }
                    else
                    {
                        <h3 class="fw-bold">N/A</h3>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Performance by Skill</h5>

            @foreach (var skill in Model.Skills)
            {
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <strong>@skill.Skill</strong>

                        @if (skill.PossibleScore > 0)
                        {
                            <span>
                                @skill.Percentage%
                                <small class="text-muted">
                                    (@skill.GradedQuestions questions)
                                </small>
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Not enough graded data
                            </span>
                        }
                    </div>

                    @if (skill.PossibleScore > 0)
                    {
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @(Math.Clamp(skill.Percentage, 0, 100))%"
                                 aria-valuenow="@skill.Percentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Model.GradedAnswers == 0)
            {
                <div class="alert alert-info mb-0">
                    Your assessment will appear when you have
                    completed exams with graded questions.
                </div>
            }
            else
            {
                var weakestSkill = Model.Skills
                    .Where(s => s.PossibleScore > 0)
                    .OrderBy(s => s.Percentage)
                    .FirstOrDefault();

                if (weakestSkill != null)
                {
                    <div class="alert alert-light border mb-0">
                        <strong>Suggested focus:</strong>
                        Practice more @weakestSkill.Skill questions.
                        Your current accuracy in this skill is
                        @weakestSkill.Percentage%.
                    </div>
                }
            }
        </div>
    </div>

    
    <!-- Progress Trend -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h5 class="mb-3">Progress Trend</h5>

            @if (Model.HasProgressComparison)
            {
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 rounded bg-light">
                            <small class="text-muted">Latest 3 exams</small>
                            <h3 class="mb-0">
                                @Model.RecentAveragePercentage%
                            </h3>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-3 rounded bg-light">
                            <small class="text-muted">
                                Previous exams (up to 3)
                            </small>
                            <h3 class="mb-0">
                                @Model.PreviousAveragePercentage%
                            </h3>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-3 rounded bg-light">
                            <small class="text-muted">Change</small>
                            <h3 class="mb-0">
                                @(Model.ProgressDifference > 0 ? "+" : "")@Model.ProgressDifference%
                            </h3>
                            <small>
                                @(Model.ProgressDifference > 0
                                    ? "Improving"
                                    : Model.ProgressDifference < 0
                                        ? "Needs attention"
                                        : "No change")
                            </small>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    Complete at least four exams to compare your recent
                    performance with earlier results.
                </p>
            }
        </div>
    </div>

    <!-- Recurring Errors -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h5 class="mb-2">Recurring Mistakes</h5>
            <p class="text-muted">
                Questions answered incorrectly multiple times
                across completed exams.
            </p>

            @if (Model.RecurringErrors.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Skill</th>
                                <th>Question</th>
                                <th>Incorrect attempts</th>
                                <th>Total graded attempts</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var error in Model.RecurringErrors)
                            {
                                <tr>
                                    <td>@error.Skill</td>
                                    <td style="min-width: 240px;">
                                        @error.QuestionText
                                    </td>
                                    <td>
                                        @error.IncorrectAttempts
                                    </td>
                                    <td>
                                        @error.TotalGradedAttempts
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No repeated mistakes found in the available graded
                    answers yet. More completed exams will make this
                    report more useful.
                </p>
            }
        </div>
    </div>


    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <div>
                    <h5 class="fw-bold mb-1">AI Study Recommendations</h5>
                    <p class="text-muted mb-0">
                        Get practical study advice based on your graded results.
                    </p>
                </div>

                <form id="aiRecommendationForm"
                      asp-controller="StudentAssessment"
                      asp-action="GenerateRecommendations"
                      method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            id="generateRecommendationsButton"
                            class="btn btn-primary">
                        Generate Recommendations
                    </button>
                </form>
            </div>

            <div id="recommendationLoading"
                 class="alert alert-info d-none mb-3"
                 role="status">
                Generating your recommendations. This may take a little while.
            </div>

            <div id="recommendationError"
                 class="alert alert-warning d-none mb-3"
                 role="alert"></div>

            <div id="recommendationContent" class="d-none">
                <div class="rounded-3 border bg-light p-3 mb-3">
                    <div class="text-muted small mb-1">Your main focus</div>
                    <p id="recommendationMainFocus" class="fw-semibold mb-0"></p>
                </div>

                <h6 class="fw-bold">Recommended actions</h6>
                <ul id="recommendationList" class="mb-4"></ul>

                <h6 class="fw-bold">Suggested study plan</h6>
                <p id="recommendationStudyPlan" class="mb-0"></p>

                <p class="text-muted small mt-3 mb-0">
                    AI-generated guidance based on available graded results.
                    Use it as a study aid, not as a definitive assessment.
                </p>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="p-4">
                <h5 class="fw-bold mb-0">Recent Exam Results</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Exam</th>
                            <th>Score</th>
                            <th>Submitted</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var exam in Model.RecentExams)
                        {
                            <tr>
                                <td class="ps-4">
                                    <strong>@exam.ExamName</strong>
                                </td>
                                <td>
                                    @exam.Score / @exam.MaxScore
                                </td>
                                <td>
                                    @(exam.SubmittedAt?.ToString(
                                        "dd/MM/yyyy HH:mm") ?? "-")
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-controller="StudentExams"
                                       asp-action="Result"
                                       asp-route-id="@exam.ExamResultId"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }

                        @if (!Model.RecentExams.Any())
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-4">
                                    No completed exams yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

                        
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("aiRecommendationForm");
        const button = document.getElementById(
            "generateRecommendationsButton"
        );
        const loading = document.getElementById("recommendationLoading");
        const error = document.getElementById("recommendationError");
        const content = document.getElementById("recommendationContent");

        form.addEventListener("submit", async function (event) {
            event.preventDefault();

            button.disabled = true;
            button.textContent = "Generating...";
            loading.classList.remove("d-none");
            error.classList.add("d-none");
            content.classList.add("d-none");

            try {
                const token = form.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value;

                const response = await fetch(form.action, {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken": token
                    },
                    body: new URLSearchParams({
                        "__RequestVerificationToken": token
                    })
                });

                const data = await response.json().catch(() => null);

                if (!response.ok) {
                    throw new Error(
                        data?.message ||
                        "Could not generate recommendations. Please try again."
                    );
                }

                document.getElementById(
                    "recommendationMainFocus"
                ).textContent = data.mainFocus || "";

                document.getElementById(
                    "recommendationStudyPlan"
                ).textContent = data.studyPlan || "";

                const list = document.getElementById("recommendationList");
                list.replaceChildren();

                (data.recommendations || []).forEach(function (recommendation) {
                    const item = document.createElement("li");
                    item.textContent = recommendation;
                    item.className = "mb-2";
                    list.appendChild(item);
                });

                content.classList.remove("d-none");
            } catch (err) {
                error.textContent =
                    err.message || "Something went wrong. Please try again.";
                error.classList.remove("d-none");
            } finally {
                loading.classList.add("d-none");
                button.disabled = false;
                button.textContent = "Generate Recommendations";
            }
        });
    });
</script>
