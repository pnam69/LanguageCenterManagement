@model LanguageCenterManagement.Models.Room

@{
    ViewData["Title"] = "Edit Room";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Edit Room
                    </h4>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post">
                        <!-- Trường ID ẩn để hệ thống biết đang cập nhật bản ghi nào -->
                        <input type="hidden" asp-for="RoomId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-medium"></div>

                        <!-- Hàng 1: Room Code & Room Name -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="RoomCode" class="form-control" placeholder="Room Code" />
                                    <label asp-for="RoomCode">Room Code</label>
                                    <span asp-validation-for="RoomCode" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-floating">
                                    <input asp-for="RoomName" class="form-control" placeholder="Room Name" />
                                    <label asp-for="RoomName">Room Name</label>
                                    <span asp-validation-for="RoomName" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Hàng 2: Capacity & Status -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Capacity" type="number" min="1" class="form-control" placeholder="Capacity" />
                                    <label asp-for="Capacity">Capacity</label>
                                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Status" class="form-select">
                                        <option value="Available">Available</option>
                                        <option value="InUse">In Use</option>
                                        <option value="Maintenance">Maintenance</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                    <label asp-for="Status">Status</label>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="text-muted mb-4">

                        <!-- Các nút hành động -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light btn-lg border px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5 shadow-sm">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}