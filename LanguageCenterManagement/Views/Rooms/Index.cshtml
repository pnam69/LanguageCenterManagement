@model IEnumerable<LanguageCenterManagement.Models.Room>

@{
    ViewData["Title"] = "Room Management";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    
    <!-- Cụm thông báo (Alerts) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Khung Card chính -->
    <div class="card shadow-sm border-0 rounded-3">
        <!-- Header: Tiêu đề & Nút Thêm mới -->
        <div class="card-header bg-white border-bottom py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h4 class="mb-0 fw-bold text-primary">
                <i class="bi bi-door-open me-2"></i>Room Management
            </h4>
            <a asp-action="Create" class="btn btn-primary shadow-sm fw-medium">
                <i class="bi bi-plus-lg me-1"></i> Add New Room
            </a>
        </div>

        <div class="card-body p-4">
            
            <!-- Bảng dữ liệu -->
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="ps-4 py-3">Room Code</th>
                                <th class="py-3">Room Name</th>
                                <th class="py-3 text-center">Capacity</th>
                                <th class="py-3">Status</th>
                                <th class="text-center pe-4 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var room in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">@room.RoomCode</td>
                                    <td class="fw-medium">@room.RoomName</td>
                                    
                                    <td class="text-center">
                                        <i class="bi bi-people-fill text-secondary me-1"></i> @room.Capacity
                                    </td>
                                    
                                    <!-- Badges trạng thái động -->
                                    <td>
                                        @if (room.Status == "Available")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">@room.Status</span>
                                        }
                                        else if (room.Status == "InUse")
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1">In Use</span>
                                        }
                                        else if (room.Status == "Maintenance")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-2 py-1 text-dark">@room.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-2 py-1">@room.Status</span>
                                        }
                                    </td>
                                    
                                    <!-- Nhóm nút thao tác dạng icon -->
                                    <td class="text-center pe-4">
                                        <div class="btn-group shadow-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@room.RoomId" class="btn btn-sm btn-outline-info" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@room.RoomId" class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@room.RoomId" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Thông báo khi không có dữ liệu -->
                <div class="alert alert-light text-center border p-5 mb-0" role="alert">
                    <i class="bi bi-door-closed text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-muted">No rooms found.</h5>
                    <p class="text-muted mb-0">Get started by adding a new room to the system.</p>
                </div>
            }
        </div>
    </div>
</div>