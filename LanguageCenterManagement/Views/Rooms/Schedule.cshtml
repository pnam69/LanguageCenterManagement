@model IEnumerable<LanguageCenterManagement.Models.Schedule>

@{
    ViewData["Title"] = "Room Schedule";

    var room = ViewBag.Room
        as LanguageCenterManagement.Models.Room;

    DateTime monday = ViewBag.Monday;
    DateTime sunday = ViewBag.Sunday;
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <h1>Room Schedule</h1>

        <p class="mb-0">
            <strong>@room.RoomCode</strong>
            - @room.RoomName
        </p>

        <p class="text-muted">
            Capacity: @room.Capacity |
            Status: @room.Status
        </p>
    </div>

    <a asp-action="Details"
       asp-route-id="@room.RoomId"
       class="btn btn-secondary">
        Room Details
    </a>

</div>

<div class="d-flex justify-content-between align-items-center mb-3">

    <a asp-action="Schedule"
       asp-route-id="@room.RoomId"
       asp-route-weekStart="@monday.AddDays(-7).ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">
        Previous Week
    </a>

    <strong>
        @monday.ToString("dd/MM/yyyy")
        -
        @sunday.ToString("dd/MM/yyyy")
    </strong>

    <a asp-action="Schedule"
       asp-route-id="@room.RoomId"
       asp-route-weekStart="@monday.AddDays(7).ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">
        Next Week
    </a>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No schedules are assigned to this room during this week.
    </div>
}
else
{
    <table class="table table-bordered table-hover">

        <thead>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Class</th>
                <th>Teacher</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var schedule in Model)
            {
                <tr>

                    <td>
                        @schedule.StudyDate.ToString("dddd, dd/MM/yyyy")
                    </td>

                    <td>
                        @schedule.StartTime.ToString(@"hh\:mm")
                        -
                        @schedule.EndTime.ToString(@"hh\:mm")
                    </td>

                    <td>
                        @schedule.Class?.ClassName
                    </td>

                    <td>
                        @schedule.Class?.Teacher?.FullName
                    </td>

                    <td>
                        @schedule.Status
                    </td>

                    <td>
                        <a asp-controller="Schedules"
                           asp-action="Edit"
                           asp-route-id="@schedule.ScheduleId"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-controller="Schedules"
                           asp-action="Details"
                           asp-route-id="@schedule.ScheduleId"
                           class="btn btn-sm btn-info">
                            Details
                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>
}