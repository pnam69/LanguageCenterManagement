@model IEnumerable<LanguageCenterManagement.Models.Schedule>

@{
    ViewData["Title"] = "Room Schedule";

    var room = ViewBag.Room as LanguageCenterManagement.Models.Room;

    DateTime monday = ViewBag.Monday;
    DateTime sunday = ViewBag.Sunday;
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    
    <!-- Tiêu đề & Thông tin phòng -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-primary mb-2">
                <i class="bi bi-calendar-week me-2"></i>Room Schedule
            </h3>
            <p class="text-muted mb-0 fs-6">
                <span class="me-3 text-dark fw-medium">
                    <i class="bi bi-door-open-fill text-primary me-1"></i>@room?.RoomCode - @room?.RoomName
                </span>
                <span class="me-3">
                    <i class="bi bi-people-fill text-secondary me-1"></i>Capacity: @room?.Capacity
                </span>
                <span>
                    <i class="bi bi-info-circle-fill text-info me-1"></i>Status: @room?.Status
                </span>
            </p>
        </div>
        
        <div>
            <a asp-action="Details" asp-route-id="@room?.RoomId" class="btn btn-outline-primary shadow-sm fw-medium">
                <i class="bi bi-arrow-left me-1"></i> Room Details
            </a>
        </div>
    </div>

    <!-- Thanh điều hướng tuần (Week Navigation) -->
    <div class="card shadow-sm border-0 rounded-3 mb-4 bg-light">
        <div class="card-body py-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <a asp-action="Schedule" 
               asp-route-id="@room?.RoomId" 
               asp-route-weekStart="@monday.AddDays(-7).ToString("yyyy-MM-dd")" 
               class="btn btn-white border bg-white shadow-sm fw-medium px-4">
                <i class="bi bi-chevron-left me-1"></i> Previous Week
            </a>

            <h5 class="mb-0 fw-bold text-dark d-flex align-items-center">
                <i class="bi bi-calendar3 fs-4 text-primary me-2"></i>
                @monday.ToString("dd/MM/yyyy") - @sunday.ToString("dd/MM/yyyy")
            </h5>

            <a asp-action="Schedule" 
               asp-route-id="@room?.RoomId" 
               asp-route-weekStart="@monday.AddDays(7).ToString("yyyy-MM-dd")" 
               class="btn btn-white border bg-white shadow-sm fw-medium px-4">
                Next Week <i class="bi bi-chevron-right ms-1"></i>
            </a>
        </div>
    </div>

    <!-- Bảng dữ liệu lịch học -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="alert alert-light text-center border-0 p-5 mb-0">
                    <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-muted">No schedules found.</h5>
                    <p class="text-muted mb-0">There are no classes assigned to this room during the selected week.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="ps-4 py-3">Date</th>
                                <th class="py-3">Time</th>
                                <th class="py-3">Class</th>
                                <th class="py-3">Teacher</th>
                                <th class="py-3">Status</th>
                                <th class="text-center pe-4 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium text-dark">
                                        @schedule.StudyDate.ToString("dddd, dd/MM/yyyy")
                                    </td>
                                    <td class="fw-bold text-primary">
                                        <i class="bi bi-clock me-1 text-muted small"></i>
                                        @schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")
                                    </td>
                                    <td class="fw-medium">@schedule.Class?.ClassName</td>
                                    <td class="text-muted">@schedule.Class?.Teacher?.FullName</td>
                                    
                                    <!-- Badges trạng thái động -->
                                    <td>
                                        @if (schedule.Status == "Scheduled")
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1">@schedule.Status</span>
                                        }
                                        else if (schedule.Status == "Completed")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">@schedule.Status</span>
                                        }
                                        else if (schedule.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">@schedule.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-2 py-1">@schedule.Status</span>
                                        }
                                    </td>
                                    
                                    <!-- Nhóm nút thao tác -->
                                    <td class="text-center pe-4">
                                        <div class="btn-group shadow-sm" role="group">
                                            <a asp-controller="Schedules" asp-action="Details" asp-route-id="@schedule.ScheduleId" class="btn btn-sm btn-outline-info" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="Schedules" asp-action="Edit" asp-route-id="@schedule.ScheduleId" class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>