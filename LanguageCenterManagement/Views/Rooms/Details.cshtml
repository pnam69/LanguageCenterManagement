@model LanguageCenterManagement.Models.Room

@{
    ViewData["Title"] = "Room Details";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle-fill me-2"></i>Room Details
                    </h4>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    
                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">Room Information</h5>
                    
                    <!-- Khối thông tin chi tiết phòng học -->
                    <div class="bg-light p-4 rounded-3 border mb-4">
                        <dl class="row mb-0">
                            <!-- Mã phòng & Tên phòng -->
                            <div class="col-md-6 mb-3">
                                <dt class="text-muted mb-1">Room Code</dt>
                                <dd class="fw-bold fs-6 mb-0">@Model.RoomCode</dd>
                            </div>
                            <div class="col-md-6 mb-3">
                                <dt class="text-muted mb-1">Room Name</dt>
                                <dd class="fw-bold text-primary fs-6 mb-0">@Model.RoomName</dd>
                            </div>

                            <!-- Sức chứa & Trạng thái -->
                            <div class="col-md-6 mb-0 mt-2">
                                <dt class="text-muted mb-1">Capacity</dt>
                                <dd class="fw-bold fs-6 mb-0">
                                    <i class="bi bi-people-fill text-secondary me-1"></i> @Model.Capacity
                                </dd>
                            </div>
                            <div class="col-md-6 mb-0 mt-2">
                                <dt class="text-muted mb-2">Status</dt>
                                <dd class="mb-0">
                                    @if (Model.Status == "Available")
                                    {
                                        <span class="badge bg-success px-3 py-2 fs-6 shadow-sm">@Model.Status</span>
                                    }
                                    else if (Model.Status == "InUse")
                                    {
                                        <span class="badge bg-primary px-3 py-2 fs-6 shadow-sm">In Use</span>
                                    }
                                    else if (Model.Status == "Maintenance")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 fs-6 shadow-sm">@Model.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2 fs-6 shadow-sm">@Model.Status</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                    </div>

                    <hr class="text-muted my-4">

                    <!-- Các nút hành động -->
                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                        <a asp-action="Index" class="btn btn-light btn-lg border px-4">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn btn-warning btn-lg fw-bold px-4 shadow-sm text-dark">
                            <i class="bi bi-pencil-square me-1"></i> Edit Room
                        </a>
                        <!-- Nút View Schedule được làm nổi bật -->
                        <a asp-action="Schedule" asp-route-id="@Model.RoomId" class="btn btn-primary btn-lg fw-bold px-4 shadow-sm">
                            <i class="bi bi-calendar3 me-1"></i> View Schedule
                        </a>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>