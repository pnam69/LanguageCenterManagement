@model LanguageCenterManagement.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<h1>Delete Room</h1>

<hr />

<div class="alert alert-warning">
    Are you sure you want to delete this room?
</div>

<dl class="row">

    <dt class="col-sm-3">
        Room Code
    </dt>

    <dd class="col-sm-9">
        @Model.RoomCode
    </dd>

    <dt class="col-sm-3">
        Room Name
    </dt>

    <dd class="col-sm-9">
        @Model.RoomName
    </dd>

    <dt class="col-sm-3">
        Capacity
    </dt>

    <dd class="col-sm-9">
        @Model.Capacity
    </dd>

    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>

</dl>

<form asp-action="Delete"
      method="post">

    <input type="hidden"
           asp-for="RoomId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>