@model LanguageCenterManagement.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <!-- Header màu đỏ cảnh báo -->
                <div class="card-header bg-danger text-white text-center py-3 rounded-top">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Room
                    </h4>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <!-- Alert cảnh báo -->
                    <div class="alert alert-warning border-warning d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-info-circle-fill me-3 fs-4 text-warning"></i>
                        <div>
                            <strong>Are you sure?</strong><br />
                            You are about to permanently delete this room. This action cannot be undone.
                        </div>
                    </div>

                    <!-- Khối hiển thị thông tin phòng học -->
                    <div class="bg-light p-4 rounded-3 mb-4 border">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted mb-3">Room Code</dt>
                            <dd class="col-sm-8 fw-bold mb-3">@Model.RoomCode</dd>

                            <dt class="col-sm-4 text-muted mb-3">Room Name</dt>
                            <dd class="col-sm-8 fw-bold text-primary mb-3">@Model.RoomName</dd>

                            <dt class="col-sm-4 text-muted mb-3">Capacity</dt>
                            <dd class="col-sm-8 fw-bold mb-3">
                                <i class="bi bi-people-fill text-secondary me-1"></i>@Model.Capacity
                            </dd>

                            <dt class="col-sm-4 text-muted mb-0">Status</dt>
                            <dd class="col-sm-8 fw-bold mb-0">
                                @if (Model.Status == "Available")
                                {
                                    <span class="text-success">@Model.Status</span>
                                }
                                else if (Model.Status == "InUse")
                                {
                                    <span class="text-primary">In Use</span>
                                }
                                else if (Model.Status == "Maintenance")
                                {
                                    <span class="text-warning text-dark">@Model.Status</span>
                                }
                                else
                                {
                                    <span class="text-secondary">@Model.Status</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" method="post">
                        <!-- Trường ID ẩn để hệ thống biết đang xóa bản ghi nào -->
                        <input type="hidden" asp-for="RoomId" />
                        
                        <hr class="text-muted mb-4">

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light btn-lg border px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg fw-bold px-4 shadow-sm">
                                <i class="bi bi-trash3-fill me-1"></i> Delete Confirm
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>