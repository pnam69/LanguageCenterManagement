@model IEnumerable<LanguageCenterManagement.Models.Material>

@{
    ViewData["Title"] = "My Materials";
    var classes = ViewBag.Classes
        as List<LanguageCenterManagement.Models.LanguageClass>;

    int? selectedClassId = ViewBag.SelectedClassId;
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">My Materials</h2>
    <p class="text-muted">
        Learning materials for your enrolled classes.
    </p>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">

        <form asp-action="Index"
              method="get"
              class="row g-2">

            <div class="col-md-6">
                <select name="classId"
                        class="form-select">

                    <option value="">
                        All Classes
                    </option>

                    @if (classes != null)
                    {
                        foreach (var item in classes)
                        {
                            if (selectedClassId == item.LanguageClassId)
                            {
                                <option value="@item.LanguageClassId"
                                        selected>
                                    @item.ClassCode -
                                    @item.ClassName
                                </option>
                            }
                            else
                            {
                                <option value="@item.LanguageClassId">
                                    @item.ClassCode -
                                    @item.ClassName
                                </option>
                            }
                        }
                    }
                </select>
            </div>

            <div class="col-auto">
                <button type="submit"
                        class="btn btn-outline-primary">
                    <i class="bi bi-filter me-1"></i>
                    Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4">
    @foreach (var material in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">
                        <span class="badge bg-primary">
                            @material.MaterialType
                        </span>

                        <small class="text-muted">
                            @material.CreatedAt.ToString("dd/MM/yyyy")
                        </small>
                    </div>

                    <h5 class="fw-bold">
                        @material.Title
                    </h5>

                    <div class="small text-muted mb-3">
                        <i class="bi bi-book me-1"></i>

                        @material.Class?.ClassCode -
                        @material.Class?.ClassName
                    </div>

                    @if (!string.IsNullOrWhiteSpace(material.Description))
                    {
                        <p class="text-muted">
                            @material.Description
                        </p>
                    }

                    <a asp-action="Details"
                       asp-route-id="@material.MaterialId"
                       class="btn btn-primary btn-sm">
                        View Material
                    </a>

                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">

                    <i class="bi bi-folder2-open fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No materials available
                    </h5>

                    <p class="text-muted mb-0">
                        Your teachers have not added any materials yet.
                    </p>

                </div>
            </div>
        </div>
    }
</div>