@model IEnumerable<LanguageCenterManagement.Models.SpeakingContent>

@{
	ViewData["Title"] = "Speaking Content";
}

<div class="container-fluid mt-4">

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2>Speaking Content</h2>
			<p class="text-muted mb-0">
				Manage speaking exercises and response times.
			</p>
		</div>

		<a asp-action="Create" class="btn btn-primary">
			+ Add Speaking Content
		</a>
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success">
			@TempData["SuccessMessage"]
		</div>
	}

	@if (!Model.Any())
	{
		<div class="alert alert-info">
			No speaking content has been created yet.
		</div>
	}
	else
	{
		<div class="card shadow-sm">
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">

					<thead class="table-light">
						<tr>
							<th>Prompt</th>
							<th>Preparation</th>
							<th>Response</th>
							<th style="width: 230px;">Actions</th>
						</tr>
					</thead>

					<tbody>
						@foreach (var item in Model)
						{
							<tr>
								<td>
									<strong>@item.Prompt</strong>
								</td>

								<td>
									@item.PreparationTime seconds
								</td>

								<td>
									@item.ResponseTime seconds
								</td>

								<td>
									<a asp-action="Details"
									   asp-route-id="@item.SpeakingContentId"
									   class="btn btn-sm btn-outline-primary">
										Details
									</a>

									<a asp-action="Edit"
									   asp-route-id="@item.SpeakingContentId"
									   class="btn btn-sm btn-outline-warning">
										Edit
									</a>

									<a asp-action="Delete"
									   asp-route-id="@item.SpeakingContentId"
									   class="btn btn-sm btn-outline-danger">
										Delete
									</a>
								</td>
							</tr>
						}
					</tbody>

				</table>
			</div>
		</div>
	}

</div>