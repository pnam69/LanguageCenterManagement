@model LanguageCenterManagement.Models.SpeakingContent

@{
	ViewData["Title"] = "Speaking Details";
}

<div class="container mt-4">

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2>Speaking Exercise</h2>
			<p class="text-muted">
				Practice speaking response
			</p>
		</div>

		<div>
			<a asp-action="Edit"
			   asp-route-id="@Model.SpeakingContentId"
			   class="btn btn-warning">
				Edit
			</a>

			<a asp-action="Index"
			   class="btn btn-secondary">
				Back
			</a>
		</div>
	</div>

	<div class="card shadow-sm mb-4">
		<div class="card-body">

			<h5>Prompt</h5>

			<div class="p-3 bg-light rounded">
				@Model.Prompt
			</div>

		</div>
	</div>

	<div class="row">

		<div class="col-md-6 mb-3">
			<div class="card shadow-sm h-100">
				<div class="card-body">
					<h6 class="text-muted">
						Preparation Time
					</h6>

					<h2>
						@Model.PreparationTime
						<small class="fs-6">seconds</small>
					</h2>
				</div>
			</div>
		</div>

		<div class="col-md-6 mb-3">
			<div class="card shadow-sm h-100">
				<div class="card-body">
					<h6 class="text-muted">
						Response Time
					</h6>

					<h2>
						@Model.ResponseTime
						<small class="fs-6">seconds</small>
					</h2>
				</div>
			</div>
		</div>

	</div>

</div>