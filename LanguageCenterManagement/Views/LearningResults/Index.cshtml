@model IEnumerable<LanguageCenterManagement.Models.LearningResult>

@{
    ViewData["Title"] = "Learning Results";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Learning Results</h2>
        <p class="text-muted mb-0">
            Manage students' overall learning results.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        Add Result
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Class</th>
                        <th>Course</th>
                        <th>Average</th>
                        <th>Result</th>
                        <th>Completed</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @item.Student?.FullName
                            </td>

                            <td>
                                @item.Class?.ClassCode
                                <div class="small text-muted">
                                    @item.Class?.ClassName
                                </div>
                            </td>

                            <td>
                                @item.Class?.Course?.CourseName
                            </td>

                            <td>
                                <span class="fw-semibold">
                                    @item.AverageScore.ToString("0.00")
                                </span>
                                / 10
                            </td>

                            <td>
                                @if (item.Result == "Passed")
                                {
                                    <span class="badge bg-success">
                                        Passed
                                    </span>
                                }
                                else if (item.Result == "Failed")
                                {
                                    <span class="badge bg-danger">
                                        Failed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @item.Result
                                    </span>
                                }
                            </td>

                            <td>
                                @(item.CompletedDate?.ToString("dd/MM/yyyy") ?? "-")
                            </td>

                            <td class="text-end">
                                <a asp-action="Details"
                                   asp-route-id="@item.LearningResultId"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.LearningResultId"
                                   class="btn btn-sm btn-outline-warning">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.LearningResultId"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                No learning results found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>