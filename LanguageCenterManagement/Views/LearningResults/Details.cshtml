@model LanguageCenterManagement.Models.LearningResult

@{
    ViewData["Title"] = "Learning Result Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Learning Result</h2>
        <p class="text-muted mb-0">
            Detailed learning result information.
        </p>
    </div>

    <div>
        <a asp-action="Edit"
           asp-route-id="@Model.LearningResultId"
           class="btn btn-warning">
            <i class="bi bi-pencil me-1"></i>
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                <h6 class="text-muted">Student</h6>
                <h5>@Model.Student?.FullName</h5>
            </div>

            <div class="col-md-6">
                <h6 class="text-muted">Class</h6>
                <h5>
                    @Model.Class?.ClassCode -
                    @Model.Class?.ClassName
                </h5>
            </div>

            <div class="col-md-6">
                <h6 class="text-muted">Course</h6>
                <h5>@Model.Class?.Course?.CourseName</h5>
            </div>

            <div class="col-md-6">
                <h6 class="text-muted">Teacher</h6>
                <h5>@Model.Class?.Teacher?.FullName</h5>
            </div>

            <div class="col-md-4">
                <h6 class="text-muted">Average Score</h6>
                <h3 class="fw-bold">
                    @Model.AverageScore.ToString("0.00") / 10
                </h3>
            </div>

            <div class="col-md-4">
                <h6 class="text-muted">Result</h6>

                @if (Model.Result == "Passed")
                {
                    <span class="badge bg-success fs-6">
                        Passed
                    </span>
                }
                else if (Model.Result == "Failed")
                {
                    <span class="badge bg-danger fs-6">
                        Failed
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark fs-6">
                        @Model.Result
                    </span>
                }
            </div>

            <div class="col-md-4">
                <h6 class="text-muted">Completed Date</h6>
                <h5>
                    @(Model.CompletedDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                </h5>
            </div>

            <div class="col-12">
                <h6 class="text-muted">Teacher Comment</h6>

                <div class="bg-light rounded p-3">
                    @(string.IsNullOrWhiteSpace(Model.TeacherComment)
                        ? "No comment."
                        : Model.TeacherComment)
                </div>
            </div>
        </div>
    </div>
</div>