@model LanguageCenterManagement.ViewModels.LearningResultFormViewModel

@{
    ViewData["Title"] = "Edit Learning Result";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">Edit Learning Result</h2>
    <p class="text-muted">
        Update the student's learning result.
    </p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="LearningResultId" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ClassId" class="form-label"></label>
                    <select asp-for="ClassId"
                            asp-items="ViewBag.Classes"
                            class="form-select">
                        <option value="">Select class</option>
                    </select>
                    <span asp-validation-for="ClassId"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StudentId" class="form-label"></label>
                    <select asp-for="StudentId"
                            asp-items="ViewBag.Students"
                            class="form-select">
                        <option value="">Select student</option>
                    </select>
                    <span asp-validation-for="StudentId"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="AverageScore" class="form-label"></label>
                    <input asp-for="AverageScore"
                           type="number"
                           min="0"
                           max="10"
                           step="0.01"
                           class="form-control" />
                    <span asp-validation-for="AverageScore"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Result" class="form-label"></label>
                    <select asp-for="Result" class="form-select">
                        <option value="InProgress">In Progress</option>
                        <option value="Passed">Passed</option>
                        <option value="Failed">Failed</option>
                    </select>
                    <span asp-validation-for="Result"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CompletedDate" class="form-label"></label>
                    <input asp-for="CompletedDate"
                           type="datetime-local"
                           class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="TeacherComment" class="form-label"></label>
                    <textarea asp-for="TeacherComment"
                              class="form-control"
                              rows="4"></textarea>
                    <span asp-validation-for="TeacherComment"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}