@model LanguageCenterManagement.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    
    <!-- Header & Nút hành động -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-person-vcard-fill me-2"></i>Student Profile
            </h3>
            <p class="text-muted mb-0 fs-6">
                Detailed information and enrollment history for <strong class="text-dark">@Model.FullName</strong>.
            </p>
        </div>
        
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-light border shadow-sm fw-medium">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-warning shadow-sm fw-bold text-dark">
                <i class="bi bi-pencil-square me-1"></i> Edit Student
            </a>
        </div>
    </div>

    <!-- Khối 1: Thông tin cá nhân -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-info-circle-fill me-2"></i>Personal Information
            </h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                
                <!-- Cột trái: Thông tin cơ bản -->
                <div class="col-md-6 border-end-md">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted mb-3">Student Code</dt>
                        <dd class="col-sm-8 fw-bold mb-3">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 fs-6">@Model.StudentCode</span>
                        </dd>

                        <dt class="col-sm-4 text-muted mb-3">Full Name</dt>
                        <dd class="col-sm-8 fw-bold text-primary fs-5 mb-3">@Model.FullName</dd>

                        <dt class="col-sm-4 text-muted mb-3">Date of Birth</dt>
                        <dd class="col-sm-8 fw-medium mb-3">
                            <i class="bi bi-calendar-event text-secondary me-2"></i>@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "-")
                        </dd>

                        <dt class="col-sm-4 text-muted mb-3">Gender</dt>
                        <dd class="col-sm-8 fw-medium mb-3">
                            @if (Model.Gender == "Male")
                            {
                                <i class="bi bi-gender-male text-primary me-2"></i>@Model.Gender
                            }
                            else if (Model.Gender == "Female")
                            {
                                <i class="bi bi-gender-female text-danger me-2"></i>@Model.Gender
                            }
                            else
                            {
                                <i class="bi bi-gender-ambiguous text-secondary me-2"></i>@(Model.Gender ?? "-")
                            }
                        </dd>
                        
                        <dt class="col-sm-4 text-muted mb-0">Status</dt>
                        <dd class="col-sm-8 fw-bold mb-0">
                            @if (Model.Status == "Active")
                            {
                                <span class="badge bg-success px-3 py-2 fs-6 shadow-sm">@Model.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2 fs-6 shadow-sm">@Model.Status</span>
                            }
                        </dd>
                    </dl>
                </div>

                <!-- Cột phải: Liên hệ & Hệ thống -->
                <div class="col-md-6 ps-md-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted mb-3">Phone</dt>
                        <dd class="col-sm-8 fw-medium mb-3">
                            <i class="bi bi-telephone-fill text-secondary me-2"></i>@(Model.Phone ?? "-")
                        </dd>

                        <dt class="col-sm-4 text-muted mb-3">Email</dt>
                        <dd class="col-sm-8 fw-medium mb-3">
                            <i class="bi bi-envelope-fill text-secondary me-2"></i>@(Model.Email ?? "-")
                        </dd>

                        <dt class="col-sm-4 text-muted mb-3">Address</dt>
                        <dd class="col-sm-8 fw-medium mb-3">
                            <i class="bi bi-geo-alt-fill text-secondary me-2"></i>@(Model.Address ?? "-")
                        </dd>

                        <dt class="col-sm-4 text-muted mb-0 mt-md-4">Created At</dt>
                        <dd class="col-sm-8 fw-medium text-muted mb-0 mt-md-4">
                            @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- Khối 2: Lịch sử học tập -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-clock-history me-2"></i>Enrollment History
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Enrollments != null && Model.Enrollments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="ps-4 py-3">Class Name</th>
                                <th class="py-3">Course</th>
                                <th class="py-3">Registration Date</th>
                                <th class="pe-4 py-3">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enrollment in Model.Enrollments.OrderByDescending(e => e.RegistrationDate))
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">@enrollment.Class?.ClassName</td>
                                    <td class="fw-medium text-dark">@enrollment.Class?.Course?.CourseName</td>
                                    <td class="text-muted">
                                        <i class="bi bi-calendar2 me-1"></i> @enrollment.RegistrationDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="pe-4">
                                        @if (enrollment.Status == "Confirmed" || enrollment.Status == "Studying")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">@enrollment.Status</span>
                                        }
                                        else if (enrollment.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">@enrollment.Status</span>
                                        }
                                        else if (enrollment.Status == "Pending")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-2 py-1 text-dark">@enrollment.Status</span>
                                        }
                                        else if (enrollment.Status == "Completed")
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info px-2 py-1 text-dark">@enrollment.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-2 py-1">@enrollment.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-light text-center border-0 p-5 mb-0">
                    <i class="bi bi-journal-x text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-muted">No Enrollment History</h5>
                    <p class="text-muted mb-0">This student has not been enrolled in any classes yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Đường kẻ dọc phân cách 2 cột trên màn hình lớn */
    @@media (min-width: 768px) {
        .border-end-md {
            border-right: 1px solid #dee2e6;
        }
    }
</style>