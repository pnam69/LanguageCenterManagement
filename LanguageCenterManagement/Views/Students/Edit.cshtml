@model LanguageCenterManagement.Models.Student

@{
    ViewData["Title"] = "Edit Student";
}

<!-- Flatpickr CSS cho bộ chọn ngày -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Edit Student
                    </h4>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post">
                        
                        <!-- Các trường ẩn quan trọng bắt buộc phải có khi Edit -->
                        <input type="hidden" asp-for="StudentId" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-medium"></div>

                        <!-- Khối 1: Mã học viên & Họ tên -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="StudentCode" class="form-control" placeholder="Student Code" />
                                    <label asp-for="StudentCode">Student Code</label>
                                    <span asp-validation-for="StudentCode" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-floating">
                                    <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                                    <label asp-for="FullName">Full Name</label>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Khối 2: Ngày sinh, Giới tính & Trạng thái -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <!-- Dùng Flatpickr với type="text" để ép hiển thị chuẩn DD/MM/YYYY -->
                                    <input asp-for="DateOfBirth" type="text" class="form-control custom-datepicker" placeholder="DD/MM/YYYY" />
                                    <label asp-for="DateOfBirth">Date of Birth</label>
                                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <select asp-for="Gender" class="form-select">
                                        <option value="">-- Select Gender --</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <label asp-for="Gender">Gender</label>
                                    <span asp-validation-for="Gender" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <select asp-for="Status" class="form-select">
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                    <label asp-for="Status">Status</label>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Khối 3: Điện thoại & Email -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Phone" class="form-control" placeholder="Phone Number" />
                                    <label asp-for="Phone">Phone Number</label>
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Email" type="email" class="form-control" placeholder="Email Address" />
                                    <label asp-for="Email">Email Address</label>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Khối 4: Địa chỉ -->
                        <div class="form-floating mb-4">
                            <textarea asp-for="Address" class="form-control" style="height: 100px" placeholder="Address"></textarea>
                            <label asp-for="Address">Address</label>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <hr class="text-muted mb-4">

                        <!-- Các nút hành động -->
                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                            <a asp-action="Index" class="btn btn-light btn-lg border px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-5 shadow-sm">
                                <i class="bi bi-save-fill me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <!-- Flatpickr JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            flatpickr(".custom-datepicker", {
                dateFormat: "Y-m-d",      // Giá trị thực tế gửi về Server (YYYY-MM-DD)
                altInput: true,           // Ô hiển thị ảo
                altFormat: "d/m/Y",       // Hiển thị cho người dùng (DD/MM/YYYY)
                allowInput: true          // Cho phép gõ phím trực tiếp
            });
        });
    </script>
}