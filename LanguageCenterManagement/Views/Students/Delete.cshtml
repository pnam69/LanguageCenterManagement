@model LanguageCenterManagement.Models.Student

@{
    ViewData["Title"] = "Delete Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <!-- Header cảnh báo màu đỏ -->
                <div class="card-header bg-danger text-white text-center py-3 rounded-top">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Student
                    </h4>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <!-- Alert cảnh báo -->
                    <div class="alert alert-warning border-warning d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-info-circle-fill me-3 fs-4 text-warning"></i>
                        <div>
                            <strong>Are you sure?</strong><br />
                            You are about to permanently delete this student. This action cannot be undone.
                        </div>
                    </div>

                    <!-- Khối hiển thị thông tin học viên -->
                    <div class="bg-light p-4 rounded-3 mb-4 border">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted mb-3">Student Code</dt>
                            <dd class="col-sm-8 fw-bold mb-3">
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 fs-6">
                                    @Model.StudentCode
                                </span>
                            </dd>

                            <dt class="col-sm-4 text-muted mb-3">Full Name</dt>
                            <dd class="col-sm-8 fw-bold text-primary fs-5 mb-3">
                                @Model.FullName
                            </dd>

                            <dt class="col-sm-4 text-muted mb-0">Phone</dt>
                            <dd class="col-sm-8 fw-bold mb-0">
                                <i class="bi bi-telephone-fill text-secondary me-2"></i>@Model.Phone
                            </dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" method="post">
                        <!-- Trường ID ẩn để hệ thống biết đang xóa bản ghi nào -->
                        <input type="hidden" asp-for="StudentId" />
                        
                        <hr class="text-muted mb-4">

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light btn-lg border px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg fw-bold px-4 shadow-sm">
                                <i class="bi bi-trash3-fill me-1"></i> Delete Confirm
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>