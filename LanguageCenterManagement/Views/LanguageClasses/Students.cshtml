@model LanguageCenterManagement.Models.LanguageClass

@{
    ViewData["Title"] = "Class Students";

    var activeEnrollments = Model.Enrollments
        .Where(e => e.Status != "Cancelled")
        .ToList();

    var currentStudents = activeEnrollments.Count;

    var remainingSeats = Model.MaxStudents - currentStudents;

    if (remainingSeats < 0)
    {
        remainingSeats = 0;
    }
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    
    <!-- Tiêu đề & Nút thao tác nhanh -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-easel-fill me-2"></i>@Model.ClassCode - @Model.ClassName
            </h3>
            <p class="text-muted mb-0 fs-6">
                <span class="me-3"><i class="bi bi-journal-text me-1"></i> <strong>Course:</strong> @Model.Course?.CourseName</span>
                <span><i class="bi bi-person-badge me-1"></i> <strong>Teacher:</strong> @Model.Teacher?.FullName</span>
            </p>
        </div>
        
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-light border shadow-sm fw-medium">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <a asp-action="Details" asp-route-id="@Model.LanguageClassId" class="btn btn-outline-info shadow-sm fw-medium">
                <i class="bi bi-info-circle me-1"></i> Details
            </a>
            <a asp-controller="Enrollments" asp-action="Create" asp-route-classId="@Model.LanguageClassId" class="btn btn-primary shadow-sm fw-bold">
                <i class="bi bi-person-plus-fill me-1"></i> Register Student
            </a>
        </div>
    </div>

    <!-- Khối thẻ thống kê (Stats Widgets) -->
    <div class="row g-4 mb-4">
        <!-- Max Students -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-primary border-4 h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted fw-medium mb-1">Maximum Students</h6>
                        <h3 class="mb-0 fw-bold text-dark">@Model.MaxStudents</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Current Students -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-success border-4 h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-check-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted fw-medium mb-1">Current Students</h6>
                        <h3 class="mb-0 fw-bold text-dark">@currentStudents</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Available Seats -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-warning border-4 h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-dash-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted fw-medium mb-1">Available Seats</h6>
                        <h3 class="mb-0 fw-bold text-dark">@remainingSeats</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cảnh báo lớp đầy -->
    @if (remainingSeats == 0)
    {
        <div class="alert alert-warning border-warning shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 text-warning me-3"></i>
            <div>
                <strong class="text-dark">This class is full!</strong><br />
                <span class="text-muted">No more seats are available for new student registrations in this class.</span>
            </div>
        </div>
    }

    <!-- Bảng danh sách học viên -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-card-list me-2"></i>Enrolled Students List
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Enrollments != null && Model.Enrollments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="ps-4 py-3">Student Code</th>
                                <th class="py-3">Student Name</th>
                                <th class="py-3">Phone</th>
                                <th class="py-3">Email</th>
                                <th class="py-3">Registration Date</th>
                                <th class="py-3">Status</th>
                                <th class="text-center pe-4 py-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enrollment in Model.Enrollments.OrderBy(e => e.Student!.FullName))
                            {
                                <tr>
                                    <td class="ps-4 fw-medium text-primary">@enrollment.Student?.StudentCode</td>
                                    <td class="fw-bold">@enrollment.Student?.FullName</td>
                                    <td>@enrollment.Student?.Phone</td>
                                    <td class="text-muted">@enrollment.Student?.Email</td>
                                    <td>@enrollment.RegistrationDate.ToString("dd/MM/yyyy")</td>
                                    
                                    <!-- Badges trạng thái ghi danh -->
                                    <td>
                                        @if (enrollment.Status == "Confirmed" || enrollment.Status == "Studying")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">@enrollment.Status</span>
                                        }
                                        else if (enrollment.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">@enrollment.Status</span>
                                        }
                                        else if (enrollment.Status == "Pending")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-2 py-1 text-dark">@enrollment.Status</span>
                                        }
                                        else if (enrollment.Status == "Completed")
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info px-2 py-1 text-dark">@enrollment.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-2 py-1">@enrollment.Status</span>
                                        }
                                    </td>
                                    
                                    <td class="text-center pe-4">
                                        <a asp-controller="Enrollments" asp-action="Edit" asp-route-id="@enrollment.EnrollmentId" class="btn btn-sm btn-outline-warning shadow-sm" title="Edit Enrollment">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-light text-center border-0 p-5 mb-0">
                    <i class="bi bi-person-x text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-muted">No students enrolled yet.</h5>
                    <p class="text-muted mb-0">Click the "Register Student" button above to add students to this class.</p>
                </div>
            }
        </div>
    </div>
</div>