@model LanguageCenterManagement.Models.LanguageClass

@{
    ViewData["Title"] = "Class Details";
}

<h1>Class Details</h1>

<dl class="row">

    <dt class="col-sm-3">
        Class Code
    </dt>

    <dd class="col-sm-9">
        @Model.ClassCode
    </dd>

    <dt class="col-sm-3">
        Class Name
    </dt>

    <dd class="col-sm-9">
        @Model.ClassName
    </dd>

    <dt class="col-sm-3">
        Course
    </dt>

    <dd class="col-sm-9">
        @Model.Course?.CourseName
    </dd>

    <dt class="col-sm-3">
        Teacher
    </dt>

    <dd class="col-sm-9">
        @Model.Teacher?.FullName
    </dd>

    <dt class="col-sm-3">
        Maximum Students
    </dt>

    <dd class="col-sm-9">
        @Model.MaxStudents
    </dd>

    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>

</dl>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.LanguageClassId"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>
</div>