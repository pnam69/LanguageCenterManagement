@model IEnumerable<LanguageCenterManagement.Models.LanguageClass>

@{
    ViewData["Title"] = "Language Classes";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    
    <!-- Cụm thông báo (Alerts) -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Khung Card chính -->
    <div class="card shadow-sm border-0 rounded-3">
        <!-- Header: Tiêu đề & Nút Thêm mới -->
        <div class="card-header bg-white border-bottom py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h4 class="mb-0 fw-bold text-primary">
                <i class="bi bi-easel-fill me-2"></i>Language Class Management
            </h4>
            <a asp-action="Create" class="btn btn-primary shadow-sm fw-medium">
                <i class="bi bi-plus-lg me-1"></i> Add New Class
            </a>
        </div>

        <div class="card-body p-4">
            
            <!-- Thanh tìm kiếm -->
            <div class="row mb-4">
                <div class="col-md-9 col-lg-6">
                    <form asp-action="Index" method="get">
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 ps-0" placeholder="Search by class code, name, course or teacher..." />
                            <button type="submit" class="btn btn-primary px-4">Search</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Bảng dữ liệu -->
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="ps-4 py-3">Class Code</th>
                                <th class="py-3">Class Name</th>
                                <th class="py-3">Course</th>
                                <th class="py-3">Teacher</th>
                                <th class="py-3 text-center">Max Students</th>
                                <th class="py-3">Status</th>
                                <th class="text-center pe-4 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">@item.ClassCode</td>
                                    <td class="fw-medium">@item.ClassName</td>
                                    <td class="text-muted">@item.Course?.CourseName</td>
                                    <td>@item.Teacher?.FullName</td>
                                    
                                    <td class="text-center fw-medium">
                                        <i class="bi bi-person text-secondary me-1"></i>@item.MaxStudents
                                    </td>
                                    
                                    <!-- Badges trạng thái động -->
                                    <td>
                                        @if (item.Status == "Active")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">@item.Status</span>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info px-2 py-1 text-dark">@item.Status</span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">@item.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-2 py-1">@item.Status</span>
                                        }
                                    </td>
                                    
                                    <!-- Nhóm 4 nút thao tác dạng icon -->
                                    <td class="text-center pe-4">
                                        <div class="btn-group shadow-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.LanguageClassId" class="btn btn-sm btn-outline-info" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <!-- Nút xem danh sách học viên -->
                                            <a asp-action="Students" asp-route-id="@item.LanguageClassId" class="btn btn-sm btn-outline-success" title="View Students">
                                                <i class="bi bi-people"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.LanguageClassId" class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.LanguageClassId" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Thông báo khi không có dữ liệu -->
                <div class="alert alert-light text-center border p-5 mb-0" role="alert">
                    <i class="bi bi-easel text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-muted">No classes found.</h5>
                    <p class="text-muted mb-0">Try adjusting your search or add a new language class.</p>
                </div>
            }
        </div>
    </div>
</div>