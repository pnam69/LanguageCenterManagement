@model IEnumerable<LanguageCenterManagement.Models.Enrollment>

@{
	ViewData["Title"] = "My Classes";
}

<div class="container">

	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>
			<h1>My Classes</h1>

			<p class="text-muted mb-0">
				View your enrolled classes and course information.
			</p>
		</div>

		<a asp-controller="StudentSchedule"
		   asp-action="Index"
		   class="btn btn-outline-primary">
			My Schedule
		</a>

	</div>

	@if (!Model.Any())
	{
		<div class="alert alert-info">
			You are not currently enrolled in any classes.
		</div>
	}
	else
	{
		<div class="table-responsive">

			<table class="table table-bordered table-hover align-middle">

				<thead class="table-light">
					<tr>
						<th>Class Code</th>
						<th>Class Name</th>
						<th>Course</th>
						<th>Teacher</th>
						<th>Registration Date</th>
						<th>Status</th>
					</tr>
				</thead>

				<tbody>

					@foreach (var enrollment in Model)
					{
						<tr>

							<td>
								@enrollment.Class?.ClassCode
							</td>

							<td>
								@enrollment.Class?.ClassName
							</td>

							<td>
								@enrollment.Class?.Course?.CourseName
							</td>

							<td>
								@enrollment.Class?.Teacher?.FullName
							</td>

							<td>
								@enrollment.RegistrationDate.ToString("dd/MM/yyyy")
							</td>

							<td>
								@if (enrollment.Status == "Approved")
								{
									<span class="badge bg-success">
										Approved
									</span>
								}
								else if (enrollment.Status == "Pending")
								{
									<span class="badge bg-warning text-dark">
										Pending
									</span>
								}
								else if (enrollment.Status == "Completed")
								{
									<span class="badge bg-info text-dark">
										Completed
									</span>
								}
								else
								{
									<span class="badge bg-secondary">
										@enrollment.Status
									</span>
								}
							</td>

						</tr>
					}

				</tbody>

			</table>

		</div>
	}

</div>