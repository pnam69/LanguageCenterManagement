@model LanguageCenterManagement.Models.Question

@{
	ViewData["Title"] = "Delete Question";
}

<div class="container-fluid px-lg-5 py-4">

	<div class="card border-0 shadow-sm">

		<div class="card-body p-4">

			<h2 class="fw-bold text-danger">
				Delete Question
			</h2>

			<p>
				Are you sure you want to delete this question?
			</p>

			<div class="alert alert-warning">
				<strong>@Model.QuestionText</strong>
			</div>

			@if (Model.ExamQuestions.Any())
			{
				<div class="alert alert-danger">
					This question is currently used in one or more
					exams and cannot be deleted.
				</div>

				<a asp-action="Index"
				   class="btn btn-secondary">
					Back
				</a>
			}
			else
			{
				<form asp-action="Delete"
					  method="post">

					<input type="hidden"
						   name="id"
						   value="@Model.QuestionId" />

					@Html.AntiForgeryToken()

					<button type="submit"
							class="btn btn-danger">
						Delete Question
					</button>

					<a asp-action="Index"
					   class="btn btn-outline-secondary">
						Cancel
					</a>

				</form>
			}

		</div>

	</div>

</div>