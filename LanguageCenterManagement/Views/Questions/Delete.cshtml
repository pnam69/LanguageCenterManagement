@model LanguageCenterManagement.Models.Question

@{
	ViewData["Title"] = "Delete Question";
}

<div class="container mt-4 mb-5">
	<div class="row justify-content-center">
		<div class="col-xl-8">

			<div class="card shadow-sm border-danger">

				<div class="card-header text-danger">
					<h4 class="mb-0">Delete Question</h4>
				</div>

				<div class="card-body">

					<div class="alert alert-warning">
						<strong>Warning:</strong>
						If this question is already used in an exam,
						it cannot be deleted.
					</div>

					<h5>
						@Model.QuestionText
					</h5>

					<div class="mt-3">
						<strong>Skill:</strong>
						@Model.Skill
					</div>

					<div>
						<strong>Type:</strong>
						@Model.QuestionType
					</div>

					<div>
						<strong>Score:</strong>
						@Model.Score
					</div>

					<hr />

					<h6>Answers</h6>

					<ul>
						@foreach (var answer in Model.Answers)
						{
							<li>
								@answer.AnswerText

								@if (answer.IsCorrect)
								{
									<strong class="text-success">
										(Correct)
									</strong>
								}
							</li>
						}
					</ul>

					<form asp-action="Delete"
						  method="post"
						  class="mt-4">

						<input type="hidden"
							   name="id"
							   value="@Model.QuestionId" />

						<button type="submit"
								class="btn btn-danger">
							Delete Question
						</button>

						<a asp-action="Index"
						   class="btn btn-secondary">
							Cancel
						</a>
					</form>

				</div>
			</div>

		</div>
	</div>
</div>