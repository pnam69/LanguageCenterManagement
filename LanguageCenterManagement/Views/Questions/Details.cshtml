@model LanguageCenterManagement.Models.Question

@{
	ViewData["Title"] = "Question Details";
}

<div class="container mt-4 mb-5">
	<div class="row justify-content-center">
		<div class="col-xl-9">

			<div class="card shadow-sm mb-4">
				<div class="card-header d-flex justify-content-between align-items-center">
					<h4 class="mb-0">Question Details</h4>

					<span class="badge bg-secondary">
						@Model.Skill
					</span>
				</div>

				<div class="card-body">

					<div class="mb-4">
						<h6 class="text-muted">Question</h6>

						<p class="fs-5 mb-0">
							@Model.QuestionText
						</p>
					</div>

					<div class="row">
						<div class="col-md-4">
							<strong>Question Type</strong>
							<p>@Model.QuestionType</p>
						</div>

						<div class="col-md-4">
							<strong>Skill</strong>
							<p>@Model.Skill</p>
						</div>

						<div class="col-md-4">
							<strong>Score</strong>
							<p>@Model.Score</p>
						</div>
					</div>

					<hr />

					<h5 class="mb-3">
						Answers
					</h5>

					@if (!Model.Answers.Any())
					{
						<div class="alert alert-warning">
							This question has no answers.
						</div>
					}
					else
					{
						<div class="list-group">
							@foreach (var answer in Model.Answers)
							{
								<div class="list-group-item
									@(answer.IsCorrect ? "list-group-item-success" : "")">

									<div class="d-flex justify-content-between align-items-center">
										<span>
											@answer.AnswerText
										</span>

										@if (answer.IsCorrect)
										{
											<span class="badge bg-success">
												Correct
											</span>
										}
									</div>
								</div>
							}
						</div>
					}

				</div>

				<div class="card-footer d-flex gap-2">
					<a asp-action="Edit"
					   asp-route-id="@Model.QuestionId"
					   class="btn btn-warning">
						Edit
					</a>

					<a asp-action="Delete"
					   asp-route-id="@Model.QuestionId"
					   class="btn btn-danger">
						Delete
					</a>

					<a asp-action="Index"
					   class="btn btn-secondary">
						Back
					</a>
				</div>
			</div>

		</div>
	</div>
</div>