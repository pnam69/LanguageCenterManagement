@model IEnumerable<LanguageCenterManagement.Models.Attendance>

@{
	ViewData["Title"] = "My Attendance";
}

<div class="container">

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1>My Attendance</h1>
			<p class="text-muted mb-0">
				View your attendance records.
			</p>
		</div>

		<a asp-controller="StudentDashboard"
		   asp-action="Index"
		   class="btn btn-outline-secondary">
			Back to Dashboard
		</a>
	</div>

	@if (!Model.Any())
	{
		<div class="alert alert-info">
			No attendance records are available yet.
		</div>
	}
	else
	{
		<div class="table-responsive">

			<table class="table table-bordered table-hover align-middle">

				<thead class="table-light">
					<tr>
						<th>Date</th>
						<th>Class</th>
						<th>Course</th>
						<th>Status</th>
						<th>Note</th>
					</tr>
				</thead>

				<tbody>

					@foreach (var attendance in Model)
					{
						<tr>
							<td>
								@attendance.AttendanceDate.ToString("dd/MM/yyyy")
							</td>

							<td>
								@attendance.Class?.ClassName
							</td>

							<td>
								@attendance.Class?.Course?.CourseName
							</td>

							<td>
								@if (attendance.Status == "Present")
								{
									<span class="badge bg-success">
										Present
									</span>
								}
								else if (attendance.Status == "Absent")
								{
									<span class="badge bg-danger">
										Absent
									</span>
								}
								else if (attendance.Status == "Late")
								{
									<span class="badge bg-warning text-dark">
										Late
									</span>
								}
								else
								{
									<span class="badge bg-secondary">
										@attendance.Status
									</span>
								}
							</td>

							<td>
								@(string.IsNullOrWhiteSpace(attendance.Note)
									? "-"
									: attendance.Note)
							</td>
						</tr>
					}

				</tbody>

			</table>

		</div>
	}

</div>