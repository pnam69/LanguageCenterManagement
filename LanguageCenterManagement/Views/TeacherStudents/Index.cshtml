@model LanguageCenterManagement.Models.ViewModels.TeacherStudentListViewModel

@{
    ViewData["Title"] = "My Students";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">My Students</h1>
            <p class="text-muted mb-0">
                Student contact information and attendance across your classes.
            </p>
        </div>
        <span class="badge bg-primary rounded-pill px-3 py-2">
            @Model.Students.Count enrollment(s)
        </span>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get"
                  class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="search" class="form-label">Search students</label>
                    <input id="search" name="search" value="@Model.Search"
                           class="form-control"
                           placeholder="Student name or student code" />
                </div>

                <div class="col-md-4">
                    <label for="classId" class="form-label">Class</label>
                    <select id="classId" name="classId" class="form-select">
                        <option value="">All my classes</option>
                        @foreach (var item in Model.Classes)
                        {
                            <option value="@item.ClassId"
                                    selected="@(Model.ClassId == item.ClassId)">
                                @item.ClassCode - @item.ClassName
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Students.Count == 0)
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-people display-5 text-muted"></i>
                    <h2 class="h5 mt-3">No students found</h2>
                    <p class="text-muted mb-0">
                        Try another search or select a different class.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Student</th>
                                <th>Class / Course</th>
                                <th>Contact</th>
                                <th class="text-center">Present</th>
                                <th class="text-center">Absent</th>
                                <th class="text-center">Late</th>
                                <th class="text-end pe-4">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">
                                            @student.FullName
                                        </div>
                                        <small class="text-muted">
                                            @student.StudentCode
                                        </small>
                                    </td>
                                    <td>
                                        <div class="fw-medium">
                                            @student.ClassName
                                        </div>
                                        <small class="text-muted">
                                            @student.CourseName
                                        </small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(student.Email))
                                        {
                                            <div>
                                                <i class="bi bi-envelope me-1 text-muted"></i>
                                                @student.Email
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(student.Phone))
                                        {
                                            <div>
                                                <i class="bi bi-telephone me-1 text-muted"></i>
                                                @student.Phone
                                            </div>
                                        }
                                        @if (string.IsNullOrWhiteSpace(student.Email)
                                            && string.IsNullOrWhiteSpace(student.Phone))
                                        {
                                            <span class="text-muted">No contact info</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success">
                                            @student.PresentCount
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-danger-subtle text-danger">
                                            @student.AbsentCount
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-warning-subtle text-dark">
                                            @student.LateCount
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details"
                                           asp-route-studentId="@student.StudentId"
                                           asp-route-classId="@student.ClassId"
                                           class="btn btn-sm btn-outline-primary">
                                            View profile
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
