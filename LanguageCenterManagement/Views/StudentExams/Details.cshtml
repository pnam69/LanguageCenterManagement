@model LanguageCenterManagement.ViewModels.StudentExamViewModel

@{
    ViewData["Title"] = "Exam Details";
    bool hasSubmitted = ViewBag.HasSubmitted ?? false;
}

<div class="container py-4">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-start">

                <div>
                    <h2 class="fw-bold">
                        @Model.ExamName
                    </h2>

                    <p class="text-muted mb-0">
                        @Model.ClassName
                    </p>
                </div>

                @if (hasSubmitted)
                {
                    <span class="badge bg-success">
                        Completed
                    </span>
                }
                else
                {
                    <span class="badge bg-primary">
                        @Model.ExamType
                    </span>
                }

            </div>

            <hr />

            <div class="row">

                <div class="col-md-3">
                    <strong>Date</strong>
                    <p class="text-muted">
                        @Model.ExamDate.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>

                <div class="col-md-3">
                    <strong>Duration</strong>
                    <p class="text-muted">
                        @Model.Duration minutes
                    </p>
                </div>

                <div class="col-md-3">
                    <strong>Questions</strong>
                    <p class="text-muted">
                        @Model.Questions.Count
                    </p>
                </div>

                <div class="col-md-3">
                    <strong>Maximum Score</strong>
                    <p class="text-muted">
                        @Model.MaxScore
                    </p>
                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <hr />

                <strong>Description</strong>

                <p class="text-muted">
                    @Model.Description
                </p>
            }

            @if (!hasSubmitted &&
                 Model.Questions.Any() &&
                 Model.ExamDate <= DateTime.Now)
            {
                <a asp-action="Take"
                   asp-route-id="@Model.ExamId"
                   class="btn btn-primary">
                    <i class="bi bi-play-fill"></i>
                    Start Exam
                </a>
            }

        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <h5 class="fw-bold mb-3">
                Exam Questions
            </h5>

            @foreach (var question in Model.Questions)
            {
                <div class="border rounded p-3 mb-3">

                    <strong>
                        Question @question.QuestionOrder
                    </strong>

                    <p class="mt-2 mb-0">
                        @question.QuestionText
                    </p>

                </div>
            }

        </div>

    </div>

</div>