@model LanguageCenterManagement.ViewModels.StudentExamViewModel

@{
	ViewData["Title"] = "Exam Details";
}

<div class="container mt-4 mb-5">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="fw-bold mb-1">@Model.ExamName</h2>
			<p class="text-muted mb-0">@Model.ClassName</p>
		</div>

		<a asp-action="Index" class="btn btn-outline-secondary">
			Back to Exams
		</a>
	</div>

	<div class="card shadow-sm border-0 mb-4">
		<div class="card-body">
			<div class="row g-4">
				<div class="col-md-6">
					<label class="text-muted small">Exam Type</label>
					<div class="fw-semibold">@Model.ExamType</div>
				</div>

				<div class="col-md-6">
					<label class="text-muted small">Exam Date</label>
					<div class="fw-semibold">
						@Model.ExamDate.ToString("dd/MM/yyyy HH:mm")
					</div>
				</div>

				<div class="col-md-6">
					<label class="text-muted small">Duration</label>
					<div class="fw-semibold">@Model.Duration minutes</div>
				</div>

				<div class="col-md-6">
					<label class="text-muted small">Maximum Score</label>
					<div class="fw-semibold">@Model.MaxScore</div>
				</div>

				@if (!string.IsNullOrWhiteSpace(Model.Description))
				{
					<div class="col-12">
						<label class="text-muted small">Description</label>
						<p class="mb-0">@Model.Description</p>
					</div>
				}
			</div>
		</div>
	</div>

	<div class="card shadow-sm border-0 mb-4">
		<div class="card-header bg-white py-3">
			<h5 class="mb-0">Questions</h5>
		</div>

		<div class="card-body">
			@if (!Model.Questions.Any())
			{
				<p class="text-muted mb-0">This exam has no questions yet.</p>
			}
			else
			{
				@foreach (var question in Model.Questions.OrderBy(q => q.QuestionOrder))
				{
					<div class="border rounded p-3 mb-3">
						<div class="d-flex justify-content-between align-items-start mb-2">
							<div>
								<span class="fw-bold">
									Question @question.QuestionOrder
								</span>

								<span class="badge bg-secondary ms-2">
									@question.Skill
								</span>

								<span class="badge bg-light text-dark border ms-1">
									@question.QuestionType
								</span>
							</div>

							<span class="text-muted">
								@question.Score point@(question.Score == 1 ? "" : "s")
							</span>
						</div>

						<p class="mb-0">@question.QuestionText</p>
					</div>
				}
			}
		</div>
	</div>

	@if (Model.Questions.Any())
	{
		<div class="text-center">
			<a asp-action="Take"
			   asp-route-id="@Model.ExamId"
			   class="btn btn-primary btn-lg px-5">
				Start Exam
			</a>
		</div>
	}
</div>