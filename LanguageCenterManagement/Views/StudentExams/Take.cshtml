@model LanguageCenterManagement.ViewModels.StudentExamViewModel

@{
	ViewData["Title"] = Model.ExamName;
}

<div class="container-fluid py-4 px-lg-5">

	<!-- Exam Header -->
	<div class="card shadow-sm border-0 mb-4">
		<div class="card-body p-4">
			<div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
				<div>
					<h1 class="h3 mb-2">@Model.ExamName</h1>

					<div class="text-muted">
						<span class="me-3">
							<strong>Class:</strong> @Model.ClassName
						</span>

						<span class="me-3">
							<strong>Type:</strong> @Model.ExamType
						</span>

						<span>
							<strong>Max Score:</strong> @Model.MaxScore
						</span>
					</div>
				</div>

				<div class="text-end">
					<div class="text-muted small">Time Remaining</div>
					<div id="examTimer"
						 class="fs-3 fw-bold">
						--:--
					</div>
				</div>
			</div>

			@if (!string.IsNullOrWhiteSpace(Model.Description))
			{
				<hr />

				<p class="mb-0 text-muted">
					@Model.Description
				</p>
			}
		</div>
	</div>


	<form asp-action="Take"
		  method="post"
		  id="examForm"
		  enctype="multipart/form-data"
		  data-monitor-url="@Url.Action("LogMonitoringEvent", "StudentExams")">

		@Html.AntiForgeryToken()

		<input type="hidden"
			   name="ExamId"
			   value="@Model.ExamId" />


		<!-- Progress -->
		<div class="card shadow-sm border-0 mb-4">
			<div class="card-body">
				<div class="d-flex justify-content-between mb-2">
					<span class="fw-semibold">Exam Progress</span>
					<span id="progressText">0 / @Model.Questions.Count answered</span>
				</div>

				<div class="progress"
					 style="height: 8px;">
					<div id="progressBar"
						 class="progress-bar"
						 role="progressbar"
						 style="width: 0%;">
					</div>
				</div>
			</div>
		</div>


		<!-- Questions -->
		@{
			var renderedReadingPassages = new HashSet<string>(
				StringComparer.Ordinal
			);
		}

		@for (int i = 0; i < Model.Questions.Count; i++)
		{
			var question = Model.Questions[i];

			<div class="card shadow-sm border-0 mb-4 question-card"
				 data-question-index="@i"
				 data-skill="@question.Skill">

				<div class="card-body p-4">

					<!-- Question Header -->
					<div class="d-flex justify-content-between align-items-start gap-3 mb-3">

						<div>
							<span class="badge bg-secondary mb-2">
								Question @question.QuestionOrder
							</span>

							<span class="badge bg-light text-dark border mb-2">
								@question.Skill
							</span>

							@if (question.Skill.Equals(
								"Reading",
								StringComparison.OrdinalIgnoreCase))
							{
								var passage = question.ReadingPassage?.Trim();

								var showPassage =
									!string.IsNullOrWhiteSpace(passage) &&
									renderedReadingPassages.Add(passage);

								@if (showPassage)
								{
									<div class="reading-passage bg-light border rounded p-4 mb-4">
										<h3 class="h6 fw-bold mb-3">
											Reading Passage
										</h3>

										<div style="white-space: pre-line;">
											@passage
										</div>
									</div>
								}
							}

							<h2 class="h5 mb-0">
								@question.QuestionText
							</h2>
						</div>

						<span class="badge bg-primary">
							@question.Score point@(question.Score == 1 ? "" : "s")
						</span>

					</div>

					@if (question.QuestionType == "FillInTheBlank")
					{
						<input type="text"
							   class="form-control fill-blank-answer"
							   name="Answers[@i].TextAnswer"
							   placeholder="Type your answer"
							   data-question="@question.QuestionId" />
					}

					<!-- READING -->
					@if (question.Skill.Equals(
						"Reading",
						StringComparison.OrdinalIgnoreCase))
					{

						@if (question.QuestionType != "FillInTheBlank"
							&& question.Answers.Any())
						{
							<div class="answer-list">
								@foreach (var answer in question.Answers)
								{
									<div class="form-check border rounded p-3 mb-2">
										<input class="form-check-input answer-input"
											   type="radio"
											   name="Answers[@i].AnswerId"
											   value="@answer.AnswerId"
											   id="answer_@(i)_@(answer.AnswerId)"
											   data-question="@question.QuestionId" />

										<label class="form-check-label w-100"
											   for="answer_@(i)_@(answer.AnswerId)">
											@answer.AnswerText
										</label>
									</div>
								}
							</div>
						}
					}


					<!-- LISTENING -->
					@if (question.Skill.Equals("Listening", StringComparison.OrdinalIgnoreCase))
					{
						@if (!string.IsNullOrWhiteSpace(question.ListeningAudioUrl))
						{
							<div class="bg-light border rounded p-4 mb-4">
								<h3 class="h6 fw-bold mb-3">Listening</h3>

								<audio controls class="w-100">
									<source src="@question.ListeningAudioUrl" type="audio/mpeg" />
									Your browser does not support the audio element.
								</audio>
							</div>
						}

						@if (question.Answers.Any())
						{
							<div class="answer-list">

								@foreach (var answer in question.Answers)
								{
									<div class="form-check border rounded p-3 mb-2">

										<input class="form-check-input answer-input"
											   type="radio"
											   name="Answers[@i].AnswerId"
											   value="@answer.AnswerId"
											   id="answer_@(i)_@(answer.AnswerId)"
											   data-question="@question.QuestionId" />

										<label class="form-check-label w-100"
											   for="answer_@(i)_@(answer.AnswerId)">
											@answer.AnswerText
										</label>

									</div>
								}

							</div>
						}
					}


					<!-- SPEAKING -->
					@if (question.Skill.Equals("Speaking",
						StringComparison.OrdinalIgnoreCase))
					{
						<div class="speaking-section">

							@if (!string.IsNullOrWhiteSpace(question.SpeakingPrompt))
							{
								<div class="alert alert-light border mb-4">

									<strong>Speaking Prompt</strong>

									<div class="mt-2">
										@question.SpeakingPrompt
									</div>

								</div>
							}


							<div class="row g-3 mb-4">

								<div class="col-md-6">
									<div class="border rounded p-3 h-100">

										<div class="text-muted small">
											Preparation Time
										</div>

										<div class="fs-4 fw-bold">
											@(question.SpeakingPreparationTime ?? 0)
											seconds
										</div>

									</div>
								</div>


								<div class="col-md-6">
									<div class="border rounded p-3 h-100">

										<div class="text-muted small">
											Response Time
										</div>

										<div class="fs-4 fw-bold">
											@(question.SpeakingResponseTime ?? 0)
											seconds
										</div>

									</div>
								</div>

							</div>


							<div class="border rounded p-4">

								<div class="d-flex justify-content-between align-items-center mb-3">

									<div>
										<div class="fw-semibold">
											<i class="bi bi-mic me-1"></i>
											Speaking Response
										</div>

										<div class="text-muted small">
											Record your response after the preparation time.
										</div>
									</div>

									<span id="speakingTimer_@question.QuestionId"
										  class="badge bg-secondary">
										Ready
									</span>

								</div>


								<div class="d-flex flex-wrap gap-2 mb-3">

									<button type="button"
											class="btn btn-primary speaking-start"
											data-question="@question.QuestionId"
											data-index="@i"
											data-preparation="@(question.SpeakingPreparationTime ?? 0)"
											data-response="@(question.SpeakingResponseTime ?? 0)">

										<i class="bi bi-mic-fill me-1"></i>
										Start Recording
									</button>

									<button type="button"
											class="btn btn-danger speaking-stop"
											data-question="@question.QuestionId"
											data-index="@i"
											disabled>

										<i class="bi bi-stop-fill me-1"></i>
										Stop Recording
									</button>

								</div>


								<div class="speaking-status text-muted small mb-3"
									 id="speakingStatus_@question.QuestionId">
									Microphone not started.
								</div>


								<audio class="w-100 speaking-preview d-none"
									   id="speakingPreview_@question.QuestionId"
									   controls>
								</audio>


								<input type="file"
									   name="Answers[@i].AudioFile"
									   id="audioFile_@question.QuestionId"
									   class="d-none"
									   accept="audio/*" />

							</div>

						</div>
					}

					<!-- WRITING -->
					@if (question.Skill.Equals("Writing",
						StringComparison.OrdinalIgnoreCase))
					{
						<div class="writing-section">

							@if (!string.IsNullOrWhiteSpace(question.WritingPrompt))
							{
								<div class="alert alert-light border mb-4">

									<strong>Writing Prompt</strong>

									<div class="mt-2">
										@question.WritingPrompt
									</div>

								</div>
							}

							<textarea class="form-control writing-answer"
									  name="Answers[@i].TextAnswer"
									  rows="12"
									  placeholder="Write your answer here..."
									  data-question="@question.QuestionId"></textarea>

							<div class="d-flex justify-content-between mt-2">

								<span class="text-muted small">
									Word count:
									<strong class="word-count">0</strong>
								</span>

								<span class="text-muted small">
									Minimum:
									@(question.WritingPrompt != null ? "See instructions" : "—")
								</span>

							</div>

						</div>
					}


					<!-- Fallback for other question types -->
					@if (
						question.QuestionType != "FillInTheBlank" &&
						!question.Skill.Equals("Reading", StringComparison.OrdinalIgnoreCase) &&
						!question.Skill.Equals("Listening", StringComparison.OrdinalIgnoreCase) &&
						!question.Skill.Equals("Speaking", StringComparison.OrdinalIgnoreCase) &&
						!question.Skill.Equals("Writing", StringComparison.OrdinalIgnoreCase)
					)
					{
						@if (question.Answers.Any())
						{
							foreach (var answer in question.Answers)
							{
								<div class="form-check border rounded p-3 mb-2">

									<input class="form-check-input answer-input"
										   type="radio"
										   name="Answers[@i].AnswerId"
										   value="@answer.AnswerId"
										   id="answer_@(i)_@(answer.AnswerId)"
										   data-question="@question.QuestionId" />

									<label class="form-check-label w-100"
										   for="answer_@(i)_@(answer.AnswerId)">
										@answer.AnswerText
									</label>

								</div>
							}
						}
					}


					<input type="hidden"
						   name="Answers[@i].QuestionId"
						   value="@question.QuestionId" />

				</div>
			</div>
		}


		<!-- Submit -->
		<div class="card shadow-sm border-0 mb-5">
			<div class="card-body p-4 text-center">

				<h2 class="h5 mb-2">
					Ready to submit?
				</h2>

				<p class="text-muted mb-4">
					Make sure you have completed all sections before submitting.
				</p>

				<button type="submit"
						class="btn btn-primary btn-lg px-5"
						id="submitExamButton">
					Submit Exam
				</button>

			</div>
		</div>

	</form>

</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const examForm = document.getElementById("examForm");

            if (!examForm) return;

            const timerElement = document.getElementById("examTimer");
            const submitButton = document.getElementById("submitExamButton");

            let examSubmitted = false;
            let submissionInProgress = false;
            let examTimerInterval = null;

            const speakingRecorders = new Map();

            // ============================================================
            // 1. COMMON UTILITIES
            // ============================================================

            function stopMediaStream(stream) {
                if (!stream) return;

                stream.getTracks().forEach(track => track.stop());
            }

            function formatTime(seconds) {
                const minutes = Math.floor(seconds / 60);
                const remaining = seconds % 60;

                return `${String(minutes).padStart(2, "0")}:${String(remaining).padStart(2, "0")}`;
            }

            // ============================================================
            // 2. COPY / PASTE RESTRICTIONS
            // ============================================================

            ["copy", "cut", "paste", "contextmenu"].forEach(eventType => {
                examForm.addEventListener(eventType, event => {
                    event.preventDefault();
                });
            });

            examForm.addEventListener("keydown", event => {
                if (
                    (event.ctrlKey || event.metaKey) &&
                    ["c", "x", "v", "a"].includes(event.key.toLowerCase())
                ) {
                    event.preventDefault();
                }
            });

            // ============================================================
            // 3. EXAM MONITORING
            // ============================================================

            const examIdInput = examForm.querySelector('input[name="ExamId"]');
            const tokenInput = examForm.querySelector('input[name="__RequestVerificationToken"]');

            const examId = examIdInput?.value;
            const antiforgeryToken = tokenInput?.value;
            const monitorUrl = examForm.dataset.monitorUrl;

            let interruptionStartedAt = null;
            let interruptionEventType = null;

            function reportMonitoringEvent(eventType, durationSeconds = null) {

                if (examSubmitted || !monitorUrl || !examId || !antiforgeryToken) {
                    return Promise.resolve();
                }

                const body = new URLSearchParams({
                    examId: examId,
                    eventType: eventType
                });

                if (durationSeconds !== null) {
                    body.set("durationSeconds", String(durationSeconds));
                }

                return fetch(monitorUrl, {
                    method: "POST",
                    credentials: "same-origin",
                    keepalive: true,
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "RequestVerificationToken": antiforgeryToken
                    },
                    body: body.toString()
                }).catch(error => {
                    console.error("Monitoring event could not be reported:", error);
                });
            }

            function handleFocusLost(eventType) {

                if (examSubmitted || interruptionStartedAt !== null) {
                    return;
                }

                interruptionStartedAt = Date.now();
                interruptionEventType = eventType;

                reportMonitoringEvent(eventType);
            }

            function handleFocusRegained() {

                if (interruptionStartedAt === null) {
                    return;
                }

                const durationSeconds = Math.min(
                    86400,
                    Math.max(
                        0,
                        Math.round((Date.now() - interruptionStartedAt) / 1000)
                    )
                );

                interruptionStartedAt = null;
                interruptionEventType = null;

                reportMonitoringEvent("FocusRegained", durationSeconds);
            }

            document.addEventListener("visibilitychange", function () {

                if (document.hidden) {
                    handleFocusLost("TabHidden");
                } else {
                    handleFocusRegained();
                }

            });

            window.addEventListener("blur", function () {

                if (!document.hidden) {
                    handleFocusLost("WindowBlurred");
                }

            });

            window.addEventListener("focus", function () {

                if (!document.hidden) {
                    handleFocusRegained();
                }

            });

            // ============================================================
            // 4. EXAM TIMER
            // ============================================================

            const examDurationMinutes = Number(@Model.Duration);

            const examDurationSeconds = Math.max(
                0,
                Math.floor(examDurationMinutes * 60)
            );

            const examDeadline = Date.now() + examDurationSeconds * 1000;

            function updateExamTimer() {

                if (examSubmitted) return;

                const remainingSeconds = Math.max(
                    0,
                    Math.ceil((examDeadline - Date.now()) / 1000)
                );

                if (timerElement) {
                    timerElement.textContent = formatTime(remainingSeconds);
                }

                if (remainingSeconds <= 0) {

                    clearInterval(examTimerInterval);

                    alert("Time is up. Your exam is being submitted.");

                    submitExam(false);
                }
            }

            updateExamTimer();

            if (examDurationSeconds > 0) {
                examTimerInterval = setInterval(updateExamTimer, 250);
            } else {
                submitExam(false);
            }

            // ============================================================
            // 5. PROGRESS TRACKING
            // ============================================================

            const questionCards = document.querySelectorAll(".question-card");

            const progressText = document.getElementById("progressText");
            const progressBar = document.getElementById("progressBar");

            function isQuestionAnswered(card) {

                // Multiple choice / True-False / checkbox questions.
                const selectedAnswer = card.querySelector(
                    'input[type="radio"]:checked, input[type="checkbox"]:checked'
                );

                if (selectedAnswer) return true;

                // Written answers / Fill in the blank.
                const textAnswers = card.querySelectorAll(
                    "textarea.writing-answer, input.fill-blank-answer"
                );

                for (const input of textAnswers) {
                    if (input.value.trim().length > 0) {
                        return true;
                    }
                }

                // Speaking recordings.
                const audioFile = card.querySelector(
                    'input[type="file"][name$=".AudioFile"]'
                );

                return !!(
                    audioFile &&
                    audioFile.files &&
                    audioFile.files.length > 0
                );
            }

            function updateProgress() {

                let answered = 0;

                questionCards.forEach(card => {
                    if (isQuestionAnswered(card)) {
                        answered++;
                    }
                });

                const total = questionCards.length;

                const percentage = total === 0
                    ? 0
                    : Math.round((answered / total) * 100);

                if (progressText) {
                    progressText.textContent = `${answered} / ${total} answered`;
                }

                if (progressBar) {
                    progressBar.style.width = `${percentage}%`;
                    progressBar.setAttribute("aria-valuenow", percentage);
                }
            }

            examForm.addEventListener("change", event => {

                if (event.target.matches(".answer-input, .fill-blank-answer, input[type='file']")) {
                    updateProgress();
                }

            });

            examForm.addEventListener("input", event => {

                if (event.target.matches(".writing-answer, .fill-blank-answer")) {
                    updateProgress();
                }

            });

            // Word counter.
            document.querySelectorAll(".writing-answer").forEach(textarea => {

                textarea.addEventListener("input", function () {

                    const writingSection = textarea.closest(".writing-section");

                    const countElement = writingSection?.querySelector(".word-count");

                    if (!countElement) return;

                    const words = textarea.value.trim()
                        .split(/\s+/)
                        .filter(Boolean);

                    countElement.textContent = words.length;

                });

            });

            updateProgress();

            // ============================================================
            // 6. SPEAKING RECORDING
            // ============================================================

            function getSpeakingElements(questionId) {

                return {
                    startButton: document.querySelector(
                        `.speaking-start[data-question="${questionId}"]`
                    ),

                    stopButton: document.querySelector(
                        `.speaking-stop[data-question="${questionId}"]`
                    ),

                    timer: document.getElementById(
                        `speakingTimer_${questionId}`
                    ),

                    status: document.getElementById(
                        `speakingStatus_${questionId}`
                    ),

                    preview: document.getElementById(
                        `speakingPreview_${questionId}`
                    ),

                    fileInput: document.getElementById(
                        `audioFile_${questionId}`
                    )
                };
            }

            function finishSpeakingRecording(questionId, message = null) {

                const data = speakingRecorders.get(questionId);

                if (!data || data.finished) return Promise.resolve();

                data.finished = true;

                clearInterval(data.timerInterval);

                if (data.recorder && data.recorder.state !== "inactive") {

                    return new Promise(resolve => {

                        data.stopResolve = resolve;

                        try {
                            data.recorder.stop();
                        } catch (error) {
                            console.error("Recording stop failed:", error);
                            stopMediaStream(data.stream);
                            resolve();
                        }

                    });

                }

                stopMediaStream(data.stream);

                if (message) {
                    data.elements.status.textContent = message;
                }

                return Promise.resolve();
            }

            function startActualRecording(questionId) {

                const data = speakingRecorders.get(questionId);

                if (!data || examSubmitted || data.finished) return;

                const { recorder, elements } = data;

                try {

                    recorder.start();

                    data.phase = "response";

                    data.deadline = Date.now() + data.responseSeconds * 1000;

                    elements.status.textContent = "Recording your response...";

                    updateSpeakingTimer(questionId);

                } catch (error) {

                    console.error("Could not start recording:", error);

                    finishSpeakingRecording(
                        questionId,
                        "Unable to start recording."
                    );

                }
            }

            function updateSpeakingTimer(questionId) {

                const data = speakingRecorders.get(questionId);

                if (!data || data.finished) return;

                const elements = data.elements;

                const remaining = Math.max(
                    0,
                    Math.ceil((data.deadline - Date.now()) / 1000)
                );

                if (data.phase === "preparation") {

                    elements.timer.textContent = `Prepare: ${remaining}s`;

                    elements.status.textContent =
                        "Preparation time. Get ready to speak.";

                    if (remaining <= 0) {

                        startActualRecording(questionId);

                        return;
                    }

                } else {

                    elements.timer.textContent = `Recording: ${remaining}s`;

                    elements.status.textContent = "Recording your response...";

                    if (remaining <= 0) {

                        finishSpeakingRecording(questionId);

                        return;
                    }

                }

            }

            document.querySelectorAll(".speaking-start").forEach(button => {

                button.addEventListener("click", async function () {

                    if (examSubmitted || button.disabled) return;

                    const questionId = button.dataset.question;

                    const preparation = Math.max(
                        0,
                        parseInt(button.dataset.preparation) || 0
                    );

                    const response = Math.max(
                        0,
                        parseInt(button.dataset.response) || 0
                    );

                    const elements = getSpeakingElements(questionId);

                    if (
                        !elements.stopButton ||
                        !elements.timer ||
                        !elements.status ||
                        !elements.fileInput
                    ) {
                        console.error("Speaking question elements are missing:", questionId);
                        return;
                    }

                    if (!navigator.mediaDevices?.getUserMedia ||
                        !window.MediaRecorder) {

                        alert("Audio recording is not supported by this browser.");

                        return;
                    }

                    button.disabled = true;
                    elements.stopButton.disabled = true;

                    elements.status.textContent = "Requesting microphone access...";

                    try {

                        const stream = await navigator.mediaDevices.getUserMedia({
                            audio: true
                        });

                        // Exam may have been submitted while microphone permission was pending.
                        if (examSubmitted) {
                            stopMediaStream(stream);
                            return;
                        }

                        const mimeType = [
                            "audio/webm;codecs=opus",
                            "audio/webm",
                            "audio/mp4"
                        ].find(type => MediaRecorder.isTypeSupported(type));

                        const recorder = mimeType
                            ? new MediaRecorder(stream, { mimeType })
                            : new MediaRecorder(stream);

                        const data = {
                            recorder: recorder,
                            stream: stream,
                            chunks: [],
                            timerInterval: null,
                            deadline: 0,
                            phase: "preparation",
                            preparationSeconds: preparation,
                            responseSeconds: response,
                            finished: false,
                            stopResolve: null,
                            objectUrl: null,
                            elements: elements
                        };

                        speakingRecorders.set(questionId, data);

                        recorder.ondataavailable = event => {

                            if (event.data.size > 0) {
                                data.chunks.push(event.data);
                            }

                        };

                        recorder.onerror = event => {

                            console.error("Recording error:", event.error);

                            elements.status.textContent =
                                "An error occurred during recording.";

                        };

                        recorder.onstop = function () {

                            stopMediaStream(stream);

                            const blob = new Blob(data.chunks, {
                                type: recorder.mimeType || "audio/webm"
                            });

                            if (blob.size > 0) {

                                const extension = blob.type.includes("mp4")
                                    ? "mp4"
                                    : "webm";

                                const file = new File(
                                    [blob],
                                    `speaking_${questionId}.${extension}`,
                                    { type: blob.type }
                                );

                                const transfer = new DataTransfer();

                                transfer.items.add(file);

                                elements.fileInput.files = transfer.files;

                                if (data.objectUrl) {
                                    URL.revokeObjectURL(data.objectUrl);
                                }

                                data.objectUrl = URL.createObjectURL(blob);

                                if (elements.preview) {
                                    elements.preview.src = data.objectUrl;
                                    elements.preview.classList.remove("d-none");
                                }

                                elements.status.textContent =
                                    "Recording completed. Listen to your response before submitting.";

                                elements.timer.textContent = "Recorded";

                            } else {

                                elements.status.textContent =
                                    "No audio was recorded. Please try again.";

                            }

                            elements.stopButton.disabled = true;

                            if (blob.size === 0 && !examSubmitted) {
                                elements.startButton.disabled = false;
                            }

                            updateProgress();

                            if (data.stopResolve) {
                                data.stopResolve();
                                data.stopResolve = null;
                            }

                        };

                        elements.stopButton.disabled = false;

                        // Do NOT start MediaRecorder here.
                        // Preparation time must not be included in the audio.

                        if (preparation > 0) {

                            data.deadline = Date.now() + preparation * 1000;

                        } else {

                            startActualRecording(questionId);

                        }

                        if (!data.finished) {

                            updateSpeakingTimer(questionId);

                            data.timerInterval = setInterval(() => {
                                updateSpeakingTimer(questionId);
                            }, 250);

                        }

                    } catch (error) {

                        console.error("Microphone access failed:", error);

                        button.disabled = false;
                        elements.stopButton.disabled = true;

                        elements.status.textContent =
                            "Unable to access your microphone. Check microphone permissions.";

                        alert(
                            "Unable to access your microphone. Please allow microphone access and try again."
                        );

                    }

                });

            });

            // Manual stop button.
            document.querySelectorAll(".speaking-stop").forEach(button => {

                button.addEventListener("click", async function () {

                    const questionId = button.dataset.question;

                    const data = speakingRecorders.get(questionId);

                    if (!data || data.finished) return;

                    const elements = data.elements;

                    if (data.phase === "preparation") {

                        // Cancelled before recording actually started.
                        clearInterval(data.timerInterval);

                        data.finished = true;

                        stopMediaStream(data.stream);

                        elements.status.textContent =
                            "Preparation cancelled. You can try recording again.";

                        elements.timer.textContent = "Cancelled";

                        elements.startButton.disabled = false;
                        elements.stopButton.disabled = true;

                        speakingRecorders.delete(questionId);

                        return;
                    }

                    elements.status.textContent = "Stopping recording...";

                    button.disabled = true;

                    await finishSpeakingRecording(questionId);

                });

            });

            // ============================================================
            // 7. SUBMISSION AND CLEANUP
            // ============================================================

            async function stopAllSpeakingRecorders() {

                const promises = [];

                speakingRecorders.forEach((data, questionId) => {

                    if (!data.finished) {
                        promises.push(finishSpeakingRecording(questionId));
                    }

                });

                await Promise.all(promises);
            }

            async function submitExam(requireConfirmation) {

                if (examSubmitted || submissionInProgress) return;

                if (requireConfirmation) {

                    const confirmed = confirm(
                        "Are you sure you want to submit this exam? You will not be able to submit it again."
                    );

                    if (!confirmed) return;

                }

                submissionInProgress = true;
                examSubmitted = true;

                clearInterval(examTimerInterval);

                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.textContent = "Submitting...";
                }

                // Prevent further monitoring requests.
                // Close any active interruption without reporting a false regain event.
                interruptionStartedAt = null;
                interruptionEventType = null;

                // Finish active recordings before submitting the form.
                // This ensures their generated files are attached to the request.
                await stopAllSpeakingRecorders();

                // Use native submission to avoid triggering confirmation again.
                HTMLFormElement.prototype.submit.call(examForm);
            }

            examForm.addEventListener("submit", function (event) {

                event.preventDefault();

                submitExam(true);

            });

            // ============================================================
            // 8. ANSWER ROW CLICK SUPPORT
            // ============================================================

            examForm.querySelectorAll(".form-check.border.rounded").forEach(row => {

                row.addEventListener("click", event => {

                    const radio = row.querySelector(".answer-input");

                    if (!radio || event.target.closest("input, label, button")) {
                        return;
                    }

                    if (!radio.checked && !radio.disabled) {

                        radio.checked = true;

                        radio.dispatchEvent(
                            new Event("change", { bubbles: true })
                        );

                    }

                });

            });

            // ============================================================
            // 9. INITIALIZATION
            // ============================================================

            updateProgress();

        });
    </script>
}