@model LanguageCenterManagement.ViewModels.StudentExamViewModel

@{
	ViewData["Title"] = Model.ExamName;
}

<div class="container-fluid py-4 px-lg-5">

	<!-- Exam Header -->
	<div class="card shadow-sm border-0 mb-4">
		<div class="card-body p-4">
			<div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
				<div>
					<h1 class="h3 mb-2">@Model.ExamName</h1>

					<div class="text-muted">
						<span class="me-3">
							<strong>Class:</strong> @Model.ClassName
						</span>

						<span class="me-3">
							<strong>Type:</strong> @Model.ExamType
						</span>

						<span>
							<strong>Max Score:</strong> @Model.MaxScore
						</span>
					</div>
				</div>

				<div class="text-end">
					<div class="text-muted small">Time Remaining</div>
					<div id="examTimer"
						 class="fs-3 fw-bold">
						--:--
					</div>
				</div>
			</div>

			@if (!string.IsNullOrWhiteSpace(Model.Description))
			{
				<hr />

				<p class="mb-0 text-muted">
					@Model.Description
				</p>
			}
		</div>
	</div>


	<form asp-action="Take"
		  method="post"
		  id="examForm"
		  enctype="multipart/form-data"
		  data-monitor-url="@Url.Action("LogMonitoringEvent", "StudentExams")">

		@Html.AntiForgeryToken()

		<input type="hidden"
			   name="ExamId"
			   value="@Model.ExamId" />


		<!-- Progress -->
		<div class="card shadow-sm border-0 mb-4">
			<div class="card-body">
				<div class="d-flex justify-content-between mb-2">
					<span class="fw-semibold">Exam Progress</span>
					<span id="progressText">0 / @Model.Questions.Count answered</span>
				</div>

				<div class="progress"
					 style="height: 8px;">
					<div id="progressBar"
						 class="progress-bar"
						 role="progressbar"
						 style="width: 0%;">
					</div>
				</div>
			</div>
		</div>


		<!-- Questions -->
		@{
			var renderedReadingPassages = new HashSet<string>(
				StringComparer.Ordinal
			);
		}

		@for (int i = 0; i < Model.Questions.Count; i++)
		{
			var question = Model.Questions[i];

			<div class="card shadow-sm border-0 mb-4 question-card"
				 data-question-index="@i"
				 data-skill="@question.Skill">

				<div class="card-body p-4">

					<!-- Question Header -->
					<div class="d-flex justify-content-between align-items-start gap-3 mb-3">

						<div>
							<span class="badge bg-secondary mb-2">
								Question @question.QuestionOrder
							</span>

							<span class="badge bg-light text-dark border mb-2">
								@question.Skill
							</span>

							@if (question.Skill.Equals(
								"Reading",
								StringComparison.OrdinalIgnoreCase))
							{
								var passage = question.ReadingPassage?.Trim();

								var showPassage =
									!string.IsNullOrWhiteSpace(passage) &&
									renderedReadingPassages.Add(passage);

								@if (showPassage)
								{
									<div class="reading-passage bg-light border rounded p-4 mb-4">
										<h3 class="h6 fw-bold mb-3">
											Reading Passage
										</h3>

										<div style="white-space: pre-line;">
											@passage
										</div>
									</div>
								}
							}

							<h2 class="h5 mb-0">
								@question.QuestionText
							</h2>
						</div>

						<span class="badge bg-primary">
							@question.Score point@(question.Score == 1 ? "" : "s")
						</span>

					</div>

					@if (question.QuestionType == "FillInTheBlank")
					{
						<input type="text"
							   class="form-control fill-blank-answer"
							   name="Answers[@i].TextAnswer"
							   placeholder="Type your answer"
							   data-question="@question.QuestionId" />
					}

					<!-- READING -->
					@if (question.Skill.Equals(
						"Reading",
						StringComparison.OrdinalIgnoreCase))
					{

						@if (question.QuestionType != "FillInTheBlank"
							&& question.Answers.Any())
						{
							<div class="answer-list">
								@foreach (var answer in question.Answers)
								{
									<div class="form-check border rounded p-3 mb-2">
										<input class="form-check-input answer-input"
											   type="radio"
											   name="Answers[@i].AnswerId"
											   value="@answer.AnswerId"
											   id="answer_@(i)_@(answer.AnswerId)"
											   data-question="@question.QuestionId" />

										<label class="form-check-label w-100"
											   for="answer_@(i)_@(answer.AnswerId)">
											@answer.AnswerText
										</label>
									</div>
								}
							</div>
						}
					}


					<!-- LISTENING -->
					@if (question.Skill.Equals("Listening",
						StringComparison.OrdinalIgnoreCase))
					{
						@if (!string.IsNullOrWhiteSpace(question.ListeningAudioUrl))
						{
							<div class="bg-light border rounded p-4 mb-4">

								<h3 class="h6 fw-bold mb-3">
									Listening
								</h3>

								<audio controls
									   class="w-100">
									<source src="@question.ListeningAudioUrl"
											type="audio/mpeg" />

									Your browser does not support the audio element.
								</audio>

							</div>
						}

						@if (question.Answers.Any())
						{
							<div class="answer-list">

								@foreach (var answer in question.Answers)
								{
									<div class="form-check border rounded p-3 mb-2">

										<input class="form-check-input answer-input"
											   type="radio"
											   name="Answers[@i].AnswerId"
											   value="@answer.AnswerId"
											   id="answer_@(i)_@(answer.AnswerId)"
											   data-question="@question.QuestionId" />

										<label class="form-check-label w-100"
											   for="answer_@(i)_@(answer.AnswerId)">
											@answer.AnswerText
										</label>

									</div>
								}

							</div>
						}
					}


					<!-- SPEAKING -->
					@if (question.Skill.Equals("Speaking",
						StringComparison.OrdinalIgnoreCase))
					{
						<div class="speaking-section">

							@if (!string.IsNullOrWhiteSpace(question.SpeakingPrompt))
							{
								<div class="alert alert-light border mb-4">

									<strong>Speaking Prompt</strong>

									<div class="mt-2">
										@question.SpeakingPrompt
									</div>

								</div>
							}


							<div class="row g-3 mb-4">

								<div class="col-md-6">
									<div class="border rounded p-3 h-100">

										<div class="text-muted small">
											Preparation Time
										</div>

										<div class="fs-4 fw-bold">
											@(question.SpeakingPreparationTime ?? 0)
											seconds
										</div>

									</div>
								</div>


								<div class="col-md-6">
									<div class="border rounded p-3 h-100">

										<div class="text-muted small">
											Response Time
										</div>

										<div class="fs-4 fw-bold">
											@(question.SpeakingResponseTime ?? 0)
											seconds
										</div>

									</div>
								</div>

							</div>


							<div class="border rounded p-4">

								<div class="d-flex justify-content-between align-items-center mb-3">

									<div>
										<div class="fw-semibold">
											<i class="bi bi-mic me-1"></i>
											Speaking Response
										</div>

										<div class="text-muted small">
											Record your response after the preparation time.
										</div>
									</div>

									<span id="speakingTimer_@question.QuestionId"
										  class="badge bg-secondary">
										Ready
									</span>

								</div>


								<div class="d-flex flex-wrap gap-2 mb-3">

									<button type="button"
											class="btn btn-primary speaking-start"
											data-question="@question.QuestionId"
											data-index="@i"
											data-preparation="@(question.SpeakingPreparationTime ?? 0)"
											data-response="@(question.SpeakingResponseTime ?? 0)">

										<i class="bi bi-mic-fill me-1"></i>
										Start Recording
									</button>

									<button type="button"
											class="btn btn-danger speaking-stop"
											data-question="@question.QuestionId"
											data-index="@i"
											disabled>

										<i class="bi bi-stop-fill me-1"></i>
										Stop Recording
									</button>

								</div>


								<div class="speaking-status text-muted small mb-3"
									 id="speakingStatus_@question.QuestionId">
									Microphone not started.
								</div>


								<audio class="w-100 speaking-preview d-none"
									   id="speakingPreview_@question.QuestionId"
									   controls>
								</audio>


								<input type="file"
									   name="Answers[@i].AudioFile"
									   id="audioFile_@question.QuestionId"
									   class="d-none"
									   accept="audio/*" />

							</div>

						</div>
					}

					<!-- WRITING -->
					@if (question.Skill.Equals("Writing",
						StringComparison.OrdinalIgnoreCase))
					{
						<div class="writing-section">

							@if (!string.IsNullOrWhiteSpace(question.WritingPrompt))
							{
								<div class="alert alert-light border mb-4">

									<strong>Writing Prompt</strong>

									<div class="mt-2">
										@question.WritingPrompt
									</div>

								</div>
							}

							<textarea class="form-control writing-answer"
									  name="Answers[@i].TextAnswer"
									  rows="12"
									  placeholder="Write your answer here..."
									  data-question="@question.QuestionId"></textarea>

							<div class="d-flex justify-content-between mt-2">

								<span class="text-muted small">
									Word count:
									<strong class="word-count">0</strong>
								</span>

								<span class="text-muted small">
									Minimum:
									@(question.WritingPrompt != null ? "See instructions" : "—")
								</span>

							</div>

						</div>
					}


					<!-- Fallback for other question types -->
					@if (
						question.QuestionType != "FillInTheBlank" &&
						!question.Skill.Equals("Reading", StringComparison.OrdinalIgnoreCase) &&
						!question.Skill.Equals("Listening", StringComparison.OrdinalIgnoreCase) &&
						!question.Skill.Equals("Speaking", StringComparison.OrdinalIgnoreCase) &&
						!question.Skill.Equals("Writing", StringComparison.OrdinalIgnoreCase)
					)
					{
						@if (question.Answers.Any())
						{
							foreach (var answer in question.Answers)
							{
								<div class="form-check border rounded p-3 mb-2">

									<input class="form-check-input answer-input"
										   type="radio"
										   name="Answers[@i].AnswerId"
										   value="@answer.AnswerId"
										   id="answer_@(i)_@(answer.AnswerId)"
										   data-question="@question.QuestionId" />

									<label class="form-check-label w-100"
										   for="answer_@(i)_@(answer.AnswerId)">
										@answer.AnswerText
									</label>

								</div>
							}
						}
					}


					<input type="hidden"
						   name="Answers[@i].QuestionId"
						   value="@question.QuestionId" />

				</div>
			</div>
		}


		<!-- Submit -->
		<div class="card shadow-sm border-0 mb-5">
			<div class="card-body p-4 text-center">

				<h2 class="h5 mb-2">
					Ready to submit?
				</h2>

				<p class="text-muted mb-4">
					Make sure you have completed all sections before submitting.
				</p>

				<button type="submit"
						class="btn btn-primary btn-lg px-5"
						id="submitExamButton">
					Submit Exam
				</button>

			</div>
		</div>

	</form>

</div>


@section Scripts {

	<script>
		// Restrict copy, cut, paste, and the context menu during exams.
		["copy", "cut", "paste", "contextmenu"].forEach(eventType => {
			examForm.addEventListener(eventType, event => {
				event.preventDefault();
			});
		});

		// Also block common keyboard shortcuts.
		examForm.addEventListener("keydown", event => {
			if ((event.ctrlKey || event.metaKey) &&
				["c", "x", "v", "a"].includes(event.key.toLowerCase())) {
				event.preventDefault();
			}
		});
		document.addEventListener("DOMContentLoaded", function () {

			/*
			 * EXAM TIMER
			 */

			const examDuration = @Model.Duration;
			const timerElement = document.getElementById("examTimer");
			const examForm = document.getElementById("examForm");
			const submitButton = document.getElementById("submitExamButton");

			// EXAM MONITORING
			const examId = examForm.querySelector(
				'input[name="ExamId"]'
			).value;

			const antiforgeryToken = examForm.querySelector(
				'input[name="__RequestVerificationToken"]'
			).value;

			const monitorUrl = examForm.dataset.monitorUrl;

			let interruptionStartedAt = null;
			let lastEventAt = 0;
			let examSubmitted = false;

			function reportMonitoringEvent(eventType, durationSeconds = null) {
				const now = Date.now();

				// Suppress duplicate focus-loss events.
				if (
					(eventType === "TabHidden" ||
						eventType === "WindowBlurred") &&
					now - lastEventAt < 1500
				) {
					return;
				}

				lastEventAt = now;

				const body = new URLSearchParams({
					examId: examId,
					eventType: eventType
				});

				if (durationSeconds !== null) {
					body.set("durationSeconds", String(durationSeconds));
				}

				return fetch(monitorUrl, {
					method: "POST",
					credentials: "same-origin",
					keepalive: true,
					headers: {
						"Content-Type": "application/x-www-form-urlencoded",
						"RequestVerificationToken": antiforgeryToken
					},
					body: body.toString()
				}).catch(function (error) {
					console.error("Could not report monitoring event.", error);
				});
			}

			function handleFocusLost(eventType) {
				if (examSubmitted || document.hidden && eventType === "WindowBlurred") {
					return;
				}

				// One interruption can trigger both browser events.
				if (interruptionStartedAt !== null) {
					return;
				}

				interruptionStartedAt = Date.now();
				reportMonitoringEvent(eventType);
			}

			function handleFocusRegained() {
				if (interruptionStartedAt === null) {
					return;
				}

				const durationSeconds = Math.min(
					86400,
					Math.max(
						0,
						Math.round((Date.now() - interruptionStartedAt) / 1000)
					)
				);

				interruptionStartedAt = null;

				reportMonitoringEvent("FocusRegained", durationSeconds);
			}

			document.addEventListener("visibilitychange", function () {
				if (document.hidden) {
					handleFocusLost("TabHidden");
				} else {
					handleFocusRegained();
				}
			});

			window.addEventListener("blur", function () {
				if (!document.hidden) {
					handleFocusLost("WindowBlurred");
				}
			});

			window.addEventListener("focus", function () {
				if (!document.hidden) {
					handleFocusRegained();
				}
			});

			function updateExamTimer() {

				const minutes = Math.floor(remainingSeconds / 60);
				const seconds = remainingSeconds % 60;

				timerElement.textContent =
					String(minutes).padStart(2, "0") +
					":" +
					String(seconds).padStart(2, "0");

				if (remainingSeconds <= 0) {
					clearInterval(examTimerInterval);

					submitButton.disabled = true;

					alert("Time is up. The exam will be submitted.");

					examForm.submit();

					return;
				}

				remainingSeconds--;
			}

			updateExamTimer();

			const examTimerInterval =
				setInterval(updateExamTimer, 1000);


			/*
			 * PROGRESS
			 */

			const questionCards =
				document.querySelectorAll(".question-card");

			const progressText =
				document.getElementById("progressText");

			const progressBar =
				document.getElementById("progressBar");

			function updateProgress() {

				let answered = 0;

				questionCards.forEach(function (card) {

					const radio =
						card.querySelector(
							'input[type="radio"]:checked'
						);

					const text =
						card.querySelector(
							".writing-answer"
						);


					if (radio) {
						answered++;
					}
					else if (text && text.value.trim().length > 0) {
						answered++;
					}

					const fillBlank = card.querySelector(".fill-blank-answer");

					if (radio) {
						answered++;
					} else if (text && text.value.trim().length > 0) {
						answered++;
					} else if (fillBlank && fillBlank.value.trim().length > 0) {
						answered++;
					}

				});

				const total = questionCards.length;

				const percentage =
					total === 0
						? 0
						: (answered / total) * 100;

				progressText.textContent =
					answered + " / " + total + " answered";

				progressBar.style.width =
					percentage + "%";
			}


			document
				.querySelectorAll(".answer-input")
				.forEach(function (input) {

					input.addEventListener(
						"change",
						updateProgress
					);

				});


			document
				.querySelectorAll(".writing-answer")
				.forEach(function (textarea) {

					textarea.addEventListener(
						"input",
						function () {

							const countElement =
								textarea
									.closest(".writing-section")
									.querySelector(".word-count");

							const words =
								textarea.value
									.trim()
									.split(/\s+/)
									.filter(Boolean);

							countElement.textContent =
								textarea.value.trim() === ""
									? "0"
									: words.length;

							updateProgress();
						}
					);

				});


			updateProgress();

					/*
		 * SPEAKING RECORDING
		 */

		const speakingRecorders = {};

		document
			.querySelectorAll(".speaking-start")
			.forEach(function (button) {

				button.addEventListener("click", async function () {

					const questionId = button.dataset.question;
					const index = button.dataset.index;

					const preparation =
						parseInt(button.dataset.preparation) || 0;

					const response =
						parseInt(button.dataset.response) || 0;

					const stopButton =
						document.querySelector(
							'.speaking-stop[data-question="' +
							questionId +
							'"]'
						);

					const timer =
						document.getElementById(
							"speakingTimer_" + questionId
						);

					const status =
						document.getElementById(
							"speakingStatus_" + questionId
						);

					const preview =
						document.getElementById(
							"speakingPreview_" + questionId
						);

					const fileInput =
						document.getElementById(
							"audioFile_" + questionId
						);


					if (!navigator.mediaDevices ||
						!navigator.mediaDevices.getUserMedia ||
						!window.MediaRecorder) {

						alert(
							"Audio recording is not supported by this browser."
						);

						return;
					}


					try {

						const stream =
							await navigator.mediaDevices.getUserMedia({
								audio: true
							});

						const chunks = [];

						const recorder =
							new MediaRecorder(stream);

						speakingRecorders[questionId] = {
							recorder: recorder,
							stream: stream,
							chunks: chunks,
							timerInterval: null
						};


						recorder.ondataavailable = function (event) {

							if (event.data.size > 0) {
								chunks.push(event.data);
							}

						};


						recorder.onstop = function () {

							stream
								.getTracks()
								.forEach(track => track.stop());


							const blob =
								new Blob(
									chunks,
									{ type: recorder.mimeType }
								);


							const audioUrl =
								URL.createObjectURL(blob);

							preview.src = audioUrl;
							preview.classList.remove("d-none");


							const file =
								new File(
									[blob],
									"speaking_" +
									questionId +
									".webm",
									{
										type: blob.type
									}
								);


							const dataTransfer =
								new DataTransfer();

							dataTransfer.items.add(file);

							fileInput.files =
								dataTransfer.files;


							status.textContent =
								"Recording completed. You can listen to your response before submitting.";

							timer.textContent =
								"Recorded";

							updateProgress();
						};


						recorder.start();

						button.disabled = true;
						stopButton.disabled = false;


						let phase = "preparation";
						let remaining = preparation;


						function updateTimer() {

							if (phase === "preparation") {

								timer.textContent =
									"Prepare: " +
									remaining +
									"s";

								status.textContent =
									"Preparation time. Get ready to speak.";

							}
							else {

								timer.textContent =
									"Recording: " +
									remaining +
									"s";

								status.textContent =
									"Recording your response...";

							}


							if (remaining <= 0) {

								if (phase === "preparation") {

									phase = "response";
									remaining = response;

									return;
								}


								clearInterval(
									speakingRecorders[
										questionId
									].timerInterval
								);


								if (recorder.state !== "inactive") {
									recorder.stop();
								}


								button.disabled = true;
								stopButton.disabled = true;

								return;
							}

							remaining--;
						}


						updateTimer();


						speakingRecorders[
							questionId
						].timerInterval =
							setInterval(
								updateTimer,
								1000
							);

					}
					catch (error) {

						console.error(error);

						alert(
							"Unable to access your microphone. Please allow microphone access and try again."
						);

					}

				});

			});


		document
			.querySelectorAll(".speaking-stop")
			.forEach(function (button) {

				button.addEventListener("click", function () {

					const questionId =
						button.dataset.question;

					const data =
						speakingRecorders[questionId];

					if (!data) {
						return;
					}


					if (data.timerInterval) {

						clearInterval(
							data.timerInterval
						);

					}


					if (data.recorder.state !== "inactive") {

						data.recorder.stop();

					}


					const startButton =
						document.querySelector(
							'.speaking-start[data-question="' +
							questionId +
							'"]'
						);

					startButton.disabled = true;
					button.disabled = true;

				});

			});


			/*
			 * SUBMIT CONFIRMATION
			 */

			examForm.addEventListener(
				"submit",
				function (event) {

					const confirmed =
						confirm(
							"Are you sure you want to submit this exam? You will not be able to submit it again."
						);

					if (!confirmed) {
						event.preventDefault();
					}

				}
			);

		});

		// Clicking anywhere in an answer row selects its radio button.
		document.querySelectorAll(".form-check.border.rounded").forEach(row => {
			row.addEventListener("click", event => {
				const radio = row.querySelector(".answer-input");

				if (!radio || event.target.closest("input, label, button")) {
					return;
				}

				if (!radio.checked) {
					radio.checked = true;
					radio.dispatchEvent(new Event("change", { bubbles: true }));
				}
			});
		});
	</script>
}

.form-check.border.rounded {
cursor: pointer;
transition: background-color 0.15s ease, border-color 0.15s ease;
}

.form-check.border.rounded:hover {
background-color: #f0f5ff;
border-color: #86a8e7 !important;
}

.form-check.border.rounded:has(.answer-input:checked) {
background-color: #eaf2ff;
border-color: #4778d0 !important;
}

.form-check.border.rounded .form-check-label {
cursor: pointer;
}