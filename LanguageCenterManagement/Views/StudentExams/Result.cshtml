@model LanguageCenterManagement.Models.ExamResult

@{
	ViewData["Title"] = "Exam Result";
}

<div class="container mt-4 mb-5">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="fw-bold mb-1">Exam Result</h2>
			<p class="text-muted mb-0">
				@(Model.Exam?.ExamName ?? "Exam")
			</p>
		</div>

		<a asp-action="Index" class="btn btn-outline-secondary">
			Back to Exams
		</a>
	</div>

	<div class="card shadow-sm border-0 mb-4">
		<div class="card-body text-center py-5">
			<div class="text-muted mb-2">Your Score</div>

			<h1 class="display-4 fw-bold mb-2">
				@Model.Score
			</h1>

			@if (Model.Exam != null)
			{
				<p class="text-muted mb-0">
					out of @Model.Exam.MaxScore
				</p>
			}
		</div>
	</div>

	<div class="card shadow-sm border-0">
		<div class="card-body">
			<div class="row g-4">
				<div class="col-md-6">
					<label class="text-muted small">Exam</label>
					<div class="fw-semibold">
						@(Model.Exam?.ExamName ?? "-")
					</div>
				</div>

				<div class="col-md-6">
					<label class="text-muted small">Class</label>
					<div class="fw-semibold">
						@(Model.Exam?.Class?.ClassName ?? "-")
					</div>
				</div>

				<div class="col-md-6">
					<label class="text-muted small">Submitted At</label>
					<div class="fw-semibold">
						@(Model.SubmittedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")
					</div>
				</div>

				<div class="col-md-6">
					<label class="text-muted small">Status</label>
					<div>
						<span class="badge bg-success">Submitted</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>