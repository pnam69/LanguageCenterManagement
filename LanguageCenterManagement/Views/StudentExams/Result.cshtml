@model LanguageCenterManagement.ViewModels.StudentExamResultViewModel

@{
    ViewData["Title"] = "Exam Result";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

        <div>
            <div class="text-muted small mb-1">
                Exam Result
            </div>

            <h2 class="fw-bold mb-2">
                @Model.ExamName
            </h2>

            <div class="text-muted">
                <i class="bi bi-easel me-1"></i>
                @Model.ClassName
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Exams
        </a>

    </div>

    <form id="aiReviewTokenForm" class="d-none">
    @Html.AntiForgeryToken()
    </form>

    <!-- Result Summary -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="text-muted small mb-2">
                        Final Score
                    </div>

                    <div class="d-flex align-items-baseline gap-2">

                        <span class="display-5 fw-bold text-primary">
                            @Model.Score.ToString("0.##")
                        </span>

                        <span class="text-muted">
                            / @Model.MaxScore.ToString("0.##")
                        </span>

                    </div>

                </div>
            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="text-muted small mb-2">
                        Status
                    </div>

                    @if (Model.Status == "Completed")
                    {
                        <div class="fw-semibold text-success">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            Completed
                        </div>
                    }
                    else
                    {
                        <div class="fw-semibold">
                            @Model.Status
                        </div>
                    }

                </div>
            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="text-muted small mb-2">
                        Submitted
                    </div>

                    @if (Model.SubmittedAt.HasValue)
                    {
                        <div class="fw-semibold">
                            @Model.SubmittedAt.Value.ToString("dd/MM/yyyy")
                        </div>

                        <div class="text-muted small">
                            @Model.SubmittedAt.Value.ToString("HH:mm")
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }

                </div>
            </div>

        </div>

    </div>


    <!-- Question Results -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        Question Results
                    </h5>

                    <p class="text-muted mb-0">
                        Review your answers and grading.
                    </p>
                </div>

                <span class="text-muted">
                    @Model.Answers.Count question@(Model.Answers.Count == 1 ? "" : "s")
                </span>

            </div>

        </div>


        <div class="card-body p-4">

            @if (!Model.Answers.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-inbox fs-1 text-muted"></i>

                    <h5 class="fw-bold mt-3">
                        No question results available
                    </h5>

                </div>
            }
            else
            {
                @foreach (var answer in Model.Answers.OrderBy(a => a.QuestionOrder))
                {
                    var isManualGrading =
                        answer.QuestionType.Equals(
                            "Speaking",
                            StringComparison.OrdinalIgnoreCase)
                        ||
                        answer.QuestionType.Equals(
                            "Writing",
                            StringComparison.OrdinalIgnoreCase)
                        ||
                        answer.Skill.Equals(
                            "Speaking",
                            StringComparison.OrdinalIgnoreCase)
                        ||
                        answer.Skill.Equals(
                            "Writing",
                            StringComparison.OrdinalIgnoreCase);

                    <div class="border rounded-3 p-4 mb-3">

                        <!-- Question heading -->
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">

                            <div>

                                <div class="fw-bold">
                                    Question @answer.QuestionOrder
                                </div>

                                <div class="text-muted small">
                                    @answer.Skill
                                    <span class="mx-1">•</span>
                                    @answer.QuestionType
                                </div>

                            </div>


                            <div class="text-end text-nowrap">

                                <span class="fw-bold">
                                    @answer.Score.ToString("0.##")
                                </span>

                                <span class="text-muted">
                                    / @answer.QuestionScore
                                </span>

                            </div>

                        </div>


                        <!-- Question text -->
                        <div class="mb-4">
                            <div class="fw-semibold">
                                @answer.QuestionText
                            </div>
                        </div>


                        @if (isManualGrading)
                        {
                            <!-- Speaking / Writing -->
                            <div class="bg-light rounded-3 p-3">

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <div class="fw-semibold">
                                        <i class="bi bi-person-check me-1"></i>
                                        Teacher Grading
                                    </div>


                                    @if (answer.Score >= answer.QuestionScore)
                                    {
                                        <span class="badge bg-success">
                                            Full Score
                                        </span>
                                    }
                                    else if (answer.Score > 0)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Partially Graded
                                        </span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(answer.StudentAnswer))
                                    {
                                        <span class="badge bg-secondary">
                                            Graded — 0 Points
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not Answered
                                        </span>
                                    }

                                </div>


                                @if (!string.IsNullOrWhiteSpace(answer.StudentAnswer))
                                {
                                    <div>

                                        <div class="small text-muted mb-1">
                                            Your Response
                                        </div>

                                        <div class="bg-white border rounded-3 p-3"
                                             style="white-space: pre-wrap;">
                                            @answer.StudentAnswer
                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted">
                                        <i class="bi bi-dash-circle me-1"></i>
                                        No response submitted.
                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                               <!-- Automatically graded -->
                                <div class="bg-light rounded-3 p-4">

                                    <!-- Header -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="fw-semibold">
                                            Your Answer
                                        </div>
                                        @if (answer.IsCorrect == true)
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Correct
                                            </span>
                                        }
                                        else if (answer.IsCorrect == false)
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Incorrect
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                <i class="bi bi-hourglass-split me-1"></i>
                                                Not Graded
                                            </span>
                                        }
                                    </div>

                                    <!-- Student's Answer -->
                                    @if (!string.IsNullOrWhiteSpace(answer.StudentAnswer))
                                    {
                                        <div class="bg-white border rounded-3 p-3 mb-3">
                                            @answer.StudentAnswer
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bg-white border rounded-3 p-3 mb-3 text-muted">
                                            <i>No answer selected.</i>
                                        </div>
                                    }

                                    <!-- Correct Answer -->
                                    @if (answer.IsCorrect != true &&
                                         !string.IsNullOrWhiteSpace(answer.CorrectAnswer))
                                    {
                                        <div class="mb-3">
                                            <div class="small fw-semibold text-success mb-2">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Correct Answer
                                            </div>

                                            <div class="bg-white border border-success-subtle rounded-3 p-3">
                                                @answer.CorrectAnswer
                                            </div>
                                        </div>
                                    }

                                    <!-- AI Review -->
                                    @if (answer.IsCorrect != true &&
                                         !string.IsNullOrWhiteSpace(answer.CorrectAnswer) &&
                                         new[] { "MultipleChoice", "TrueFalse", "FillInTheBlank" }
                                             .Contains(answer.QuestionType, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <div class="border-top pt-3 mt-3">
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm ai-review-btn"
                                                    data-result-id="@Model.ExamResultId"
                                                    data-question-id="@answer.QuestionId">
                                                <i class="bi bi-stars me-1"></i>
                                                Explain with AI
                                            </button>

                                            <div class="ai-review-result mt-3"
                                                 aria-live="polite"
                                                 hidden>
                                            </div>
                                        </div>
                                    }

                                </div>
                        }

                    </div>
                }
            }

        </div>
    </div>

</div>

                                        
<script>
    document.querySelectorAll(".ai-review-btn").forEach(button => {
        button.addEventListener("click", async () => {
            const output = button.parentElement.querySelector(
                ".ai-review-result"
            );

            const originalText = button.innerHTML;

            button.disabled = true;
            button.innerHTML =
                '<span class="spinner-border spinner-border-sm me-1"></span> Generating...';

            output.hidden = false;
            output.className =
                "ai-review-result alert alert-info mt-3";
            output.textContent = "Preparing your explanation...";

            try {
                const token = document.querySelector(
                    '#aiReviewTokenForm input[name="__RequestVerificationToken"]'
                ).value;

                const body = new URLSearchParams({
                    resultId: button.dataset.resultId,
                    questionId: button.dataset.questionId
                });

                const response = await fetch(
                    '@Url.Action("ReviewAnswer", "StudentExams")',
                    {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded",
                            "RequestVerificationToken": token
                        },
                        body
                    }
                );

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(
                        data.error || "Could not generate an explanation."
                    );
                }

                output.className =
                    "ai-review-result alert alert-primary mt-3";
                output.textContent = data.explanation;
            } catch (error) {
                output.className =
                    "ai-review-result alert alert-warning mt-3";
                output.textContent =
                    error.message || "AI review failed. Please try again.";
            } finally {
                button.disabled = false;
                button.innerHTML = originalText;
            }
        });
    });
</script>
