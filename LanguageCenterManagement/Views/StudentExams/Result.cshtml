@model LanguageCenterManagement.Models.ExamResult

@{
    ViewData["Title"] = "Exam Result";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card border-0 shadow-sm text-center">

                <div class="card-body p-5">

                    <div class="mb-3">
                        <i class="bi bi-check-circle text-success"
                           style="font-size: 4rem;"></i>
                    </div>

                    <h2 class="fw-bold">
                        Exam Submitted
                    </h2>

                    <p class="text-muted">
                        @Model.Exam?.ExamName
                    </p>

                    <div class="my-4">

                        <div class="text-muted">
                            Your Score
                        </div>

                        <div class="display-3 fw-bold text-primary">
                            @Model.Score
                        </div>

                        <div class="text-muted">
                            out of @Model.Exam?.MaxScore
                        </div>

                    </div>

                    <div class="row text-start mb-4">

                        <div class="col-md-6">
                            <strong>Class</strong>
                            <p class="text-muted">
                                @Model.Exam?.Class?.ClassName
                            </p>
                        </div>

                        <div class="col-md-6">
                            <strong>Submitted</strong>
                            <p class="text-muted">
                                @(Model.SubmittedAt?.ToString("dd/MM/yyyy HH:mm")
                                    ?? "-")
                            </p>
                        </div>

                    </div>

                    <a asp-action="Index"
                       class="btn btn-primary">
                        Back to My Exams
                    </a>

                    <a asp-controller="StudentExamResults"
                       asp-action="Index"
                       class="btn btn-outline-secondary ms-2">
                        All Results
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>