@model LanguageCenterManagement.ViewModels.StudentExamResultViewModel

@{
    ViewData["Title"] = "Exam Result";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

        <div>
            <div class="text-muted small mb-1">
                Exam Result
            </div>

            <h2 class="fw-bold mb-2">
                @Model.ExamName
            </h2>

            <div class="text-muted">
                <i class="bi bi-easel me-1"></i>
                @Model.ClassName
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Exams
        </a>

    </div>


    <!-- Result Summary -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="text-muted small mb-2">
                        Final Score
                    </div>

                    <div class="d-flex align-items-baseline gap-2">

                        <span class="display-5 fw-bold text-primary">
                            @Model.Score.ToString("0.##")
                        </span>

                        <span class="text-muted">
                            / @Model.MaxScore.ToString("0.##")
                        </span>

                    </div>

                </div>
            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="text-muted small mb-2">
                        Status
                    </div>

                    @if (Model.Status == "Completed")
                    {
                        <div class="fw-semibold text-success">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            Completed
                        </div>
                    }
                    else
                    {
                        <div class="fw-semibold">
                            @Model.Status
                        </div>
                    }

                </div>
            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="text-muted small mb-2">
                        Submitted
                    </div>

                    @if (Model.SubmittedAt.HasValue)
                    {
                        <div class="fw-semibold">
                            @Model.SubmittedAt.Value.ToString("dd/MM/yyyy")
                        </div>

                        <div class="text-muted small">
                            @Model.SubmittedAt.Value.ToString("HH:mm")
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }

                </div>
            </div>

        </div>

    </div>


    <!-- Question Results -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        Question Results
                    </h5>

                    <p class="text-muted mb-0">
                        Review your answers and grading.
                    </p>
                </div>

                <span class="text-muted">
                    @Model.Answers.Count question@(Model.Answers.Count == 1 ? "" : "s")
                </span>

            </div>

        </div>


        <div class="card-body p-4">

            @if (!Model.Answers.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-inbox fs-1 text-muted"></i>

                    <h5 class="fw-bold mt-3">
                        No question results available
                    </h5>

                </div>
            }
            else
            {
                @foreach (var answer in Model.Answers.OrderBy(a => a.QuestionOrder))
                {
                    var isManualGrading =
                        answer.QuestionType.Equals(
                            "Speaking",
                            StringComparison.OrdinalIgnoreCase)
                        ||
                        answer.QuestionType.Equals(
                            "Writing",
                            StringComparison.OrdinalIgnoreCase)
                        ||
                        answer.Skill.Equals(
                            "Speaking",
                            StringComparison.OrdinalIgnoreCase)
                        ||
                        answer.Skill.Equals(
                            "Writing",
                            StringComparison.OrdinalIgnoreCase);

                    <div class="border rounded-3 p-4 mb-3">

                        <!-- Question heading -->
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">

                            <div>

                                <div class="fw-bold">
                                    Question @answer.QuestionOrder
                                </div>

                                <div class="text-muted small">
                                    @answer.Skill
                                    <span class="mx-1">•</span>
                                    @answer.QuestionType
                                </div>

                            </div>


                            <div class="text-end text-nowrap">

                                <span class="fw-bold">
                                    @answer.Score.ToString("0.##")
                                </span>

                                <span class="text-muted">
                                    / @answer.QuestionScore
                                </span>

                            </div>

                        </div>


                        <!-- Question text -->
                        <div class="mb-4">
                            <div class="fw-semibold">
                                @answer.QuestionText
                            </div>
                        </div>


                        @if (isManualGrading)
                        {
                            <!-- Speaking / Writing -->
                            <div class="bg-light rounded-3 p-3">

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <div class="fw-semibold">
                                        <i class="bi bi-person-check me-1"></i>
                                        Teacher Grading
                                    </div>


                                    @if (answer.Score >= answer.QuestionScore)
                                    {
                                        <span class="badge bg-success">
                                            Full Score
                                        </span>
                                    }
                                    else if (answer.Score > 0)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Partially Graded
                                        </span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(answer.StudentAnswer))
                                    {
                                        <span class="badge bg-secondary">
                                            Graded — 0 Points
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Not Answered
                                        </span>
                                    }

                                </div>


                                @if (!string.IsNullOrWhiteSpace(answer.StudentAnswer))
                                {
                                    <div>

                                        <div class="small text-muted mb-1">
                                            Your Response
                                        </div>

                                        <div class="bg-white border rounded-3 p-3"
                                             style="white-space: pre-wrap;">
                                            @answer.StudentAnswer
                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted">
                                        <i class="bi bi-dash-circle me-1"></i>
                                        No response submitted.
                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <!-- Automatically graded -->
                            <div class="bg-light rounded-3 p-3">

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <div class="fw-semibold">
                                        Your Answer
                                    </div>

                                    @if (answer.IsCorrect == true)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Correct
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Incorrect
                                        </span>
                                    }

                                </div>


                                @if (!string.IsNullOrWhiteSpace(answer.StudentAnswer))
                                {
                                    <div class="bg-white border rounded-3 p-3 mb-3">
                                        @answer.StudentAnswer
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted mb-3">
                                        No answer selected.
                                    </div>
                                }


                                @if (answer.IsCorrect != true &&
                                     !string.IsNullOrWhiteSpace(answer.CorrectAnswer))
                                {
                                    <div>

                                        <div class="small text-muted mb-1">
                                            Correct Answer
                                        </div>

                                        <div class="bg-white border rounded-3 p-3">
                                            @answer.CorrectAnswer
                                        </div>

                                    </div>
                                }

                            </div>
                        }

                    </div>
                }
            }

        </div>
    </div>

</div>