@model IEnumerable<LanguageCenterManagement.ViewModels.StudentExamListViewModel>

@{
	ViewData["Title"] = "My Exams";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="fw-bold mb-1">My Exams</h2>
			<p class="text-muted mb-0">
				View and take your available exams.
			</p>
		</div>
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success">
			@TempData["SuccessMessage"]
		</div>
	}

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger">
			@TempData["ErrorMessage"]
		</div>
	}

	@if (!Model.Any())
	{
		<div class="card shadow-sm border-0">
			<div class="card-body text-center py-5">
				<h5 class="mb-2">No exams available</h5>

				<p class="text-muted mb-0">
					You are not currently enrolled in any classes with available exams.
				</p>
			</div>
		</div>
	}
	else
	{
		<div class="card shadow-sm border-0">
			<div class="card-body p-0">

				<div class="table-responsive">
					<table class="table table-hover align-middle mb-0">

						<thead class="table-light">
							<tr>
								<th class="ps-4">Exam</th>
								<th>Class</th>
								<th>Type</th>
								<th>Date</th>
								<th>Duration</th>
								<th>Status</th>
								<th class="text-end pe-4">Action</th>
							</tr>
						</thead>

						<tbody>
							@foreach (var exam in Model)
							{
								<tr>

									<td class="ps-4">
										<div class="fw-semibold">
											@exam.ExamName
										</div>
									</td>

									<td>
										@exam.ClassName
									</td>

									<td>
										<span class="badge bg-secondary">
											@exam.ExamType
										</span>
									</td>

									<td>
										@exam.ExamDate.ToString("dd/MM/yyyy HH:mm")
									</td>

									<td>
										@exam.Duration min
									</td>

									<td>
										@if (exam.HasSubmitted)
										{
											<span class="badge bg-success">
												Completed
											</span>
										}
										else if (exam.Status == "Published")
										{
											<span class="badge bg-primary">
												Available
											</span>
										}
										else
										{
											<span class="badge bg-secondary">
												@exam.Status
											</span>
										}
									</td>

									<td class="text-end pe-4">

										@if (exam.HasSubmitted && exam.ExamResultId.HasValue)
										{
											<a asp-action="Result"
											   asp-route-id="@exam.ExamResultId.Value"
											   class="btn btn-sm btn-outline-success">
												View Result
											</a>
										}
										else if (exam.Status == "Published")
										{
											<a asp-action="Take"
											   asp-route-id="@exam.ExamId"
											   class="btn btn-sm btn-primary">
												Take Exam
											</a>
										}

									</td>

								</tr>
							}
						</tbody>

					</table>
				</div>

			</div>
		</div>
	}

</div>