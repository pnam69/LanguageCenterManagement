@model IEnumerable<LanguageCenterManagement.ViewModels.StudentExamListViewModel>

@{
    ViewData["Title"] = "My Exams";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">My Exams</h2>
        <p class="text-muted mb-0">
            View and take exams for your enrolled classes.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row g-4">

        @foreach (var exam in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-3">

                            <span class="badge bg-primary">
                                @exam.ExamType
                            </span>

                            @if (exam.HasSubmitted)
                            {
                                <span class="badge bg-success">
                                    Completed
                                </span>
                            }
                            else if (exam.Status == "Published")
                            {
                                <span class="badge bg-warning text-dark">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @exam.Status
                                </span>
                            }

                        </div>

                        <h5 class="fw-bold">
                            @exam.ExamName
                        </h5>

                        <p class="text-muted mb-2">
                            @exam.ClassName
                        </p>

                        <div class="small text-muted mb-3">

                            <div>
                                <i class="bi bi-calendar3 me-1"></i>
                                @exam.ExamDate.ToString("dd/MM/yyyy HH:mm")
                            </div>

                            <div>
                                <i class="bi bi-clock me-1"></i>
                                @exam.Duration minutes
                            </div>

                            <div>
                                <i class="bi bi-star me-1"></i>
                                Maximum score: @exam.MaxScore
                            </div>

                        </div>

                        @if (exam.HasSubmitted)
                        {
                            <a asp-action="Details"
                               asp-route-id="@exam.ExamId"
                               class="btn btn-outline-success w-100">
                                View Exam
                            </a>
                        }
                        else if (exam.Status == "Published" &&
                                 exam.ExamDate <= DateTime.Now)
                        {
                            <a asp-action="Take"
                               asp-route-id="@exam.ExamId"
                               class="btn btn-primary w-100">
                                Start Exam
                            </a>
                        }
                        else
                        {
                            <a asp-action="Details"
                               asp-route-id="@exam.ExamId"
                               class="btn btn-outline-secondary w-100">
                                View Details
                            </a>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You currently have no exams.
        </div>
    }

</div>