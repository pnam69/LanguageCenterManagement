@model LanguageCenterManagement.Models.ExamResult

@{
    ViewData["Title"] = "Delete Exam Result";
}

<div class="container py-4">

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <h2 class="fw-bold text-danger">
                Delete Exam Result
            </h2>

            <div class="alert alert-warning">
                Are you sure you want to delete this result?
            </div>

            <p>
                <strong>Exam:</strong>
                @Model.Exam?.ExamName
            </p>

            <p>
                <strong>Student:</strong>
                @Model.Student?.FullName
            </p>

            <p>
                <strong>Score:</strong>
                @Model.Score / @Model.Exam?.MaxScore
            </p>

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="ExamResultId" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>