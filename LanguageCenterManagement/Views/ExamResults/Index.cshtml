@model IEnumerable<LanguageCenterManagement.Models.ExamResult>

@{
    ViewData["Title"] = "Exam Results";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Exam Results</h2>
            <p class="text-muted">
                Manage student exam results.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Result
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Exam</th>
                        <th>Student</th>
                        <th>Class</th>
                        <th>Score</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var result in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @result.Exam?.ExamName
                                </strong>
                            </td>

                            <td>
                                @result.Student?.FullName
                            </td>

                            <td>
                                @result.Exam?.Class?.ClassName
                            </td>

                            <td>
                                <strong>
                                    @result.Score
                                </strong>
                                /
                                @result.Exam?.MaxScore
                            </td>

                            <td>
                                <span class="badge bg-success">
                                    @result.Status
                                </span>
                            </td>

                            <td>
                                @(result.SubmittedAt?.ToString("dd/MM/yyyy HH:mm")
                                    ?? "-")
                            </td>

                            <td class="text-end">

                                <a asp-action="Details"
                                   asp-route-id="@result.ExamResultId"
                                   class="btn btn-sm btn-outline-info">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@result.ExamResultId"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@result.ExamResultId"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                No exam results found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>