@model IEnumerable<LanguageCenterManagement.ViewModels.StudentLearningResultViewModel>

@{
    ViewData["Title"] = "My Learning Results";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">My Learning Results</h2>
    <p class="text-muted">
        View your overall results for each class.
    </p>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small">
                                @item.ClassCode
                            </div>

                            <h5 class="fw-bold mb-1">
                                @item.ClassName
                            </h5>

                            <div class="text-muted">
                                @item.CourseName
                            </div>
                        </div>

                        @if (item.Result == "Passed")
                        {
                            <span class="badge bg-success">
                                Passed
                            </span>
                        }
                        else if (item.Result == "Failed")
                        {
                            <span class="badge bg-danger">
                                Failed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                @item.Result
                            </span>
                        }
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">
                                Average Score
                            </div>

                            <h3 class="fw-bold mb-0">
                                @item.AverageScore.ToString("0.00")
                                <span class="fs-6 text-muted">/ 10</span>
                            </h3>
                        </div>

                        <div class="text-end">
                            <div class="text-muted small">
                                Completed
                            </div>

                            <div>
                                @(item.CompletedDate?.ToString("dd/MM/yyyy") ?? "-")
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.TeacherComment))
                    {
                        <div class="mt-3 bg-light rounded p-3">
                            <div class="small fw-semibold mb-1">
                                Teacher Comment
                            </div>

                            <div class="text-muted">
                                @item.TeacherComment
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-bar-chart fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No learning results yet
                    </h5>

                    <p class="text-muted mb-0">
                        Your teacher has not entered any learning results.
                    </p>
                </div>
            </div>
        </div>
    }
</div>