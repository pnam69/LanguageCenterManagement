@model LanguageCenterManagement.Models.ViewModels.AdminStudentListViewModel

@{
    ViewData["Title"] = "All Students";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">All Students</h1>
            <p class="text-muted mb-0">
                Browse student profiles, contact information, and enrollment counts.
            </p>
        </div>
        <span class="badge bg-primary rounded-pill px-3 py-2">
            @Model.Students.Count student(s)
        </span>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-7">
                    <label for="search" class="form-label">Search students</label>
                    <input id="search" name="search" value="@Model.Search"
                           class="form-control"
                           placeholder="Name, student code, email, or phone" />
                </div>
                <div class="col-md-3">
                    <label for="status" class="form-label">Student status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">All statuses</option>
                        <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Students.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-5 text-muted"></i>
                    <h2 class="h5 mt-3">No students found</h2>
                    <p class="text-muted mb-0">Try changing your search or status filter.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Student</th>
                                <th>Contact</th>
                                <th>Enrollments</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Profile</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">@student.FullName</div>
                                        <small class="text-muted">@student.StudentCode</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(student.Email))
                                        {
                                            <div>@student.Email</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(student.Phone))
                                        {
                                            <small class="text-muted">@student.Phone</small>
                                        }
                                        @if (string.IsNullOrWhiteSpace(student.Email)
                                            && string.IsNullOrWhiteSpace(student.Phone))
                                        {
                                            <span class="text-muted">No contact info</span>
                                        }
                                    </td>
                                    <td>@student.EnrollmentCount</td>
                                    <td>
                                        <span class="badge @(student.Status == "Active"
                                              ? "bg-success" : "bg-secondary")">
                                            @student.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details"
                                           asp-route-id="@student.StudentId"
                                           class="btn btn-sm btn-outline-primary">
                                            View profile
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
