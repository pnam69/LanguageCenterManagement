@model LanguageCenterManagement.Models.ViewModels.AdminStudentDetailsViewModel

@{
    ViewData["Title"] = "Student Profile";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small">
            <i class="bi bi-arrow-left me-1"></i> Back to All Students
        </a>
        <h1 class="h3 mt-2 mb-1">@Model.FullName</h1>
        <p class="text-muted mb-0">@Model.StudentCode</p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h2 class="h5 mb-0">Student Information</h2>
                </div>
                <div class="card-body px-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Full name</small>
                            <strong>@Model.FullName</strong>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Student code</small>
                            @Model.StudentCode
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Email</small>
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <a href="mailto:@Model.Email">@Model.Email</a>
                            }
                            else
                            {
                                <span>Not provided</span>
                            }
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Phone</small>
                            @if (!string.IsNullOrWhiteSpace(Model.Phone))
                            {
                                <a href="tel:@Model.Phone">@Model.Phone</a>
                            }
                            else
                            {
                                <span>Not provided</span>
                            }
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Date of birth</small>
                            @(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Not provided")
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Gender</small>
                            @(Model.Gender ?? "Not provided")
                        </div>
                        <div class="col-12">
                            <small class="text-muted d-block">Address</small>
                            @(Model.Address ?? "Not provided")
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Account status</small>
                            <span class="badge @(Model.Status == "Active"
                                  ? "bg-success" : "bg-secondary")">
                                @Model.Status
                            </span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Registered on</small>
                            @Model.CreatedAt.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h2 class="h5 mb-0">Class Enrollments</h2>
                </div>
                <div class="card-body p-0">
                    @if (Model.Enrollments.Count == 0)
                    {
                        <div class="text-center py-5 px-3">
                            <i class="bi bi-journal-x display-6 text-muted"></i>
                            <p class="text-muted mt-3 mb-0">
                                This student has no enrollment records.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Class / Course</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var enrollment in Model.Enrollments)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-semibold">
                                                    @enrollment.ClassName
                                                </div>
                                                <small class="text-muted">
                                                    @enrollment.ClassCode · @enrollment.CourseName
                                                </small>
                                            </td>
                                            <td>@enrollment.EnrollmentStatus</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h2 class="h5 mb-0">Attendance History</h2>
            <p class="text-muted small mb-0">
                Attendance records across all classes.
            </p>
        </div>
        <div class="card-body p-0">
            @if (Model.AttendanceHistory.Count == 0)
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">No attendance records found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Date</th>
                                <th>Class</th>
                                <th>Status</th>
                                <th class="pe-4">Note</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.AttendanceHistory)
                            {
                                var badgeClass = item.Status switch
                                {
                                    "Present" => "bg-success",
                                    "Absent" => "bg-danger",
                                    "Late" => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td class="ps-4">
                                        @item.AttendanceDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>@item.ClassName</td>
                                    <td>
                                        <span class="badge @badgeClass">@item.Status</span>
                                    </td>
                                    <td class="pe-4">
                                        @(string.IsNullOrWhiteSpace(item.Note)
                                            ? "—" : item.Note)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
