@model IEnumerable<LanguageCenterManagement.Models.Material>

@{
    ViewData["Title"] = "Materials";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Learning Materials</h2>
        <p class="text-muted mb-0">
            Manage materials for your classes.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        Add Material
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index"
              method="get"
              class="row g-2">

            <div class="col-md-6">
                <select name="classId"
                        class="form-select">
                    <option value="">All Classes</option>

                    @foreach (var item in (SelectList)ViewBag.Classes)
                    {
                        <option value="@item.Value"
                                selected="@item.Selected">
                            @item.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-auto">
                <button type="submit"
                        class="btn btn-outline-primary">
                    <i class="bi bi-filter me-1"></i>
                    Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4">
    @foreach (var material in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">
                        <span class="badge bg-primary">
                            @material.MaterialType
                        </span>

                        <small class="text-muted">
                            @material.CreatedAt.ToString("dd/MM/yyyy")
                        </small>
                    </div>

                    <h5 class="fw-bold">
                        @material.Title
                    </h5>

                    <div class="small text-muted mb-2">
                        <i class="bi bi-book me-1"></i>

                        @material.Class?.ClassCode -
                        @material.Class?.ClassName
                    </div>

                    @if (!string.IsNullOrWhiteSpace(material.Description))
                    {
                        <p class="text-muted">
                            @material.Description
                        </p>
                    }

                    <div class="mt-3">
                        @if (!string.IsNullOrWhiteSpace(material.FileUrl))
                        {
                            <a href="@material.FileUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-sm btn-primary">
                                <i class="bi bi-file-earmark me-1"></i>
                                Open File
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(material.ExternalUrl))
                        {
                            <a href="@material.ExternalUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-box-arrow-up-right me-1"></i>
                                Open Link
                            </a>
                        }
                    </div>

                    <div class="mt-3 pt-3 border-top">
                        <a asp-action="Details"
                           asp-route-id="@material.MaterialId"
                           class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@material.MaterialId"
                           class="btn btn-sm btn-outline-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@material.MaterialId"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-folder2-open fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No materials found
                    </h5>

                    <p class="text-muted mb-0">
                        No learning materials have been added yet.
                    </p>
                </div>
            </div>
        </div>
    }
</div>