@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    
    <!-- Banner Chào mừng -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white overflow-hidden position-relative">
                <!-- Icon background mờ ở góc phải -->
                <i class="bi bi-mortarboard-fill position-absolute text-white opacity-25" style="font-size: 10rem; right: -1rem; top: -2rem;"></i>
                
                <div class="card-body p-4 p-md-5 position-relative z-1">
                    <h2 class="fw-bold mb-3">
                        Welcome back, @(User.Identity?.Name ?? "User")! 👋
                    </h2>
                    <p class="fs-5 mb-0 text-white-50">
                        You are logged in successfully. Here is what's happening at your Language Center today.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Khối truy cập nhanh (Quick Access) -->
    <h5 class="fw-bold text-secondary mb-3 mt-2">Quick Access</h5>
    <div class="row g-4">
        
        <!-- Widget Courses -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-4 hover-effect">
                <div class="card-body p-4 d-flex flex-column text-center align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-journal-text fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Courses</h5>
                    <p class="text-muted small mb-4">Manage language courses, tuition fees, and levels.</p>
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 mt-auto fw-medium w-100">
                        View Courses
                    </a>
                </div>
            </div>
        </div>

        <!-- Widget Students -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-4 hover-effect">
                <div class="card-body p-4 d-flex flex-column text-center align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-people fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Students</h5>
                    <p class="text-muted small mb-4">Manage student records and enrollments.</p>
                    <a asp-controller="Students" asp-action="Index" class="btn btn-outline-success rounded-pill px-4 mt-auto fw-medium w-100">
                        View Students
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Widget Schedules -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-4 hover-effect">
                <div class="card-body p-4 d-flex flex-column text-center align-items-center">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-calendar-week fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Schedules</h5>
                    <p class="text-muted small mb-4">View and manage class timetables and rooms.</p>
                    <a asp-controller="Schedules" asp-action="Index" class="btn btn-outline-warning rounded-pill px-4 mt-auto fw-medium w-100 text-dark">
                        View Schedules
                    </a>
                </div>
            </div>
        </div>

        <!-- Widget System Users -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-4 hover-effect">
                <div class="card-body p-4 d-flex flex-column text-center align-items-center">
                    <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-person-badge fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">System Accounts</h5>
                    <p class="text-muted small mb-4">Create and manage Teachers, Students, and Admins.</p>
                    <a asp-controller="Account" asp-action="Create" class="btn btn-outline-info rounded-pill px-4 mt-auto fw-medium w-100">
                        Add Account
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <style>
        /* Thêm hiệu ứng nổi lên khi di chuột vào các thẻ card */
        .hover-effect {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
    </style>
}