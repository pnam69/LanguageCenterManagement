@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white overflow-hidden position-relative">
                <i class="bi bi-mortarboard-fill position-absolute text-white opacity-25" style="font-size: 10rem; right: -1rem; top: -2rem;"></i>
                
                <div class="card-body p-4 p-md-5 position-relative z-1">
                    <h2 class="fw-bold mb-3">
                        Welcome back, @(User.Identity?.Name ?? "User")!
                    </h2>
                    <p class="fs-5 mb-0 text-white-50">
                        You are logged in successfully. Here is what's happening at your Language Center today.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <h5 class="fw-bold text-secondary mb-3 mt-2">
        <i class="bi bi-speedometer2 me-2"></i>Center Overview
    </h5>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-muted small mb-2">AI Requests Today</div>
                    <div class="fs-2 fw-bold text-primary">
                        @ViewBag.AiRequestsToday
                    </div>
                    <div class="small text-muted">All tracked AI features</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-muted small mb-2">Questions Used Today</div>
                    <div class="fs-2 fw-bold text-info">
                        @ViewBag.QuestionsUsedToday
                    </div>
                    <div class="small text-muted">Question generation quota usage</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-muted small mb-2">AI Failures Today</div>
                    <div class="fs-2 fw-bold text-danger">
                        @ViewBag.AiFailedToday
                    </div>
                    <div class="small text-muted">
                        @ViewBag.AiSuccessfulToday successful requests
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-muted small mb-2">Published Exams Ahead</div>
                    <div class="fs-2 fw-bold text-success">
                        @ViewBag.UpcomingPublishedExams
                    </div>
                    <div class="small text-muted">Scheduled for the future</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 d-flex flex-column flex-md-row
            justify-content-between align-items-md-center gap-3">
            <div>
                <h5 class="fw-bold mb-1">
                    <i class="bi bi-shield-check text-warning me-2"></i>
                    Writing Integrity Reviews
                </h5>
                <p class="text-muted mb-0">
                    Submissions waiting for a review decision.
                </p>
            </div>

            <div class="d-flex align-items-center gap-3">
                <span class="fs-3 fw-bold">
                    @ViewBag.PendingIntegrityReviews
                </span>
                <a asp-controller="WritingIntegrityReviews"
                   asp-action="Index"
                   class="btn btn-outline-primary rounded-pill">
                    Review Submissions
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <!-- Class performance -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-bar-chart-line me-2 text-primary"></i>
                        Class Performance
                    </h5>
                    <small class="text-muted">
                        Based on completed exam results
                    </small>
                </div>

                <div class="card-body p-0">
                    @{
                        var classPerformance = ViewBag.ClassPerformance;
                    }

                    @if (classPerformance == null ||
                         !((IEnumerable<dynamic>)classPerformance).Any())
                    {
                        <p class="text-muted text-center p-4 mb-0">
                            No completed exam results available yet.
                        </p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Class</th>
                                        <th>Students</th>
                                        <th>Results</th>
                                        <th>Average</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in classPerformance)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold">
                                                @item.ClassName
                                            </td>
                                            <td>@item.StudentCount</td>
                                            <td>@item.ExamCount</td>
                                            <td>
                                                <span class="fw-semibold">
                                                    @item.AverageScore.ToString("0.0")%
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="card-footer bg-white">
                    <a asp-controller="LearningResults"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary">
                        View Learning Results
                    </a>
                </div>
            </div>
        </div>

        <!-- Top students -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-trophy me-2 text-warning"></i>
                        Top Student Performance
                    </h5>
                    <small class="text-muted">
                        Ranked by average completed-exam score
                    </small>
                </div>

                <div class="card-body p-0">
                    @{
                        var topStudents = ViewBag.TopStudents;
                    }

                    @if (topStudents == null ||
                         !((IEnumerable<dynamic>)topStudents).Any())
                    {
                        <p class="text-muted text-center p-4 mb-0">
                            No completed student results available yet.
                        </p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @{
                                var rank = 1;
                            }

                            @foreach (var student in topStudents)
                            {
                                <div class="list-group-item py-3">
                                    <div class="d-flex justify-content-between
                                        align-items-center gap-3">
                                        <div>
                                            <div class="fw-semibold">
                                                <span class="text-muted me-2">
                                                    #@rank
                                                </span>
                                                @student.StudentName
                                            </div>
                                            <small class="text-muted">
                                                @student.StudentCode
                                                · @student.ExamsCompleted exams
                                            </small>
                                        </div>

                                        <span class="badge bg-primary-subtle
                                            text-primary fs-6">
                                            @student.AverageScore.ToString("0.0")%
                                        </span>
                                    </div>
                                </div>

                                rank++;
                            }
                        </div>
                    }
                </div>

                <div class="card-footer bg-white">
                    <a asp-controller="Students"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary">
                        Manage Students
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="card-title mb-1">Class Performance</h5>
                    <p class="text-muted small mb-3">
                        Average exam scores by class, up to 10 classes.
                    </p>
                    <div style="position: relative; height: 320px;">
                        <canvas id="classPerformanceChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="card-title mb-1">AI Usage</h5>
                    <p class="text-muted small mb-3">
                        Successful and failed AI requests over the last 7 days.
                    </p>
                    <div style="position: relative; height: 320px;">
                        <canvas id="aiUsageChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h5 class="fw-bold text-secondary mb-3 mt-2">Quick Access</h5>
    <div class="row g-4">
        
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-4 hover-effect">
                <div class="card-body p-4 d-flex flex-column text-center align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-journal-text fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Courses</h5>
                    <p class="text-muted small mb-4">Manage language courses, tuition fees, and levels.</p>
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 mt-auto fw-medium w-100">
                        View Courses
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-4 hover-effect">
                <div class="card-body p-4 d-flex flex-column text-center align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-people fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Students</h5>
                    <p class="text-muted small mb-4">Manage student records and enrollments.</p>
                    <a asp-controller="Students" asp-action="Index" class="btn btn-outline-success rounded-pill px-4 mt-auto fw-medium w-100">
                        View Students
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-4 hover-effect">
                <div class="card-body p-4 d-flex flex-column text-center align-items-center">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-calendar-week fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Schedules</h5>
                    <p class="text-muted small mb-4">View and manage class timetables and rooms.</p>
                    <a asp-controller="Schedules" asp-action="Index" class="btn btn-outline-danger rounded-pill px-4 mt-auto fw-medium w-100 text-dark">
                        View Schedules
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-4 hover-effect">
                <div class="card-body p-4 d-flex flex-column text-center align-items-center">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-file-earmark-text-fill fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Exams</h5>
                    <p class="text-muted small mb-4">View and manage class timetables and rooms.</p>
                    <a asp-controller="Exams" asp-action="Index" class="btn btn-outline-warning rounded-pill px-4 mt-auto fw-medium w-100 text-dark">
                        View Exams
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-4 hover-effect">
                <div class="card-body p-4 d-flex flex-column text-center align-items-center">
                    <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-person-badge fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-2">System Accounts</h5>
                    <p class="text-muted small mb-4">Create and manage Teachers, Students, and Admins.</p>
                    <a asp-controller="Account" asp-action="Create" class="btn btn-outline-info rounded-pill px-4 mt-auto fw-medium w-100">
                        Add Account
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>


@section Scripts {
    <style>
        .hover-effect {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .hover-effect:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            }
    </style>

    @{
        var chartJsonOptions = new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy =
                System.Text.Json.JsonNamingPolicy.CamelCase
        };
    }

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const classPerformanceData =
                    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            ViewBag.ClassPerformanceChart, chartJsonOptions));

        const aiUsageData =
                    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            ViewBag.AiUsageChart, chartJsonOptions));

        console.log("Class performance chart data:", classPerformanceData);
        console.log("AI usage chart data:", aiUsageData);

        const classCanvas = document.getElementById('classPerformanceChart');

        if (classCanvas && classPerformanceData.length > 0) {
            new Chart(classCanvas, {
                type: 'bar',
                data: {
                    labels: classPerformanceData.map(x => x.className),
                    datasets: [{
                        label: 'Average score (%)',
                        data: classPerformanceData.map(x => x.averageScore),
                        backgroundColor: 'rgba(54, 162, 235, 0.7)',
                        borderColor: 'rgb(54, 162, 235)',
                        borderWidth: 1,
                        borderRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            title: {
                                display: true,
                                text: 'Average score (%)'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        } else if (classCanvas) {
            classCanvas.parentElement.innerHTML =
                '<p class="text-muted text-center py-5">No completed exam results available yet.</p>';
        }

        const aiCanvas = document.getElementById('aiUsageChart');

        if (aiCanvas) {
            new Chart(aiCanvas, {
                type: 'line',
                data: {
                    labels: aiUsageData.map(x => x.date),
                    datasets: [
                        {
                            label: 'Successful',
                            data: aiUsageData.map(x => x.successful),
                            borderColor: 'rgb(40, 167, 69)',
                            backgroundColor: 'rgba(40, 167, 69, 0.12)',
                            fill: true,
                            tension: 0.3
                        },
                        {
                            label: 'Failed',
                            data: aiUsageData.map(x => x.failed),
                            borderColor: 'rgb(220, 53, 69)',
                            backgroundColor: 'rgba(220, 53, 69, 0.10)',
                            fill: true,
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            },
                            title: {
                                display: true,
                                text: 'Number of requests'
                            }
                        }
                    }
                }
            });
        }
    </script>
}
