@model IEnumerable<LanguageCenterManagement.ViewModels.TeacherAttendanceScheduleViewModel>

@{
    ViewData["Title"] = "Student Attendance";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    <div class="mb-4">
        <h3 class="fw-bold text-primary mb-1">
            <i class="bi bi-calendar2-check-fill me-2"></i>
            Student Attendance
        </h3>
        <p class="text-muted mb-0">
            Select a scheduled lesson to record or update attendance.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No scheduled lessons are available for your classes.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-3">Lesson</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Room</th>
                            <th>Attendance</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var canTake = string.Equals(
                                item.Status, "Scheduled",
                                StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <td class="px-3">
                                    <div class="fw-semibold">
                                        @item.ClassName
                                    </div>
                                    <small class="text-muted">
                                        @item.ClassCode · @item.CourseName
                                    </small>
                                </td>
                                <td>@item.StudyDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @item.StartTime.ToString(@"hh\:mm")
                                    –
                                    @item.EndTime.ToString(@"hh\:mm")
                                </td>
                                <td>@item.RoomName</td>
                                <td>
                                    @item.RecordedCount / @item.StudentCount
                                    <small class="text-muted d-block">records</small>
                                </td>
                                <td>
                                    @if (canTake)
                                    {
                                        <span class="badge bg-success">
                                            @item.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (canTake)
                                    {
                                        <a asp-action="Take"
                                           asp-route-scheduleId="@item.ScheduleId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square me-1"></i>
                                            @(item.RecordedCount > 0 ? "Edit" : "Take")
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary"
                                                disabled>
                                            Unavailable
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
