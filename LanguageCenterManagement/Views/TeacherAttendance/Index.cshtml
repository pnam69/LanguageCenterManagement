@model IEnumerable<LanguageCenterManagement.Models.LanguageClass>

@{
    ViewData["Title"] = "Attendance";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-calendar2-check-fill me-2"></i>
                Student Attendance
            </h3>

            <p class="text-muted mb-0">
                Select a class to record or update student attendance.
            </p>
        </div>
    </div>

    <div class="row g-4">

        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-journal-x fs-1 text-muted"></i>

                        <h5 class="fw-bold mt-3">
                            No Classes Assigned
                        </h5>

                        <p class="text-muted mb-0">
                            You currently do not have any classes assigned to you.
                        </p>
                    </div>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card border-0 shadow-sm rounded-3 border-start border-info border-4 h-100">

                        <div class="card-body p-4 d-flex flex-column">

                            <div class="d-flex align-items-center mb-3">

                                <div class="bg-info bg-opacity-10 text-info rounded-circle
                                            d-flex align-items-center justify-content-center me-3"
                                     style="width: 55px; height: 55px;">
                                    <i class="bi bi-easel fs-3"></i>
                                </div>

                                <div>
                                    <h5 class="fw-bold text-dark mb-0">
                                        @item.ClassName
                                    </h5>

                                    <small class="text-muted">
                                        @item.ClassCode
                                    </small>
                                </div>

                            </div>

                            @if (item.Course != null)
                            {
                                <p class="text-muted flex-grow-1 mb-4">
                                    <i class="bi bi-journal-bookmark me-1"></i>
                                    @item.Course.CourseName
                                </p>
                            }
                            else
                            {
                                <div class="flex-grow-1"></div>
                            }

                            <a asp-controller="TeacherAttendance"
                               asp-action="Take"
                               asp-route-classId="@item.LanguageClassId"
                               class="btn btn-outline-info text-dark fw-medium w-100 shadow-sm">

                                <i class="bi bi-calendar2-check me-1"></i>
                                Take Attendance

                            </a>

                        </div>

                    </div>

                </div>
            }
        }

    </div>
</div>