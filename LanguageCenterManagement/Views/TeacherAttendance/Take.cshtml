@model LanguageCenterManagement.ViewModels.TeacherAttendanceViewModel

@{
    ViewData["Title"] = "Take Attendance";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-calendar2-check-fill me-2"></i>
                Take Attendance
            </h3>
            <p class="text-muted mb-0">
                @Model.ClassName (@Model.ClassCode) · @Model.CourseName
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Schedule
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <small class="text-muted d-block">Lesson date</small>
                    <strong>@Model.AttendanceDate.ToString("dd/MM/yyyy")</strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Time</small>
                    <strong>
                        @Model.StartTime.ToString(@"hh\:mm") –
                        @Model.EndTime.ToString(@"hh\:mm")
                    </strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Room</small>
                    <strong>@Model.RoomName</strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">Enrolled students</small>
                    <strong>@Model.Students.Count</strong>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Take" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ScheduleId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="card border-0 shadow-sm">
            @if (!Model.Students.Any())
            {
                <div class="p-5 text-center">
                    <i class="bi bi-people fs-1 text-muted"></i>
                    <h5 class="fw-bold mt-3">No Students Enrolled</h5>
                    <p class="text-muted mb-0">
                        There are no eligible students in this class.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">#</th>
                                <th>Student</th>
                                <th>Status</th>
                                <th>Note</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                <tr>
                                    <td class="px-4">@(i + 1)</td>
                                    <td>
                                        <div class="fw-semibold">
                                            @Model.Students[i].FullName
                                        </div>
                                        <small class="text-muted">
                                            @Model.Students[i].StudentCode
                                        </small>
                                        <input type="hidden"
                                               asp-for="Students[i].StudentId" />
                                    </td>
                                    <td style="min-width: 150px">
                                        <select asp-for="Students[i].Status"
                                                class="form-select">
                                            <option value="Present">Present</option>
                                            <option value="Absent">Absent</option>
                                            <option value="Late">Late</option>
                                        </select>
                                    </td>
                                    <td style="min-width: 220px">
                                        <input asp-for="Students[i].Note"
                                               class="form-control"
                                               placeholder="Optional note" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 border-top d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i>
                        Save Attendance
                    </button>
                </div>
            }
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
