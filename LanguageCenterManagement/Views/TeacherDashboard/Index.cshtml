@{
    ViewData["Title"] = "Teacher Dashboard";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Teacher Dashboard</h1>

            <p class="text-muted mb-0">
                Welcome, @User.Identity?.Name
            </p>
        </div>

        <div>
            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger">
                    Log Out
                </button>

            </form>
        </div>
    </div>

    <div class="row">

        <!-- My Classes -->
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        My Classes
                    </h5>

                    <p class="card-text">
                        View the classes assigned to you.
                    </p>

                    <a href="#"
                       class="btn btn-primary">
                        View Classes
                    </a>

                </div>
            </div>
        </div>

        <!-- Attendance -->
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        Attendance
                    </h5>

                    <p class="card-text">
                        Record and manage student attendance.
                    </p>

                    <a href="#"
                       class="btn btn-primary">
                        Attendance
                    </a>

                </div>
            </div>
        </div>

        <!-- Exams -->
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        Exams
                    </h5>

                    <p class="card-text">
                        Manage exams and student results.
                    </p>

                    <a href="#"
                       class="btn btn-primary">
                        Manage Exams
                    </a>

                </div>
            </div>
        </div>

        <!-- Schedule Change Requests -->
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        Schedule Change Requests
                    </h5>

                    <p class="card-text">
                        Submit and track requests for
                        schedule changes or make-up classes.
                    </p>

                    <div class="d-flex gap-2">

                        <a asp-controller="ScheduleChangeRequests"
                           asp-action="Index"
                           class="btn btn-primary">
                            My Requests
                        </a>

                        <a asp-controller="ScheduleChangeRequests"
                           asp-action="Create"
                           class="btn btn-outline-primary">
                            New Request
                        </a>

                    </div>

                </div>
            </div>
        </div>

    </div>
</div>