@{
    ViewData["Title"] = "Teacher Dashboard";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    
    <!-- Lời chào & Tiêu đề -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-person-workspace me-2"></i>Teacher Dashboard
            </h3>
            <p class="text-muted mb-0 fs-6">
                Welcome back, <strong class="text-dark fs-5">@User.Identity?.Name</strong>! Here is your teaching overview.
            </p>
        </div>
        <div>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 fs-6 shadow-sm">
                <i class="bi bi-person-video3 me-1"></i> Teacher Account
            </span>
        </div>
    </div>

    <!-- Khối thẻ chức năng (Dashboard Widgets) -->
    <div class="row g-4">
        
        <!-- My Classes -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-primary border-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 55px; height: 55px;">
                            <i class="bi bi-easel2-fill fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">My Classes</h5>
                    </div>
                    <p class="text-muted mb-4 flex-grow-1">
                        View and manage your assigned classes, check teaching schedules, and organize lesson plans.
                    </p>
                    <!-- Nút bấm chờ gắn link -->
                    <a href="#" class="btn btn-outline-primary fw-medium w-100 shadow-sm">
                        Manage Classes <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Attendance -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-info border-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 55px; height: 55px;">
                            <i class="bi bi-ui-checks fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">Attendance</h5>
                    </div>
                    <p class="text-muted mb-4 flex-grow-1">
                        Record daily student attendance, track absences, and manage class participation.
                    </p>
                    <a asp-controller="TeacherAttendance" asp-action="Index" class="btn btn-outline-info fw-medium w-100 shadow-sm text-dark">
                        Record Attendance <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Exams -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-warning border-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 55px; height: 55px;">
                            <i class="bi bi-file-earmark-text-fill fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">Exams</h5>
                    </div>
                    <p class="text-muted mb-4 flex-grow-1">
                        Manage exam schedules, grade student submissions, and update academic results.
                    </p>
                    <!-- Nút bấm chờ gắn link -->
                    <a asp-controller="Exam" asp-action="Create" class="btn btn-outline-warning fw-medium w-100 shadow-sm text-dark">
                        Manage Exams <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-warning border-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 55px; height: 55px;">
                            <i class="bi bi-file-earmark-text-fill fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">Exams</h5>
                    </div>
                    <p class="text-muted mb-4 flex-grow-1">
                        Manage questions, create exams.
                    </p>
                    <!-- Nút bấm chờ gắn link -->
                    <a asp-controller="Questions" asp-action="Index" class="btn btn-outline-warning fw-medium w-100 shadow-sm text-dark">
                        Manage Questions <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        
    </div>
</div>