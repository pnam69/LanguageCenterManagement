@{
    ViewData["Title"] = "Teacher Dashboard";
}

<div class="container-fluid mt-4 mb-5 px-lg-5">
    
    <!-- Lời chào & Tiêu đề -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-person-workspace me-2"></i>Teacher Dashboard
            </h3>
            <p class="text-muted mb-0 fs-6">
                Welcome back, <strong class="text-dark fs-5">@User.Identity?.Name</strong>! Here is your teaching overview.
            </p>
        </div>
        <div>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 fs-6 shadow-sm">
                <i class="bi bi-person-video3 me-1"></i> Teacher Account
            </span>
        </div>
    </div>

    <h5 class="fw-bold text-secondary mb-3">
        <i class="bi bi-speedometer2 me-2"></i>Teaching Overview
    </h5>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 d-flex
            justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-calendar-week me-2 text-primary"></i>
                Upcoming Classes
            </h5>

            <a asp-controller="TeacherSchedules"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                Full Schedule
            </a>
        </div>

        <div class="card-body p-0">
            @{
                var upcomingClasses =
                    ViewBag.UpcomingClasses
                    as IEnumerable<LanguageCenterManagement.Models.Schedule>;
            }

            @if (upcomingClasses == null || !upcomingClasses.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-calendar-check fs-3 d-block mb-2"></i>
                    No upcoming classes scheduled.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Date</th>
                                <th>Time</th>
                                <th>Class</th>
                                <th>Room</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in upcomingClasses)
                            {
                                <tr>
                                    <td class="ps-3">
                                        @schedule.StudyDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @schedule.StartTime.ToString(@"hh\:mm")
                                        –
                                        @schedule.EndTime.ToString(@"hh\:mm")
                                    </td>
                                    <td>
                                        <div class="fw-semibold">
                                            @schedule.Class?.ClassName
                                        </div>
                                        <small class="text-muted">
                                            @schedule.Class?.ClassCode
                                        </small>
                                    </td>
                                    <td>
                                        @(schedule.Room?.RoomName ?? "Not assigned")
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle
                                            text-primary">
                                            @schedule.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-muted small mb-2">Upcoming Exams</div>
                    <div class="fs-2 fw-bold text-primary">
                        @ViewBag.UpcomingExams
                    </div>
                    <a asp-controller="Exams"
                       asp-action="Index"
                       class="small text-decoration-none">
                        View exams <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-muted small mb-2">All My Exams</div>
                    <div class="fs-2 fw-bold text-info">
                        @ViewBag.TotalExams
                    </div>
                    <a asp-controller="Exams"
                       asp-action="Index"
                       class="small text-decoration-none">
                        Manage exams <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-muted small mb-2">Awaiting Grading</div>
                    <div class="fs-2 fw-bold text-warning">
                        @ViewBag.PendingGrading
                    </div>
                    <a asp-controller="TeacherExamResults"
                       asp-action="Index"
                       class="small text-decoration-none">
                        Review results <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-muted small mb-2">Integrity Reviews</div>
                    <div class="fs-2 fw-bold text-danger">
                        @ViewBag.PendingIntegrityReviews
                    </div>
                    <a asp-controller="WritingIntegrityReviews"
                       asp-action="Index"
                       class="small text-decoration-none">
                        Review flags <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center gap-3">
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-stars text-primary me-2"></i>
                        AI Teaching Tools
                    </h5>
                    <p class="text-muted mb-0">
                        Generate questions, review student writing, and
                        inspect assessment integrity.
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="AiQuestions"
                       asp-action="Index"
                       class="btn btn-primary rounded-pill">
                        <i class="bi bi-magic me-1"></i> AI Questions
                    </a>

                    <a asp-controller="WritingIntegrityReviews"
                       asp-action="Index"
                       class="btn btn-outline-primary rounded-pill">
                        <i class="bi bi-shield-check me-1"></i> Integrity Reviews
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Khối thẻ chức năng (Dashboard Widgets) -->
    <div class="row g-4">
        
        <!-- My Classes -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-primary border-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 55px; height: 55px;">
                            <i class="bi bi-easel2-fill fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">My Classes</h5>
                    </div>
                    <p class="text-muted mb-4 flex-grow-1">
                        View and manage your assigned classes, check teaching schedules, and organize lesson plans.
                    </p>
                    <a asp-controller="TeacherClasses" asp-action="Index" class="btn btn-outline-primary fw-medium w-100 shadow-sm">
                        Manage Classes <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Attendance -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-info border-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 55px; height: 55px;">
                            <i class="bi bi-ui-checks fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">Attendance</h5>
                    </div>
                    <p class="text-muted mb-4 flex-grow-1">
                        Record daily student attendance, track absences, and manage class participation.
                    </p>
                    <a asp-controller="TeacherAttendance" asp-action="Index" class="btn btn-outline-info fw-medium w-100 shadow-sm text-dark">
                        Record Attendance <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-success border-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 55px; height: 55px;">
                            <i class="bi bi-calendar3 fs-2 text-success"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">My Schedule</h5>
                    </div>
                    <p class="text-muted mb-4 flex-grow-1">
                        View your weekly teaching schedule and classroom assignments.
                    </p>
                    <a asp-controller="TeacherSchedules" asp-action="Index" class="btn btn-outline-success fw-medium w-100 shadow-sm text-dark">
                        View Schedule <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

       
        <!-- Exams -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-warning border-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 55px; height: 55px;">
                            <i class="bi bi-file-earmark-text-fill fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">Exams</h5>
                    </div>
                    <p class="text-muted mb-4 flex-grow-1">
                        Manage exam schedules, grade student submissions, and update academic results.
                    </p>
                    <a asp-controller="Exams" asp-action="Index" class="btn btn-outline-warning fw-medium w-100 shadow-sm text-dark">
                        Manage Exams <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-dark border-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-dark bg-opacity-10 text-dark rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 55px; height: 55px;">
                            <i class="bi bi-file-earmark-text-fill fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">Exam Results</h5>
                    </div>
                    <p class="text-muted mb-4 flex-grow-1">
                        Manage exam results, view student performance, and generate reports for your classes.
                    </p>
                    <a asp-controller="TeacherExamResults" asp-action="Index" class="btn btn-outline-dark fw-medium w-100 shadow-sm text-dark">
                        Manage Exam Results <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-danger border-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 55px; height: 55px;">
                            <i class="bi bi-file-earmark-text-fill fs-3"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">Questions</h5>
                    </div>
                    <p class="text-muted mb-4 flex-grow-1">
                        Manage questions.
                    </p>
                    <a asp-controller="Questions" asp-action="Index" class="btn btn-outline-danger fw-medium w-100 shadow-sm text-dark">
                        Manage Questions <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        
    </div>
</div>