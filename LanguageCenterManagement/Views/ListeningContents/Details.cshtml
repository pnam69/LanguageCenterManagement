@model LanguageCenterManagement.Models.ListeningContent

@{
    ViewData["Title"] = "Listening Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>@Model.Title</h2>
            <p class="text-muted">Listening exercise details</p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.ListeningContentId"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="card-title">Audio</h5>

            <audio controls class="w-100 mb-3">
                <source src="@Model.AudioUrl">
                Your browser does not support the audio element.
            </audio>

            <p>
                <strong>Audio URL:</strong>
                @Model.AudioUrl
            </p>

        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Transcript))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <strong>Transcript</strong>
            </div>

            <div class="card-body">
                <div style="white-space: pre-wrap;">
                    @Model.Transcript
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between">
            <strong>Questions</strong>

            <span class="badge bg-secondary">
                @Model.Questions.Count
            </span>
        </div>

        <div class="card-body">

            @if (!Model.Questions.Any())
            {
                <p class="text-muted mb-0">
                    No questions have been added to this listening exercise yet.
                </p>
            }
            else
            {
                <ol>
                    @foreach (var question in Model.Questions)
                    {
                        <li class="mb-3">
                            <strong>@question.QuestionText</strong>

                            <div class="mt-1">
                                <span class="badge bg-light text-dark">
                                    @question.QuestionType
                                </span>

                                <span class="badge bg-light text-dark">
                                    @question.Score point(s)
                                </span>
                            </div>
                        </li>
                    }
                </ol>
            }

        </div>
    </div>

</div>