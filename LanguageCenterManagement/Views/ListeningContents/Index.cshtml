@model IEnumerable<LanguageCenterManagement.Models.ListeningContent>

@{
    ViewData["Title"] = "Listening Content";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Listening Content</h2>
            <p class="text-muted mb-0">
                Manage listening exercises and audio materials.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Listening Content
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No listening content has been created yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Audio</th>
                            <th>Questions</th>
                            <th style="width: 220px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Title</strong>
                                </td>

                                <td>
                                    <a href="@item.AudioUrl"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-secondary">
                                        Listen
                                    </a>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @item.Questions.Count question(s)
                                    </span>
                                </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.ListeningContentId"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.ListeningContentId"
                                       class="btn btn-sm btn-outline-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.ListeningContentId"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>