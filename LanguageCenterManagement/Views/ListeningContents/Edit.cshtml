@model LanguageCenterManagement.ViewModels.ListeningAudioCreateViewModel

@{
    ViewData["Title"] = "Edit Listening Content";
}

<div class="container mt-4">
    <h2 class="mb-4">Edit Listening Content</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="ListeningContentId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Current Audio</label>
                    @if (ViewBag.CurrentAudioUrl != null)
                    {
                        <audio controls class="w-100">
                            <source src="@ViewBag.CurrentAudioUrl" type="audio/mpeg" />
                        </audio>
                    }
                </div>

                <div class="mb-3">
                    <label asp-for="AudioFile" class="form-label">
                        Replace Audio (Optional)
                    </label>
                    <input asp-for="AudioFile" type="file" class="form-control" accept=".mp3,audio/mpeg" />
                    <span asp-validation-for="AudioFile" class="text-danger"></span>
                    <small class="text-muted">MP3 only. Maximum size: 20 MB. Leave empty to keep the current audio.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Transcript" class="form-label"></label>
                    <textarea asp-for="Transcript" class="form-control" rows="10"></textarea>
                    <span asp-validation-for="Transcript" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}