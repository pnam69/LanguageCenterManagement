@model LanguageCenterManagement.Models.ListeningContent

@{
    ViewData["Title"] = "Delete Listening Content";
}

<div class="container mt-4">

    <div class="card shadow-sm border-danger">

        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Listening Content</h4>
        </div>

        <div class="card-body">

            <p>
                Are you sure you want to delete this listening content?
            </p>

            <div class="mb-3">
                <strong>Title:</strong>
                @Model.Title
            </div>

            <div class="mb-3">
                <strong>Questions:</strong>
                @Model.Questions.Count
            </div>

            <div class="alert alert-warning">
                This action cannot be undone.
            </div>

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="ListeningContentId" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>