@model LanguageCenterManagement.ViewModels.ListeningContentViewModel

@{
    ViewData["Title"] = "Create Listening Content";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Create Listening Content</h2>
        <p class="text-muted">
            Add an audio exercise for students.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="e.g. Daily Conversation" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="AudioUrl" class="form-label"></label>

                    <input asp-for="AudioUrl"
                           class="form-control"
                           placeholder="/materials/listening/daily-conversation.mp3" />

                    <span asp-validation-for="AudioUrl"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        Enter the URL or path to the audio file.
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Transcript" class="form-label"></label>

                    <textarea asp-for="Transcript"
                              class="form-control"
                              rows="8"
                              placeholder="Enter the listening transcript..."></textarea>

                    <span asp-validation-for="Transcript"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Create
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}