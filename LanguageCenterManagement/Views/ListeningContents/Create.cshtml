@model LanguageCenterManagement.ViewModels.ListeningAudioCreateViewModel

@{
    ViewData["Title"] = "Create Listening Content";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Create Listening Content</h4>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AudioFile" class="form-label"></label>
                    <input asp-for="AudioFile"
                           type="file"
                           class="form-control"
                           accept=".mp3" />
                    <span asp-validation-for="AudioFile"
                          class="text-danger"></span>
                    <small class="text-muted">Maximum file size: 20 MB.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Transcript" class="form-label"></label>
                    <textarea asp-for="Transcript"
                              class="form-control"
                              rows="6"></textarea>
                    <span asp-validation-for="Transcript"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Upload Listening Content
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}