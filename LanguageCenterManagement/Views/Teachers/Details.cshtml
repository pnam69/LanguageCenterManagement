@model LanguageCenterManagement.Models.Teacher

@{
    ViewData["Title"] = "Teacher Details";
}

<h1>Teacher Details</h1>

<dl class="row">

    <dt class="col-sm-3">Teacher Code</dt>
    <dd class="col-sm-9">@Model.TeacherCode</dd>

    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Date of Birth</dt>
    <dd class="col-sm-9">
        @(Model.DateOfBirth?.ToString("dd/MM/yyyy"))
    </dd>

    <dt class="col-sm-3">Gender</dt>
    <dd class="col-sm-9">@Model.Gender</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.Phone</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.Address</dd>

    <dt class="col-sm-3">Specialization</dt>
    <dd class="col-sm-9">@Model.Specialization</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

</dl>

<h3>Assigned Classes</h3>

@if (Model.Classes.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Class Code</th>
                <th>Class Name</th>
                <th>Course</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var classItem in Model.Classes)
            {
                <tr>
                    <td>@classItem.ClassCode</td>
                    <td>@classItem.ClassName</td>
                    <td>@classItem.Course?.CourseName</td>
                    <td>@classItem.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>This teacher has no assigned classes.</p>
}

<a asp-action="Edit"
   asp-route-id="@Model.TeacherId"
   class="btn btn-warning">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>