
@model LanguageCenterManagement.ViewModels.ReadingContentViewModel

@{
    ViewData["Title"] = "Create Reading Passage";
}

<div class="container mt-4">
    <h2>Create Reading Passage</h2>
    <p class="text-muted">
        Create a passage first, then link Reading questions to it.
    </p>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Passage" class="form-label"></label>
                    <textarea asp-for="Passage"
                              class="form-control"
                              rows="12"
                              placeholder="Enter the reading passage..."></textarea>
                    <span asp-validation-for="Passage"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Create Passage
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
