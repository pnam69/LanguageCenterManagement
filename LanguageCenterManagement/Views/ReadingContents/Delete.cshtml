@model LanguageCenterManagement.Models.ReadingContent

@{
	ViewData["Title"] = "Delete Reading Content";
}

<div class="container mt-4">

	<div class="card shadow-sm border-danger">

		<div class="card-header bg-danger text-white">
			<h4 class="mb-0">
				Delete Reading Content
			</h4>
		</div>

		<div class="card-body">

			<p>
				Are you sure you want to delete this reading exercise?
			</p>

			<div class="mb-3">
				<strong>Question:</strong>

				<div class="mt-2 p-3 bg-light rounded">
					@(Model.Question?.QuestionText
						?? "No question")
				</div>
			</div>

			<div class="mb-3">
				<strong>Passage:</strong>

				<div class="mt-2 p-3 bg-light rounded"
					 style="white-space: pre-wrap;">
					@Model.Passage
				</div>
			</div>

			<div class="alert alert-warning">
				This will also remove the question associated
				with this reading exercise.
			</div>

			<form asp-action="Delete" method="post">

				<input type="hidden"
					   asp-for="ReadingContentId" />

				<button type="submit"
						class="btn btn-danger">
					Delete
				</button>

				<a asp-action="Index"
				   class="btn btn-secondary">
					Cancel
				</a>

			</form>

		</div>

	</div>

</div>