
@model LanguageCenterManagement.Models.ReadingContent

@{
    ViewData["Title"] = "Delete Reading Passage";
}

<div class="container mt-4">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Reading Passage</h4>
        </div>

        <div class="card-body">
            <p>Are you sure you want to delete this reading passage?</p>

            <div class="mb-3">
                <strong>Passage:</strong>
                <div class="mt-2 p-3 bg-light rounded"
                     style="white-space: pre-wrap;">@Model.Passage</div>
            </div>

            <div class="mb-3">
                <strong>Linked questions:</strong>
                <span class="badge bg-secondary">
                    @Model.Questions.Count
                </span>
            </div>

            @if (Model.Questions.Any())
            {
                <ul>
                    @foreach (var question in Model.Questions)
                    {
                        <li>@question.QuestionText</li>
                    }
                </ul>

                <div class="alert alert-warning">
                    The passage will be deleted, but its questions will be kept
                    and unlinked from this passage.
                </div>
            }

            <form asp-action="Delete" method="post">
                <input type="hidden" name="id"
                       value="@Model.ReadingContentId" />

                <button type="submit" class="btn btn-danger">
                    Delete Passage
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
