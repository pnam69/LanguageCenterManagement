
@model LanguageCenterManagement.ViewModels.ReadingContentViewModel

@{
    ViewData["Title"] = "Edit Reading Passage";
}

<div class="container mt-4">
    <h2>Edit Reading Passage</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="ReadingContentId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Passage" class="form-label"></label>
                    <textarea asp-for="Passage"
                              class="form-control"
                              rows="12"></textarea>
                    <span asp-validation-for="Passage"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
