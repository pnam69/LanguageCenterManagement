
@model LanguageCenterManagement.Models.ReadingContent

@{
    ViewData["Title"] = "Reading Passage Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Reading Passage</h2>
        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.ReadingContentId"
               class="btn btn-warning">Edit</a>
            <a asp-controller="AiQuestions"
               asp-action="Index"
               asp-route-readingContentId="@Model.ReadingContentId"
               class="btn btn-primary">
                <i class="bi bi-stars"></i>
                Generate Questions
            </a>
            <a asp-action="Index"
               class="btn btn-secondary">Back</a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Passage</strong>
        </div>
        <div class="card-body">
            <div style="white-space: pre-wrap;">@Model.Passage</div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Add an Existing Reading Question</strong>
        </div>
        <div class="card-body">
            <form asp-action="LinkQuestion" method="post">
                <input type="hidden"
                       name="id"
                       value="@Model.ReadingContentId" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-9">
                        <label for="questionId" class="form-label">
                            Unassigned Reading Question
                        </label>

                        <select name="questionId"
                                id="questionId"
                                class="form-select"
                                asp-items="ViewBag.AvailableReadingQuestions"
                                required>
                            <option value="">-- Select a question --</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            Link Question
                        </button>
                    </div>
                </div>

                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Linked Questions (@Model.Questions.Count)</strong>
        </div>
        <div class="card-body">
            @if (Model.Questions.Any())
            {
                <ol>
                    @foreach (var question in Model.Questions)
                    {
                        <li class="mb-3">
                            <p class="mb-1">@question.QuestionText</p>
                            <span class="badge bg-secondary">
                                @question.Skill
                            </span>
                            <span class="badge bg-secondary">
                                @question.Score point(s)
                            </span>
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="text-muted mb-0">
                    No questions are linked to this passage yet.
                    Create a question with Skill set to Reading and link it
                    to this passage.
                </p>
            }
        </div>
    </div>
</div>
