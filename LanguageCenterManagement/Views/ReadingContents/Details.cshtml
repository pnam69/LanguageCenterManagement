@model LanguageCenterManagement.Models.ReadingContent

@{
	ViewData["Title"] = "Reading Details";
}

<div class="container mt-4">

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2>Reading Exercise</h2>
			<p class="text-muted">
				Reading passage and question
			</p>
		</div>

		<div>
			<a asp-action="Edit"
			   asp-route-id="@Model.ReadingContentId"
			   class="btn btn-warning">
				Edit
			</a>

			<a asp-action="Index"
			   class="btn btn-secondary">
				Back
			</a>
		</div>
	</div>

	<div class="card shadow-sm mb-4">
		<div class="card-header">
			<strong>Passage</strong>
		</div>

		<div class="card-body">
			<div style="white-space: pre-wrap;">
				@Model.Passage
			</div>
		</div>
	</div>

	<div class="card shadow-sm">

		<div class="card-header">
			<strong>Question</strong>
		</div>

		<div class="card-body">

			@if (Model.Question != null)
			{
				<p class="fs-5">
					@Model.Question.QuestionText
				</p>

				<div>
					<span class="badge bg-secondary">
						@Model.Question.Skill
					</span>

					<span class="badge bg-secondary">
						@Model.Question.Score point(s)
					</span>
				</div>
			}
			else
			{
				<p class="text-muted">
					No question is associated with this passage.
				</p>
			}

		</div>

	</div>

</div>