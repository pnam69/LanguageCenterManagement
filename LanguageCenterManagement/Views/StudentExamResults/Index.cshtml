@model IEnumerable<LanguageCenterManagement.Models.ExamResult>

@{
	ViewData["Title"] = "My Exam Results";
}

<div class="container">

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1>My Exam Results</h1>
			<p class="text-muted mb-0">
				View your exam scores and results.
			</p>
		</div>

		<a asp-controller="StudentDashboard"
		   asp-action="Index"
		   class="btn btn-outline-secondary">
			Back to Dashboard
		</a>
	</div>

	@if (!Model.Any())
	{
		<div class="alert alert-info">
			No exam results are available yet.
		</div>
	}
	else
	{
		<div class="table-responsive">

			<table class="table table-bordered table-hover align-middle">

				<thead class="table-light">
					<tr>
						<th>Exam</th>
						<th>Score</th>
						<th>Status</th>
						<th>Submitted</th>
						<th>Note</th>
					</tr>
				</thead>

				<tbody>

					@foreach (var result in Model)
					{
						<tr>

							<td>
								@result.Exam?.ExamName
							</td>

							<td>
								<strong>
									@result.Score.ToString("0.##") / 10
								</strong>
							</td>

							<td>
								@if (result.Status == "Completed")
								{
									<span class="badge bg-success">
										Completed
									</span>
								}
								else
								{
									<span class="badge bg-secondary">
										@result.Status
									</span>
								}
							</td>

							<td>
								@(result.SubmittedAt.HasValue
									? result.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")
									: "-")
							</td>

							<td>
								@(string.IsNullOrWhiteSpace(result.Note)
									? "-"
									: result.Note)
							</td>

						</tr>
					}

				</tbody>

			</table>

		</div>
	}

</div>